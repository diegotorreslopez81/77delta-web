---
import Base from '../../../../layouts/Base.astro';
import HeroFoto from '../../../../components/HeroFoto.astro';
import Boton from '../../../../components/Boton.astro';
import Cta from '../../../../components/Cta.astro';
import { hrefEn as href } from '../../../../lib/site';
import { queIncluye, fases, resumen } from '../../../../data/servicios.en';

const otros = resumen.filter((r) => r.titulo !== 'Operational transformation');
---

<Base
  title="Operational transformation with AI"
  description="Implementation, integration with your systems, process automation and training for your team. Four to twelve weeks, always starting with a controlled pilot."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>
          <a href={href('/inteligencia-artificial/')} class="transition-colors hover:text-tinta">Services</a> · 02 · Tailored project
        </p>
        <h1
          class="mt-7 max-w-[19ch] font-display text-[clamp(36px,4.6vw,60px)] font-extralight leading-[1.04] tracking-[-0.035em]"
          data-reveal
        >
          From prototype to <span class="font-semibold text-oro-oscuro">production</span>, with your team involved.
        </h1>
        <p class="mt-8 max-w-[54ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
          We carry out the plan agreed after the assessment: implementation, integration with your systems,
          process automation and training for the people who will use it. Everything a transformation needs so
          that it does not depend on us afterwards.
        </p>

        <div class="mt-14 flex flex-wrap items-center gap-8" data-reveal>
          <div class="rounded-[4px] border border-linea bg-panel px-8 py-6">
            <p class="font-display text-[30px] font-extralight leading-none tracking-[-0.03em] text-oro-oscuro">
              Tailored
            </p>
            <p class="mt-3 max-w-[34ch] font-mono text-[12px] leading-[1.6] text-pizarra">
              The investment is set out in the proposal, matched to the scope
            </p>
          </div>
          <Boton href={href('/servicios/diagnostico/')}>Start with the assessment →</Boton>
        </div>
      </div>
      <HeroFoto foto="industria" alt="Technician reviewing plans in a workshop" class="lg:col-span-5" />
    </div>
  </section>

  <!-- Para quién y plazo -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-12 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-6" data-reveal>
        <p class="eyebrow">Who it is for</p>
        <p class="mt-6 text-[17px] text-pizarra">
          For businesses that have already identified their opportunities in the assessment and want a specialist
          team to put them into practice. We cover everything from one-off projects to transformations lasting several
          quarters.
        </p>
      </div>
      <div class="md:col-span-6 md:pl-6" data-reveal>
        <p class="eyebrow">Typical timescale</p>
        <p class="mt-6 text-[17px] text-pizarra">
          Between four and twelve weeks depending on scope. We always start with a controlled pilot before the
          full rollout, so you can validate results before committing resources.
        </p>
      </div>
    </div>
  </section>

  <!-- Qué incluye -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">What is included</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Six pieces that always go together.
        </h2>
      </div>
      <ul class="mt-14 grid gap-x-12 gap-y-10 md:grid-cols-2 lg:grid-cols-3" role="list">
        {
          queIncluye.map((q, i) => (
            <li data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 font-display text-[19px] font-semibold leading-[1.3]">{q.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{q.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Las cuatro fases -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow text-oro-luz">How it is delivered</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Four phases with a clear end.
        </h2>
        <p class="mt-6 text-[17px] text-marfil/70">
          The project ends with the code, keys and documentation handed over to your company.
        </p>
      </div>
      <ol class="mt-16 grid gap-10 md:grid-cols-4" role="list">
        {
          fases.map((f) => (
            <li class="border-t border-marfil/15 pt-6" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-luz">{f.n}</span>
              <h3 class="mt-3 font-display text-[18px] font-semibold leading-[1.3]">{f.titulo}</h3>
              <p class="mt-3 text-[14px] text-marfil/65">{f.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Otros servicios -->
  <section class="hairline bg-panel">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow" data-reveal>Other ways to work together</p>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-3" role="list">
        {
          otros.map((o) => (
            <li class="bg-panel" data-reveal>
              <a href={href(o.ruta)} class="group flex h-full flex-col p-8 transition-colors hover:bg-oro/5">
                <span class="eyebrow text-pizarra">{o.etiqueta}</span>
                <h3 class="mt-3 font-display text-[20px] font-semibold">{o.titulo}</h3>
                <p class="mt-2 flex-1 text-[15px] text-pizarra">{o.pie}</p>
                <span class="mt-6 font-mono text-[12px] text-tinta/80 group-hover:text-oro-oscuro">See the details →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Cta />
</Base>

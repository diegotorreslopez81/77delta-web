---
import Base from '../../../../layouts/Base.astro';
import HeroFoto from '../../../../components/HeroFoto.astro';
import Boton from '../../../../components/Boton.astro';
import Cta from '../../../../components/Cta.astro';
import { hrefEn as href } from '../../../../lib/site';
import { queObtienes, resumen } from '../../../../data/servicios.en';

const otros = resumen.filter((r) => r.titulo !== 'Assessment');
---

<Base
  title="Free assessment"
  description="A thirty-minute structured interview and a proposal with your company's starting point, a work plan and a budget. Free, with no obligation."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>
          <a href={href('/servicios/')} class="transition-colors hover:text-tinta">Services</a> · 01 · Starting point
        </p>
        <h1
          class="mt-7 max-w-[18ch] font-display text-[clamp(36px,4.6vw,60px)] font-extralight leading-[1.04] tracking-[-0.035em]"
          data-reveal
        >
          <span class="font-semibold text-oro-oscuro">Thirty minutes</span> to find out where AI can save you hours of
          work.
        </h1>
        <p class="mt-8 max-w-[54ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
          A structured interview and a form that help us understand how your business really runs. You receive a
          tailored proposal with your company's starting point, the work plan and the budget.
        </p>

        <div class="mt-14 flex flex-wrap items-center gap-8" data-reveal>
          <div class="rounded-[4px] border border-linea bg-panel px-8 py-6">
            <p class="font-display text-[34px] font-extralight leading-none tracking-[-0.03em] text-oro-oscuro">
              Free
            </p>
            <p class="mt-3 font-mono text-[12px] text-pizarra">30 minutes · no obligation</p>
          </div>
          <Boton href={href('/contacto/')}>Book a free assessment →</Boton>
        </div>
      </div>
      <HeroFoto foto="diagnostico" alt="Open-plan office with several professionals at work" class="lg:col-span-5" />
    </div>
  </section>

  <!-- Para quién y cómo -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-12 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Who it is for</p>
        <p class="mt-6 text-[17px] text-pizarra">
          For any business that wants to understand what artificial intelligence can do for it. Size and sector do
          not matter. It is the natural first step before any paid service.
        </p>
      </div>
      <div class="md:col-span-7 md:pl-6" data-reveal>
        <p class="eyebrow">What the conversation is like</p>
        <p class="mt-6 text-[17px] text-pizarra">
          It is not a sales call. It is a discovery interview, with structured questions about your day-to-day work,
          your critical processes and your bottlenecks. We listen first. Then we advise you, even if the
          conclusion is that the time is not yet right.
        </p>
      </div>
    </div>
  </section>

  <!-- Qué obtienes -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">What you get</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          At the end, you receive five written deliverables.
        </h2>
      </div>
      <ol class="mt-14 grid gap-x-12 gap-y-10 md:grid-cols-2" role="list">
        {
          queObtienes.map((q, i) => (
            <li data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 font-display text-[19px] font-semibold leading-[1.3]">{q.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{q.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Después -->
  <section class="hairline bg-panel">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow" data-reveal>And then, you decide</p>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-3" role="list">
        {
          otros.map((o) => (
            <li class="bg-panel" data-reveal>
              <a href={href(o.ruta)} class="group flex h-full flex-col p-8 transition-colors hover:bg-oro/5">
                <span class="eyebrow text-pizarra">{o.etiqueta}</span>
                <h3 class="mt-3 font-display text-[20px] font-semibold">{o.titulo}</h3>
                <p class="mt-2 flex-1 text-[15px] text-pizarra">{o.pie}</p>
                <span class="mt-6 font-mono text-[12px] text-tinta/80 group-hover:text-oro-oscuro">See the details →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Cta />
</Base>

---
import GuiasRelacionadas from '../../components/blog/GuiasRelacionadas.astro';
import Base from '../../layouts/Base.astro';
import Boton from '../../components/Boton.astro';
import Cta from '../../components/Cta.astro';
import { href } from '../../lib/site';
import { resumen } from '../../data/servicios';
import { ambitos, modalidades } from '../../data/partner';

const otros = resumen.filter((r) => r.titulo !== 'Partner tecnológico');
---

<Base
  title="Partner tecnológico"
  description="Socio técnico para toda la tecnología de tu empresa: software a medida, integración, CRM y ERP, Microsoft, nube, ciberseguridad, hardware y planta, web, datos, IA e I+D. Un solo interlocutor, sin fabricantes impuestos."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <p class="eyebrow" data-reveal>
      <a href={href('/servicios/')} class="transition-colors hover:text-tinta">Servicios</a> · 03 · Acompañamiento continuo
    </p>
    <h1
      class="mt-7 max-w-[19ch] font-display text-[clamp(38px,6vw,76px)] font-extralight leading-[1.04] tracking-[-0.035em]"
      data-reveal
    >
      Toda la tecnología de tu empresa, <span class="font-semibold text-oro-oscuro">con un solo interlocutor</span>.
    </h1>
    <p class="mt-8 max-w-[56ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
      Software a medida, integración, CRM y ERP, Microsoft, nube, ciberseguridad, hardware y planta, web, datos, IA e
      I+D. Un socio técnico que entiende todo lo que te rodea y te lo explica con claridad.
    </p>

    <div class="mt-14 flex flex-wrap items-center gap-8" data-reveal>
      <p class="font-mono text-[12px] leading-[1.6] tracking-[0.04em] text-pizarra">
        Doce ámbitos · Un interlocutor · Sin fabricantes impuestos
      </p>
      <Boton href={href('/contacto/')}>Cuéntanos tu caso →</Boton>
    </div>
  </section>

  <!-- Para quién -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-12 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Para quién es</p>
        <h2 class="mt-5 font-display text-[clamp(26px,3.2vw,38px)] font-extralight leading-[1.15] tracking-[-0.03em]">
          Para quien no tiene un director de tecnología en plantilla.
        </h2>
      </div>
      <div class="md:col-span-7 md:pl-6" data-reveal>
        <p class="text-[17px] text-pizarra">
          Para empresas con tecnología de varios proveedores y sin un responsable interno que la coordine: el ERP de uno, el CRM
          de otro, la web de una agencia, las máquinas con su propio software. Ponemos un responsable técnico a tu
          lado que conoce todas esas piezas. Si lo que necesitas es solo IA, el servicio es el
          <a href={href('/servicios/director-ia/')} class="font-medium text-tinta underline decoration-oro/60 underline-offset-4 transition-colors hover:text-oro-oscuro">Director de IA externo</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Qué cubrimos -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Qué cubrimos</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          De la nave a la nube: doce ámbitos y las tecnologías de cada uno.
        </h2>
      </div>
      <ul class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3" role="list">
        {
          ambitos.map((a) => (
            <li class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-pizarra">{a.n}</span>
              <h3 class="mt-3 font-display text-[20px] font-semibold leading-[1.3]">{a.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{a.texto}</p>
              <ul class="mt-5 flex flex-1 flex-wrap content-start gap-2" role="list">
                {a.tecnologias.map((t) => (
                  <li class="rounded-[3px] border border-linea bg-papel px-2.5 py-1 font-mono text-[11px] text-tinta/80">{t}</li>
                ))}
              </ul>
              {a.enlace && (
                <a href={href(a.enlace.ruta)} class="mt-6 font-mono text-[12px] text-tinta/80 transition-colors hover:text-oro-oscuro">
                  {a.enlace.texto} →
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Cómo trabajamos -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow text-oro-luz">Cómo trabajamos</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Qué puedes esperar de nosotros, sea cual sea la tecnología.
        </h2>
      </div>
      <ol class="mt-14 grid gap-8 md:grid-cols-4" role="list">
        {
          modalidades.map((m) => (
            <li class="border-t border-marfil/15 pt-6" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-luz">{m.n}</span>
              <h3 class="mt-3 font-display text-[18px] font-semibold leading-[1.3]">{m.titulo}</h3>
              <p class="mt-2 text-[14px] text-marfil/65">{m.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Otros servicios -->
  <section class="hairline bg-panel">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow" data-reveal>Otras formas de trabajar</p>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-3" role="list">
        {
          otros.map((o) => (
            <li class="bg-panel" data-reveal>
              <a href={href(o.ruta)} class="group flex h-full flex-col p-8 transition-colors hover:bg-oro/5">
                <span class="eyebrow text-pizarra">{o.etiqueta}</span>
                <h3 class="mt-3 font-display text-[20px] font-semibold">{o.titulo}</h3>
                <p class="mt-2 flex-1 text-[15px] text-pizarra">{o.pie}</p>
                <span class="mt-6 font-mono text-[12px] text-tinta/80 group-hover:text-oro-oscuro">Ver el detalle →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <GuiasRelacionadas ruta={'/servicios/partner/'} idioma="es" />

  <Cta />
</Base>

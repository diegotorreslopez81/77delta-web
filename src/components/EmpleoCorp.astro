    ctaB: 'Enviar candidatura',
    gdpr: 'Responsable: Next Gen Academy SL (77 Delta). Usamos tus datos solo para valorar tu candidatura. Borrado: hola@77delta.com.',
    dev: '/trabaja-con-nosotros/developer/',
  },
  en: {
    title: 'Work with us',
    desc: 'AI consultancy based in Barcelona. We work remotely and by project with agents and automation.',
    eyebrow: 'Work with us',
    h1: 'We build with AI. We look for people with judgement.',

---
/** Pie de página: franja de tinta, como en la web anterior. Mismo orden que el menú: Qué hacemos (4 líneas + servicios), Resultados, Herramientas, Empresa, Legal. */
import Monograma from './Monograma.astro';
import { site, enlaceDe, type Idioma } from '../lib/site';

const idioma: Idioma = Astro.currentLocale === 'ca' || Astro.currentLocale === 'en' ? Astro.currentLocale : 'es';
const enlace = enlaceDe(idioma);

const columnasEs = [
  {
    titulo: 'Qué hacemos',
    enlaces: [
      { texto: 'Inteligencia artificial', ruta: '/inteligencia-artificial/' },
      { texto: 'Ciberseguridad', ruta: '/ciberseguridad/' },
      { texto: 'Identidad digital', ruta: '/identidad-digital/' },
      { texto: 'Espacios de datos', ruta: '/espacios-de-datos/' },
      { texto: 'Director de IA externo', ruta: '/servicios/director-ia/' },
      { texto: 'Diagnóstico', ruta: '/servicios/diagnostico/' },
      { texto: 'Transformación operativa', ruta: '/servicios/transformacion/' },
      { texto: 'Seguridad de asistentes de IA', ruta: '/ciberseguridad/#asistentes-ia' },
      { texto: 'Partner tecnológico', ruta: '/servicios/partner/' },
      { texto: 'Acreditación ACCIÓ', ruta: '/inteligencia-artificial/#cupo' },
    ],
  },
  {
    titulo: 'Resultados',
    enlaces: [
      { texto: 'Historias de éxito', ruta: '/historias-de-exito/' },
      { texto: 'Casos de uso', ruta: '/casos-de-uso/' },
      { texto: 'Sectores', ruta: '/sectores/' },
      { texto: 'Proyectos en curso', ruta: '/proyectos-en-curso/' },
    ],
  },
  {
    titulo: 'Herramientas',
    enlaces: [
      { texto: 'Licita', ruta: '/licita/' },
      { texto: 'Corpora', ruta: '/herramientas/#corpora' },
    ],
  },
  {
    titulo: 'Empresa',
    enlaces: [
      { texto: 'Sobre nosotros', ruta: '/sobre-nosotros/' },
      { texto: 'Blog', ruta: '/blog/' },
      { texto: 'Trabaja con nosotros', ruta: '/trabaja-con-nosotros/' },
      { texto: 'Contacto', ruta: '/contacto/' },
    ],
  },
  {
    titulo: 'Legal',
    enlaces: [
      { texto: 'Aviso legal', ruta: '/aviso-legal/' },
      { texto: 'Privacidad', ruta: '/politica-privacidad/' },
      { texto: 'Cookies', ruta: '/politica-cookies/' },
    ],
  },
];

const columnasCa = [
  {
    titulo: 'Què fem',
    enlaces: [
      { texto: 'Intel·ligència artificial', ruta: '/intel-ligencia-artificial/' },
      { texto: 'Ciberseguretat', ruta: '/ciberseguretat/' },
      { texto: 'Identitat digital', ruta: '/identitat-digital/' },
      { texto: 'Espais de dades', ruta: '/espais-de-dades/' },
      { texto: 'Director d’IA extern', ruta: '/servicios/director-ia/' },
      { texto: 'Diagnòstic', ruta: '/servicios/diagnostico/' },
      { texto: 'Transformació operativa', ruta: '/servicios/transformacion/' },
      { texto: 'Seguretat d’assistents d’IA', ruta: '/ciberseguretat/#asistentes-ia' },
      { texto: 'Soci tecnològic', ruta: '/servicios/partner/' },
      { texto: 'Acreditació ACCIÓ', ruta: '/intel-ligencia-artificial/#cupo' },
    ],
  },
  {
    titulo: 'Resultats',
    enlaces: [
      { texto: 'Històries d’èxit', ruta: '/historias-de-exito/' },
      { texto: 'Casos d’ús', ruta: '/casos-de-uso/' },
      { texto: 'Sectors', ruta: '/sectores/' },
      { texto: 'Projectes en curs', ruta: '/proyectos-en-curso/' },

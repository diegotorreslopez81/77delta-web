---
import { entradas, fecha, type Idioma } from '../../lib/blog';
import { href as hrefEs, hrefCa } from '../../lib/site';

interface Props {
  /** Ruta en castellano de la página (p. ej. /servicios/diagnostico/). */
  ruta: string;
  idioma?: Idioma;
}
const { ruta, idioma = 'es' } = Astro.props;
const href = idioma === 'ca' ? hrefCa : hrefEs;
const lista = (await entradas(idioma)).filter((e) => e.data.relacionados.includes(ruta)).slice(0, 3);
const titulo = idioma === 'ca' ? 'Guies relacionades' : 'Guías relacionadas';
---

{
  lista.length > 0 && (
    <section class="hairline" aria-labelledby="guias-rel">
      <div class="wrap py-16 md:py-20">
        <p class="eyebrow">Blog</p>
        <h2 id="guias-rel" class="mt-4 font-display text-[clamp(24px,2.8vw,34px)] font-extralight tracking-[-0.03em]">{titulo}</h2>
        <ul class="mt-8 grid gap-4 md:grid-cols-3">
          {lista.map((e) => (
            <li class="rounded-[14px] border border-linea bg-panel p-6">
              <a href={href(`/blog/${e.id.replace(/^ca\//, '')}/`)} class="font-display text-[18px] font-semibold leading-snug hover:text-oro-oscuro">{e.data.title}</a>
              <p class="mt-3 text-[14px] text-pizarra">{e.data.description}</p>
              <p class="mt-4 font-mono text-[11px] uppercase tracking-[0.14em] text-pizarra">{fecha(e.data.pubDate, idioma)}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

---
/** Cabecera en tinta con el monograma en marfil; botón de acción en ocre. Las entradas con `hijos` despliegan un submenú. */
import Monograma from './Monograma.astro';
import SelectorIdiomas, { type IdiomaOpcion } from './SelectorIdiomas.astro';
import { nav, navCa, cta, ctaCa, href, hrefCa, equivalenteCa, equivalenteEs, type ItemNav } from '../lib/site';

interface Props {
  /** Oculta el selector de idioma en páginas sin versión en catalán (p. ej. /propuestas/). */
  selectorIdioma?: boolean;
  /** Si llega, se pinta el selector de píldoras (ES CA GL EU) en lugar del enlace es/ca. */
  idiomas?: IdiomaOpcion[];
}
const { selectorIdioma = true, idiomas } = Astro.props;
const idioma = Astro.currentLocale === 'ca' ? 'ca' : 'es';
const enlace = idioma === 'ca' ? hrefCa : href;
const items = idioma === 'ca' ? navCa : nav;
const boton = idioma === 'ca' ? ctaCa : cta;
const actual = Astro.url.pathname;
const activoRuta = (ruta: string) => actual.startsWith(enlace(ruta));
/** Una entrada está activa si lo está su ruta o la de cualquiera de sus hijos. */
const activo = (n: ItemNav) => activoRuta(n.ruta) || (n.hijos ?? []).some((h) => activoRuta(h.ruta));
const otroIdioma = idioma === 'ca' ? 'es' : 'ca';
const enlaceOtroIdioma = idioma === 'ca' ? equivalenteEs(actual) : equivalenteCa(actual);
---

<header class="sticky top-0 z-50 border-b border-marfil/10 bg-marino/95 text-marfil backdrop-blur-xl">
  <div class="wrap flex h-[72px] items-center justify-between gap-6">
    <a href={enlace('/')} class="text-marfil" aria-label="77 Delta, inicio">
      <Monograma size={26} />
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-7 lg:flex">
      {
        items.map((n) => (
          <div class="group relative">
            <a
              href={enlace(n.ruta)}
              class:list={[
                'inline-flex items-center gap-1.5 py-2 text-[14px] font-medium transition-colors duration-200 hover:text-marfil',
                activo(n) ? 'text-oro-luz' : 'text-marfil/70',
              ]}
              aria-current={activoRuta(n.ruta) ? 'page' : undefined}
              aria-haspopup={n.hijos ? 'true' : undefined}
            >
              {n.texto}
              {n.hijos && (
                <svg
                  class="h-3 w-3 opacity-60 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180"
                  viewBox="0 0 12 12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M2.5 4.5 6 8l3.5-3.5" />
                </svg>
              )}
            </a>
            {n.hijos && (
              <div class="invisible absolute -left-4 top-full z-50 pt-3 opacity-0 transition-opacity duration-200 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <ul
                  class="min-w-[272px] rounded-[10px] border border-marfil/12 bg-marino p-2 shadow-[0_18px_48px_rgba(0,0,0,.45)]"
                  role="list"
                >
                  {n.hijos.map((h) => (
                    <li>
                      <a
                        href={enlace(h.ruta)}
                        class:list={[
                          'flex flex-col gap-0.5 rounded-[6px] px-3 py-2.5 transition-colors duration-150 hover:bg-marfil/[0.08]',
                          activoRuta(h.ruta) ? 'text-oro-luz' : 'text-marfil/85 hover:text-marfil',
                        ]}
                        aria-current={activoRuta(h.ruta) ? 'page' : undefined}
                      >
                        <span class="text-[14px] font-medium">{h.texto}</span>
                        {h.nota && (
                          <span class="font-mono text-[11px] uppercase tracking-[0.08em] text-oro-luz">{h.nota}</span>
                        )}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      {idiomas && <SelectorIdiomas idiomas={idiomas} globo class="hidden sm:flex" />}
      {!idiomas && selectorIdioma && (
        <a
          href={enlaceOtroIdioma}
          data-selector-idioma
          data-idioma-destino={otroIdioma}
          class="hidden shrink-0 rounded-[6px] border border-marfil/25 px-2.5 py-1.5 font-mono text-[12px] font-semibold uppercase tracking-[0.04em] text-marfil/80 transition-colors duration-200 hover:border-marfil/60 hover:text-marfil sm:inline-flex"
          aria-label={idioma === 'ca' ? 'Canviar a castellà' : 'Cambiar a català'}
        >
          {otroIdioma}
        </a>
      )}
      <a
        href={enlace(boton.ruta)}
        class="inline-flex items-center whitespace-nowrap rounded-[8px] bg-oro px-4 py-2.5 text-[13px] font-semibold text-marfil transition-[background-color,color,box-shadow] duration-200 hover:bg-marfil hover:text-tinta hover:shadow-[0_6px_20px_rgba(0,0,0,.3)] sm:px-5"
      >
        <span class="hidden sm:inline">{boton.texto}</span><span class="sm:hidden">{idioma === 'ca' ? 'Reservar' : 'Reservar'}</span>
      </a>
      <button
        type="button"
        class="grid h-10 w-10 place-items-center text-marfil lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-movil"
        data-burger
      >
        <span class="block h-0.5 w-5 rounded bg-current"></span>
        <span class="mt-[5px] block h-0.5 w-5 rounded bg-current"></span>
      </button>
    </div>
  </div>

  <div id="menu-movil" class="hidden border-t border-marfil/10 bg-marino shadow-[0_16px_40px_rgba(0,0,0,.35)] lg:hidden" data-menu>
    <nav aria-label="Principal, móvil" class="wrap flex flex-col py-3">
      {idiomas && <SelectorIdiomas idiomas={idiomas} class="px-3 pb-3 pt-1 sm:hidden" />}
      {
        items.map((n) => (
          <>
            <a
              href={enlace(n.ruta)}
              class:list={[
                'rounded-[8px] px-3 py-3 text-[15px] font-medium hover:bg-marfil/10',
                activo(n) ? 'text-oro-luz' : 'text-marfil',
              ]}
            >
              {n.texto}
            </a>
            {n.hijos && (
              <ul class="mb-2 ml-4 border-l border-marfil/15 pl-2" role="list">
                {n.hijos.map((h) => (
                  <li>
                    <a
                      href={enlace(h.ruta)}
                      class:list={[
                        'flex items-baseline justify-between gap-3 rounded-[8px] px-3 py-2 text-[14px] hover:bg-marfil/10',
                        activoRuta(h.ruta) ? 'text-oro-luz' : 'text-marfil/80',
                      ]}
                    >
                      <span>{h.texto}</span>
                      {h.nota && <span class="shrink-0 font-mono text-[11px] uppercase tracking-[0.06em] text-oro-luz">{h.nota}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </>
        ))
      }
      {!idiomas && selectorIdioma && (
        <a
          href={enlaceOtroIdioma}
          data-selector-idioma
          data-idioma-destino={otroIdioma}
          class="mt-2 rounded-[8px] border-t border-marfil/10 px-3 py-3 pt-4 font-mono text-[13px] font-semibold uppercase tracking-[0.04em] text-marfil/80"
        >
          {idioma === 'ca' ? 'Castellano' : 'Català'}
        </a>
      )}
    </nav>
  </div>
</header>

<script>
  const boton = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  boton?.addEventListener('click', () => {
    const abierto = boton.getAttribute('aria-expanded') === 'true';
    boton.setAttribute('aria-expanded', String(!abierto));
    boton.setAttribute('aria-label', abierto ? 'Abrir menú' : 'Cerrar menú');
    menu?.classList.toggle('hidden', abierto);
  });

  // Elección manual de idioma: se recuerda, para que el script de detección de Base.astro no la pise.
  document.querySelectorAll<HTMLAnchorElement>('[data-selector-idioma]').forEach((a) => {
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('idioma-77delta', a.dataset.idiomaDestino ?? '');
      } catch {}
    });
  });
</script>

---
import Base from '../../../layouts/Base.astro';
import HeroFoto from '../../../components/HeroFoto.astro';
import { site, hrefEn as href } from '../../../lib/site';

const sectores = [
  'Clinics and healthcare centres',
  'Industry and workshops',
  'Distribution and logistics',
  'Professional firms',
  'Public administration',
  'Training and HR',
  'Other',
];

const vias = [
  {
    titulo: 'Book a conversation',
    texto:
      '30 minutes by video call. Free. No commitment. We send you a tailored proposal after the call.',
    enlace: site.calendario,
    etiqueta: 'Open the calendar →',
    externo: true,
  },
  {
    titulo: 'Direct email',
    texto: 'Write to us directly and we will reply within 24 working hours.',
    enlace: `mailto:${site.email}`,
    etiqueta: `${site.email} →`,
    externo: false,
  },
  {
    titulo: 'LinkedIn',
    texto: 'Follow our day-to-day work and public activity. We also reply to messages.',
    enlace: site.linkedin,
    etiqueta: 'View profile →',
    externo: true,
  },
];

const campo =
  'mt-3 w-full rounded-[8px] border border-tinta/15 bg-panel px-4 py-3 font-sans text-[15px] text-tinta transition-colors placeholder:text-pizarra/60 focus:border-oro';
const etiqueta = 'block font-mono text-[11px] uppercase tracking-[0.18em] text-pizarra';
---

<Base
  title="Contact"
  description="Tell us about your situation. We reply within 24 working hours, or you can book an initial 30-minute call directly."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>Contact</p>
        <h1
          class="mt-7 max-w-[16ch] font-display text-[clamp(36px,4.6vw,60px)] font-extralight leading-[1.04] tracking-[-0.035em]"
          data-reveal
        >
          Tell us about your situation.
        </h1>
        <p class="mt-8 max-w-[52ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
          We reply within 24 working hours. If you prefer, book an initial 30-minute call
          directly in the calendar.
        </p>
      </div>
      <HeroFoto foto="gerente" alt="Two professionals talking in an office" class="lg:col-span-5" />
    </div>
  </section>

  <!-- Calendario -->
  <section class="hairline bg-panel">
    <div class="wrap py-20 md:py-24">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Book directly</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Pick a slot in the calendar.
        </h2>
        <p class="mt-6 text-[17px] text-pizarra">
          Thirty minutes by video call, free and with no commitment. If you would rather write first, the
          form is below.
        </p>
      </div>
      <div class="mt-10 overflow-hidden rounded-[8px] border border-linea bg-panel" data-reveal>
        <div
          id="calendario-caja"
          class="flex h-[620px] flex-col items-center justify-center gap-6 px-8 text-center"
          data-src={site.calendarioIncrustado}
        >
          <p class="max-w-[46ch] text-[15px] text-pizarra">
            The calendar is served by Google. Nothing from Google is loaded until you click the button. When you do,
            Google may set its own cookies.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-5">
            <button
              type="button"
              id="calendario-boton"
              class="inline-flex items-center justify-center gap-2 text-center rounded-[10px] bg-oro px-6 py-3.5 font-sans text-[15px] font-semibold text-marfil shadow-[0_6px_24px_rgba(167,120,27,.30)] transition-[background-color,transform] duration-200 hover:-translate-y-px hover:bg-tinta"
            >
              Show calendar (loads Google Calendar, uses cookies) →
            </button>
            <a
              href={site.calendario}
              target="_blank"
              rel="noopener"
              class="text-[14px] text-tinta underline decoration-linea underline-offset-4 transition-colors hover:decoration-oro"
            >
              Open in a separate tab →
            </a>
          </div>
        </div>
      </div>
      <p class="mt-5 max-w-[62ch] text-[13px] text-pizarra">
        By clicking "Show calendar" you accept that Google sets its own cookies to display the calendar.
        If you prefer not to accept them, use the <a
          href="#form-contacto"
          class="text-tinta underline decoration-linea underline-offset-4 transition-colors hover:decoration-oro"
          >form</a
        > or the <a
          href={site.calendario}
          target="_blank"
          rel="noopener"
          class="text-tinta underline decoration-linea underline-offset-4 transition-colors hover:decoration-oro"
          >link above</a
        >, which opens the Google calendar without embedding it in this page.
      </p>
    </div>
  </section>

  <script>
    // The Google calendar is not loaded until the visitor asks for it: the click is consent
    // for any cookies Google may set (see cookie policy).
    const calendarioCaja = document.querySelector<HTMLDivElement>('#calendario-caja');
    const calendarioBoton = document.querySelector<HTMLButtonElement>('#calendario-boton');

    calendarioBoton?.addEventListener('click', () => {
      const src = calendarioCaja?.dataset.src;
      if (!calendarioCaja || !src) return;
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = '77 Delta booking calendar';
      iframe.className = 'h-[620px] w-full border-0';
      calendarioCaja.replaceChildren(iframe);
      calendarioCaja.className = '';
    });
  </script>

  <!-- Formulario y otras vías -->
  <section class="hairline">
    <div class="wrap grid gap-16 py-24 md:grid-cols-12 md:gap-12 md:py-32">
      <!-- Formulario -->
      <div class="md:col-span-7" data-reveal>
        <p class="eyebrow">Write to us</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Describe your situation in your own words.
        </h2>
        <p class="mt-6 max-w-[48ch] text-[17px] text-pizarra">
          We reply within 24 working hours.
        </p>

        <form
          id="form-contacto"
          class="relative mt-12 grid gap-7 sm:grid-cols-2"
          action={`mailto:${site.email}`}
          method="post"
          enctype="text/plain"
          data-destino={site.email}
          data-endpoint={site.formulario}
          novalidate={false}
        >
          <!-- Honeypot: oculto a personas, los bots lo rellenan. -->
          <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
            <label for="web">Web</label>
            <input type="text" id="web" name="web" tabindex="-1" autocomplete="off" />
          </div>
          <div>
            <label class={etiqueta} for="nombre">Name</label>
            <input class={campo} type="text" id="nombre" name="nombre" autocomplete="name" required />
          </div>

          <div>
            <label class={etiqueta} for="empresa">Company</label>
            <input class={campo} type="text" id="empresa" name="empresa" autocomplete="organization" required />
          </div>

          <div>
            <label class={etiqueta} for="email">Email</label>
            <input class={campo} type="email" id="email" name="email" autocomplete="email" required />
          </div>

          <div>
            <label class={etiqueta} for="sector">Industry</label>
            <select
              class={`${campo} appearance-none [&_option]:bg-panel [&_option]:text-tinta`}
              id="sector"
              name="sector"
              required
            >
              <option value="" disabled selected>Select your industry</option>
              {sectores.map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>

          <div class="sm:col-span-2">
            <label class={etiqueta} for="mensaje">How can we help you?</label>
            <textarea class={campo} id="mensaje" name="mensaje" rows="6" required></textarea>
          </div>

          <div class="sm:col-span-2">
            <button
              type="submit"
              data-umami-event="form-contacto"
              class="inline-flex items-center justify-center gap-2 text-center rounded-[10px] bg-oro px-6 py-3.5 font-sans text-[15px] font-semibold text-marfil shadow-[0_6px_24px_rgba(167,120,27,.30)] transition-[background-color,transform] duration-200 hover:-translate-y-px hover:bg-tinta disabled:cursor-wait disabled:opacity-60"
            >
              Send message →
            </button>
            <p id="form-estado" class="mt-5 hidden max-w-[52ch] text-[15px] text-tinta" role="status" aria-live="polite"></p>
            <p class="mt-6 max-w-[52ch] text-[13px] text-pizarra">
              Your data is processed in the European Union in accordance with the GDPR. We do not share it with third parties. Further details in
              our <a
                href={href('/politica-privacidad/')}
                class="text-tinta underline decoration-linea underline-offset-4 transition-colors hover:decoration-oro"
                >privacy policy</a
              >.
            </p>
          </div>
        </form>
      </div>

      <!-- Otras vías -->
      <div class="md:col-span-5 md:pl-6" data-reveal>
        <p class="eyebrow">Other ways to reach us</p>
        <ul class="mt-10" role="list">
          {
            vias.map((v) => (
              <li class="border-t border-linea py-8 first:pt-0">
                <h3 class="font-display text-[19px] font-semibold">{v.titulo}</h3>
                <p class="mt-3 text-[15px] text-pizarra">{v.texto}</p>
                <a
                  href={v.enlace}
                  target={v.externo ? '_blank' : undefined}
                  rel={v.externo ? 'noopener' : undefined}
                  class="mt-5 inline-block font-mono text-[12px] text-oro-oscuro transition-colors hover:text-tinta"
                >
                  {v.etiqueta}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <script>
    // Envía el formulario al endpoint propio (api/ del repo). Si no responde, cae al mailto de siempre.
    const form = document.querySelector<HTMLFormElement>('#form-contacto');
    const estado = document.querySelector<HTMLParagraphElement>('#form-estado');
    const boton = form?.querySelector<HTMLButtonElement>('button[type=submit]');

    const mostrar = (texto: string) => {
      if (!estado) return;
      estado.textContent = texto;
      estado.classList.remove('hidden');
    };

    const leerCampos = (f: HTMLFormElement) => {
      const datos = new FormData(f);
      const leer = (nombre: string) => String(datos.get(nombre) ?? '').trim();
      return {
        nombre: leer('nombre'),
        empresa: leer('empresa'),
        email: leer('email'),
        sector: leer('sector'),
        mensaje: leer('mensaje'),
        web: leer('web'),
        origen: location.pathname,
      };
    };

    const abrirCorreo = (destino: string, c: ReturnType<typeof leerCampos>) => {
      const asunto = `Website contact · ${c.empresa}`;
      const cuerpo = [`Name: ${c.nombre}`, `Company: ${c.empresa}`, `Email: ${c.email}`, `Industry: ${c.sector}`, '', c.mensaje].join('\n');
      window.location.href = `mailto:${destino}?subject=${encodeURIComponent(asunto)}&body=${encodeURIComponent(cuerpo)}`;
    };

    form?.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      const destino = form.dataset.destino ?? '';
      const endpoint = form.dataset.endpoint ?? '';
      const campos = leerCampos(form);

      if (!endpoint) return abrirCorreo(destino, campos);

      if (boton) boton.disabled = true;
      mostrar('Sending…');
      try {
        const r = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(campos),
        });
        const respuesta = (await r.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (r.ok && respuesta.ok) {
          form.reset();
          mostrar('Thank you, we have received your message. We will reply within 24 working hours.');
          return;
        }
        if (r.status === 400 || r.status === 429) {
          mostrar(r.status === 429 ? 'Too many submissions. Please try again in a few minutes.' : 'We could not send your message. Please check the fields.');
          return;
        }
        throw new Error(`respuesta ${r.status}`);
      } catch {
        mostrar('We cannot send your message from here right now, so your email app will open with it ready to send.');
        abrirCorreo(destino, campos);
      } finally {
        if (boton) boton.disabled = false;
      }
    });
  </script>
</Base>

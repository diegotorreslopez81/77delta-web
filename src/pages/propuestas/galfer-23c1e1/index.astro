.oferta .chat .cursor{display:inline-block;width:8px;height:1em;background:var(--oro-luz);vertical-align:-2px;margin-left:2px;animation:p .9s infinite}
@keyframes p{50%{opacity:0}}
.oferta .cta{background:var(--marino);color:var(--marfil);border-radius:20px;padding:46px 44px;text-align:center}
.oferta .cta h2{color:#fff;margin-bottom:10px}
.oferta .cta p{color:var(--pizarra-clara);max-width:52ch;margin:0 auto 26px}
.oferta .cta .acciones{justify-content:center;margin-top:0}
.oferta .cta .contacto{margin-top:22px;font-size:14px;color:var(--pizarra-clara)}
.oferta .cta .contacto a{color:var(--oro-luz);text-decoration:none}
.oferta footer{padding:28px 0 46px;border-top:1px solid var(--linea);margin-top:30px;font-size:13px;color:var(--pizarra)}
.oferta footer p{margin:0 0 6px}
@media(max-width:860px){.oferta .kpis,.oferta .senales,.oferta .casos,.oferta .areas{grid-template-columns:1fr}
.oferta .oscuro,.oferta .demo{grid-template-columns:1fr;padding:28px}
.oferta .cta{padding:34px 22px}
.oferta .hero{padding:40px 0 24px}
.oferta .total .t{margin-left:0}}
</style>
<script is:inline>
(function(){
var C=[{"q": "¿Qué productos fabrican y dónde?", "a": "GALFER diseña y fabrica discos, pastillas y latiguillos de freno para motocicletas y bicicletas. Todo se produce en su fábrica de 6.000 m2 en Granollers (Barcelona), junto al Circuit de Catalunya."}, {"q": "¿Qué certificaciones de calidad tienen?", "a": "Su sistema integrado de calidad, medio ambiente y energía cumple IATF16949, con ISO 9001, ISO 14001 e ISO 50001. Sus productos cuentan además con certificados TÜV y ECE R90."}, {"q": "¿Tienen oficinas fuera de España?", "a": "Sí, además de Granollers tienen sedes en Orlando (EE. UU.) y en Bosisio Parini (Italia), cada una con su correo de contacto. Puede escribir a info@galfer.com y le derivarán a la sede adecuada."}],chat=document.getElementById('chat'),q=chat.querySelector('.q'),a=chat.querySelector('.a'),t;

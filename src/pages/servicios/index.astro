---
import Base from '../../layouts/Base.astro';
import HeroFoto from '../../components/HeroFoto.astro';
import Cta from '../../components/Cta.astro';
import { href, site } from '../../lib/site';
import { resumen, recorrido, faq } from '../../data/servicios';
---

<Base
  title="Servicios"
  description="Diagnóstico gratuito, transformación operativa con IA, partner tecnológico y auditoría de seguridad de asistentes. Cuatro formas de trabajar con 77 Delta para reducir costes y aumentar la producción de tu empresa."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>Servicios</p>
        <h1
          class="mt-7 max-w-[20ch] font-display text-[clamp(36px,4.6vw,60px)] font-extralight leading-[1.04] tracking-[-0.035em]"
          data-reveal
        >
          Un director de IA externo y cuatro formas más de trabajar contigo. Un mismo objetivo: <span
            class="font-semibold text-oro-oscuro">reducir costes</span
          > y aumentar tu producción con IA aplicada, sin abrir riesgos por el camino.
        </h1>
        <p class="mt-8 max-w-[52ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
          Cada empresa es distinta. Por eso empezamos siempre por el diagnóstico. A partir de ahí, tú decides el
          recorrido: director de IA con cuota fija, proyecto puntual, acompañamiento continuo o una combinación.
        </p>
      </div>
      <HeroFoto foto="gerente" alt="Dos profesionales conversando en una oficina" class="lg:col-span-5" />
    </div>

    <a
      href={href('/servicios/director-ia/')}
      class="group mt-16 flex flex-col gap-6 rounded-[4px] border border-oro/40 bg-marino p-8 text-marfil transition-colors hover:bg-tinta md:flex-row md:items-center md:justify-between md:p-10"
      data-reveal
    >
      <div>
        <span class="eyebrow text-oro-luz">Servicio principal · Cuota fija mensual</span>
        <h2 class="mt-4 font-display text-[clamp(24px,3vw,34px)] font-extralight leading-[1.15] tracking-[-0.03em]">
          Tu director de IA <span class="font-semibold text-oro-luz">desde 1.200 € al mes</span>.
        </h2>
        <p class="mt-3 max-w-[60ch] text-[15px] text-marfil/70">
          Una mañana al mes en tu empresa junto a tu equipo técnico, el resto a distancia y ahorro garantizado por contrato:
          si al tercer mes el ahorro no alcanza el doble de la cuota, puedes finalizar el contrato sin coste.
        </p>
      </div>
      <span class="shrink-0 font-mono text-[12px] text-marfil/80 group-hover:text-oro-luz">Ver el servicio →</span>
    </a>

    <div class="mt-4 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-4">
      {
        resumen.map((r) => (
          <a
            href={href(r.ruta)}
            class="group flex flex-col bg-panel p-8 transition-colors hover:bg-oro/5 md:p-10"
            data-reveal
          >
            <span class="eyebrow text-pizarra">{r.etiqueta}</span>
            <h2 class="mt-4 font-display text-[22px] font-semibold">{r.titulo}</h2>
            <p class="mt-3 flex-1 text-[15px] text-pizarra">{r.pie}</p>
            <span class="mt-8 font-mono text-[12px] text-tinta/80 group-hover:text-oro-oscuro">Ver el detalle →</span>
          </a>
        ))
      }
    </div>

    <p class="mt-8 max-w-[60ch] font-mono text-[12px] leading-[1.7] text-pizarra" data-reveal>
      Puedes empezar por uno y sumar el otro cuando lo necesites. O combinarlos desde el inicio.
    </p>
  </section>

  <!-- 01 · Diagnóstico -->

  <!-- 02 · Transformación operativa -->

  <!-- 03 · Partner tecnológico -->

  <!-- Acreditación ACCIÓ -->
  <!-- 04 · Seguridad de IA -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-7" data-reveal>
          <p class="eyebrow text-oro-luz">04 · Seguridad</p>
          <p class="eyebrow mt-6 text-marfil/50">Escaneo gratuito · remediación cotizada</p>
          <h2
            class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]"
          >
            Auditoría de los asistentes con IA que ya tienes publicados.
          </h2>
          <p class="mt-6 max-w-[56ch] text-[17px] text-marfil/72">
            Un chatbot con IA en tu web habla en tu nombre y puede revelar más información de la que debería.
            Probamos el tuyo como lo haría un atacante, te mostramos qué información se le escapa y, si
            quieres, corregimos las vulnerabilidades. El diagnóstico es gratuito.
          </p>
          <a href={href('/servicios/seguridad-ia/')} class="mt-8 inline-flex items-center gap-2 font-display text-[15px] text-oro-luz">
            Ver cómo lo auditamos →
          </a>
        </div>
        <ul class="grid gap-4 self-center md:col-span-5" role="list" data-reveal>
          {
            [
              ['Instrucciones', 'el system prompt y lo que el bot tiene prohibido decir'],
              ['Condiciones', 'precios, descuentos y márgenes que salen si se insiste'],
              ['Datos', 'información de clientes a la que el asistente llega'],
              ['Guion', 'inyección de instrucciones y respuestas fuera de control'],
            ].map(([campo, texto]) => (
              <li class="flex items-baseline gap-4 rounded-[4px] border border-marfil/12 bg-marfil/[0.04] px-5 py-4">
                <span class="shrink-0 whitespace-nowrap font-mono text-[11px] uppercase tracking-[0.14em] text-oro-luz">{campo}</span>
                <span class="text-[14px] text-marfil/70">{texto}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="cupo" class="hairline scroll-mt-[68px] bg-oro/[0.06]">
    <div class="wrap grid gap-10 py-20 md:grid-cols-12 md:py-24">
      <div class="md:col-span-7" data-reveal>
        <p class="eyebrow">Acreditación</p>
        <h2 class="mt-5 font-display text-[clamp(26px,3.2vw,40px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Proveedor acreditado por ACCIÓ.
        </h2>
        <p class="mt-6 max-w-[58ch] text-[17px] text-pizarra">
          {site.sociedad} figura en el registro oficial de proveedores tecnológicos de ACCIÓ, la agencia de la
          Generalitat de Catalunya para la competitividad empresarial. Si tu empresa opta a alguna de sus
          ayudas, lo revisamos en la conversación inicial.
        </p>
      </div>
      <div class="self-center md:col-span-5" data-reveal>
        <img
          src={href('/img/logos/accio.png')}
          alt="ACCIÓ, Generalitat de Catalunya"
          width="320"
          height="120"
          loading="lazy"
          decoding="async"
          class="h-14 w-auto"
        />
      </div>
    </div>
  </section>

  <!-- El recorrido típico -->
  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">El recorrido típico</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          De una conversación a la transformación, en pasos claros
        </h2>
        <p class="mt-6 text-[17px] text-pizarra">
          Cada empresa avanza a su ritmo. No existe obligación de avanzar al paso siguiente. La decisión es tuya en
          cada etapa.
        </p>
      </div>

      <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          recorrido.map((p) => (
            <li class="border-t border-linea pt-6" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{p.n}</span>
              <h3 class="mt-4 font-display text-[19px] font-semibold">{p.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="hairline">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Lo que más nos preguntan antes de empezar
        </h2>
      </div>

      <div class="md:col-span-7" data-reveal>
        {
          faq.map((f) => (
            <details class="group border-t border-linea py-5 last:border-b">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[17px] font-semibold marker:content-none">
                {f.pregunta}
                <span class="mt-1 shrink-0 font-mono text-[14px] text-oro-oscuro transition-transform duration-200 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-[62ch] text-[15px] text-pizarra">{f.respuesta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Cta
    titulo="El primer paso es una conversación. Sin compromiso."
    texto="30 minutos para entender tu realidad y orientarte sobre cómo aplicar IA en tu empresa con criterio."
    boton="Reservar diagnóstico gratuito"
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.pregunta, acceptedAnswer: { '@type': 'Answer', text: f.respuesta } })),
    })}
  />
</Base>

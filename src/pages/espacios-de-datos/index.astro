---
import Base from '../../layouts/Base.astro';
import HeroFoto from '../../components/HeroFoto.astro';
import Icono from '../../components/Icono.astro';
import Boton from '../../components/Boton.astro';
import Cta from '../../components/Cta.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import { href } from '../../lib/site';

const faq = [
  {
    "pregunta": "¿Compartir datos significa cederlos?",
    "respuesta": "No. Los datos se quedan en origen y cada organización fija las condiciones de uso. Se comparte el acceso, no la propiedad."
  },
  {
    "pregunta": "¿Necesito ser una gran empresa?",
    "respuesta": "No. Hay casos acotados que una pyme puede abordar. Empezamos por uno."
  },
  {
    "pregunta": "¿Qué tiene que ver con la IA?",
    "respuesta": "Los espacios de datos son la materia prima de modelos y agentes. La IA necesita datos limpios y con permisos claros, y permiten entrenarla con datos de varios actores sin que nadie los ceda."
  },
  {
    "pregunta": "¿Estamos obligados por el Data Act?",
    "respuesta": "Depende de si fabricas u ofreces productos conectados y servicios asociados. Se revisa en el diagnóstico."
  },
  {
    "pregunta": "¿Prometéis una certificación Gaia-X o IDSA?",
    "respuesta": "No. Gaia-X e IDSA son los marcos de referencia sobre los que diseñamos. Te ayudamos a alinearte con ellos, sin prometer certificaciones."
  }
] as const;
---

<Base
  title="Espacios de datos, Gaia-X e IDSA para empresas"
  description="Espacios de datos para empresas: compartimos datos con clientes, proveedores y administraciones sin cederlos. Gaia-X, IDSA y conectores. Diagnóstico a medida."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>Espacios de datos</p>
        <h1
          class="mt-7 max-w-[20ch] font-display text-[clamp(32px,4.2vw,54px)] font-extralight leading-[1.06] tracking-[-0.035em]"
          data-reveal
        >
          Compartir datos con otros, <span class="font-semibold text-oro-oscuro">sin perder el control</span> de los tuyos.
        </h1>
        <p class="mt-8 max-w-[52ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
          Los espacios de datos permiten que empresas y administraciones intercambien información con reglas claras y sin entregarla a un tercero. Te ayudamos a entenderlos, a decidir si te convienen y a conectarte.
        </p>
        <div class="mt-12 flex flex-wrap gap-4" data-reveal>
          <Boton href={href('/contacto/')}>Reservar diagnóstico</Boton>
          <Boton href="#hacemos" variante="linea">Ver qué hacemos</Boton>
        </div>
      </div>
      <HeroFoto foto="industria" alt="Planta industrial con equipos conectados" class="lg:col-span-5" />
    </div>
  </section>

  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Qué es, en tres líneas</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Un acuerdo técnico y legal para compartir sin ceder
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Espacio de datos</h3>
          <p class="mt-3 text-[15px] text-pizarra">Acuerdo técnico y legal para que varias organizaciones compartan datos, cada una con control sobre qué comparte, con quién y para qué.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Gaia-X</h3>
          <p class="mt-3 text-[15px] text-pizarra">Iniciativa europea que define las reglas de confianza e interoperabilidad para infraestructuras de datos federadas.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">IDSA</h3>
          <p class="mt-3 text-[15px] text-pizarra">International Data Spaces Association: publica la arquitectura de referencia y los estándares para intercambiar datos conservando la soberanía de quien los genera.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Qué gana una pyme</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Entrar en la cadena de valor de tus clientes con control
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <Icono nombre="industria" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Industria</h3>
          <p class="mt-3 text-[15px] text-pizarra">Datos de producción y máquinas ordenados, trazabilidad para el cliente y mantenimiento con datos del proveedor.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <Icono nombre="distribucion" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Distribución y servicios</h3>
          <p class="mt-3 text-[15px] text-pizarra">Pedidos, stock y entregas compartidos con clientes y marcas, sin correos ni Excel.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <Icono nombre="medir" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">IA que funciona</h3>
          <p class="mt-3 text-[15px] text-pizarra">Los proyectos de IA fallan por datos desordenados. Un espacio de datos los ordena primero y permite entrenar modelos con datos de varios actores sin que salgan de su origen.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="hacemos" class="hairline scroll-mt-24 bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Qué hacemos</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Conocimiento, consultoría y desarrollo
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="formacion" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Conocimiento</h3>
          <p class="mt-3 text-[15px] text-pizarra">Formación para dirección y equipos técnicos: qué es un espacio de datos federado, papel de Gaia-X e IDSA, qué cambia al conectarse; lectura clara del Data Act y del Data Governance Act; mapa de los espacios de datos sectoriales europeos.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="diagnostico" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Consultoría</h3>
          <p class="mt-3 text-[15px] text-pizarra">Inventario de datos compartibles y condiciones de uso; diseño de gobernanza (roles, políticas de acceso, contratos de uso del dato); plan de incorporación a un espacio existente o de creación de uno nuevo con tu clúster, asociación o cadena de valor.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="integracion" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Desarrollo</h3>
          <p class="mt-3 text-[15px] text-pizarra">Despliegue y configuración de conectores basados en Eclipse Dataspace Components; integración con ERP, bases de datos y plataformas sectoriales; publicación de catálogos; agentes y modelos de IA que consultan datos de varios actores sin que salgan de su origen.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Casos de aplicación</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Dónde se comparte con control
        </h2>
      </div>
      <ul class="mt-14 grid gap-4 md:grid-cols-2" role="list">
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Industria: fabricantes y proveedores comparten datos de producción y trazabilidad para cadena de suministro y mantenimiento predictivo.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Salud: centros y proveedores colaboran en investigación y planificación con datos que se quedan bajo control de cada institución.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Movilidad: operadores, ciudades y flotas combinan datos de rutas y ocupación.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Agroalimentario: productores, cooperativas y distribuidores comparten trazabilidad y datos de campo sin exponer información comercial.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Turismo: empresas y destinos comparten demanda y servicios para una experiencia coherente en el territorio.</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Cómo trabajamos</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          De saber qué datos tienes a compartirlos
        </h2>
      </div>
      <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">01</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Diagnóstico</h3>
          <p class="mt-3 text-[15px] text-pizarra">Actividad, datos y ecosistema, para ver si un espacio de datos aporta valor real.</p>
        </li>
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">02</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Diseño</h3>
          <p class="mt-3 text-[15px] text-pizarra">Qué se comparte, bajo qué reglas y con qué arquitectura, alineada con los marcos de Gaia-X e IDSA.</p>
        </li>
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">03</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Implantación</h3>
          <p class="mt-3 text-[15px] text-pizarra">Conector desplegado e integrado, probado con un caso de uso concreto.</p>
        </li>
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">04</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Explotación</h3>
          <p class="mt-3 text-[15px] text-pizarra">Acompañamiento del arranque y de nuevos casos, incluidos los de IA.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Para quién</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Quién necesita compartir datos con garantías
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Pyme en una cadena de valor</h3>
          <p class="mt-3 text-[15px] text-pizarra">Clientes o proveedores ya te piden datos de producción, trazabilidad o sostenibilidad.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Clúster o asociación sectorial</h3>
          <p class="mt-3 text-[15px] text-pizarra">Quiere crear o unirse a un espacio de datos para sus socios.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Administración</h3>
          <p class="mt-3 text-[15px] text-pizarra">Necesita compartir datos con empresas y otros organismos con garantías.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Líneas relacionadas -->
  <section class="hairline">
    <div class="wrap py-16 md:py-20">
      <p class="eyebrow" data-reveal>Líneas relacionadas</p>
      <div class="mt-8 flex flex-wrap gap-4" data-reveal>
        <Boton href={href('/identidad-digital/')} variante="linea">Identidad digital →</Boton>
        <Boton href={href('/ciberseguridad/')} variante="linea">Ciberseguridad →</Boton>
        <Boton href={href('/inteligencia-artificial/')} variante="linea">Inteligencia artificial →</Boton>
        <Boton href={href('/sectores/industria/')} variante="linea">Sector industria →</Boton>
        <Boton href={href('/sectores/administracion/')} variante="linea">Sector administración →</Boton>
      </div>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="hairline">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Lo que más nos preguntan antes de empezar
        </h2>
      </div>

      <div class="md:col-span-7" data-reveal>
        {
          faq.map((f) => (
            <details class="group border-t border-linea py-5 last:border-b">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[17px] font-semibold marker:content-none">
                {f.pregunta}
                <span class="mt-1 shrink-0 font-mono text-[14px] text-oro-oscuro transition-transform duration-200 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-[62ch] text-[15px] text-pizarra">{f.respuesta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Cta
    titulo="Empieza por saber qué datos tienes y con quién tiene sentido compartirlos."
    texto="Cuéntanos tu sector y tu cadena de valor. Te decimos si un espacio de datos te aporta algo y por dónde empezar."
    boton="Reservar diagnóstico"
  />
  <FaqSchema faq={faq} />
</Base>

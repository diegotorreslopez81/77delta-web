---
import Puente from '../../../components/Puente.astro';
// getStaticPaths se ejecuta aislado: el mapa va dentro y el destino viaja como prop.
export function getStaticPaths() {
  const destinos: Record<string, string> = {
    leakai: '/en/cybersecurity/',
    regulia: '/en/use-cases/',
    contestia: '/en/use-cases/',
    instantexam: '/en/use-cases/',
    scoreflow: '/en/use-cases/',
    contablia: '/en/use-cases/',
    swarmix: '/en/use-cases/',
  };
  return Object.entries(destinos).map(([slug, destino]) => ({ params: { slug }, props: { destino } }));
}
const { destino } = Astro.props;
---

<Puente destino={destino} idioma="en" />

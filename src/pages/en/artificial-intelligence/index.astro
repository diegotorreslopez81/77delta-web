---
import Base from '../../../layouts/Base.astro';
import HeroFoto from '../../../components/HeroFoto.astro';
import Boton from '../../../components/Boton.astro';
import Icono from '../../../components/Icono.astro';
import FaqSchema from '../../../components/FaqSchema.astro';
import Cta from '../../../components/Cta.astro';
import { hrefEn as href, site } from '../../../lib/site';
import { dimensiones } from '../../../lib/imagen';

const accio = dimensiones('/img/logos/accio.png');

const queHacemos = [
  {
    etiqueta: 'Knowledge',
    texto:
      'What AI can and cannot do in your sector, without jargon. Training for your team with cases from their daily work, and judgement on which tools and models make sense for you.',
  },
  {
    etiqueta: 'Consulting',
    texto:
      'A map of your processes and a priority list where AI delivers measurable savings. A plan with phases, timelines and an indicative budget, and a fractional AI director with a monthly report of hours saved.',
  },
  {
    etiqueta: 'Development',
    texto:
      'Custom assistants, agents and automations, integrated with your ERP, CRM, WhatsApp and email. When we finish, you keep the code, the keys, the data and the documentation.',
  },
];

const servicios = [
  {
    icono: 'piloto',
    etiqueta: 'Fixed monthly fee',
    titulo: 'Fractional AI director',
    texto: 'One morning a month at your company and the rest remotely, from €1,200 a month.',
    ruta: '/servicios/director-ia/',
  },
  {
    icono: 'diagnostico',
    etiqueta: 'Free',
    titulo: 'Assessment',
    texto: '30 minutes, no commitment, with a proposal and a work plan at the end.',
    ruta: '/servicios/diagnostico/',
  },
  {
    icono: 'transformacion',
    etiqueta: 'Project',
    titulo: 'Operational transformation',
    texto: 'Rollout, integration and training for the agreed proposal.',
    ruta: '/servicios/transformacion/',
  },
  {
    icono: 'medir',
    etiqueta: 'Free scan',
    titulo: 'AI security',
    texto: 'We audit your published assistants and fix what they miss.',
    ruta: '/ciberseguridad/#asistentes-ia',
  },
  {
    icono: 'partner',
    etiqueta: 'Ongoing support',
    titulo: 'Technology partner',
    texto: 'One technical partner for all the technology in your company, not just AI.',
    ruta: '/servicios/partner/',
  },
] as const;

const pasos = [
  { titulo: 'We understand', texto: 'A 30-minute interview and a form about your reality.' },
  { titulo: 'We propose', texto: 'Starting point, work plan and budget, with no commitment.' },
  { titulo: 'We build', texto: 'Human oversight by default and your team at the centre.' },
  { titulo: 'We measure', texto: 'Monthly follow-up with verifiable metrics.' },
];

const faq = [
  {
    pregunta: 'Where do I start with AI in my SME?',
    respuesta:
      'With a free 30-minute assessment, no commitment. We understand your operations, identify where AI delivers measurable savings and send you back a proposal with a plan and budget.',
  },
  {
    pregunta: 'Do I need my own technical team?',
    respuesta:
      'No. We can act as your fractional AI director or as your technology partner, and work alongside your technical team if you already have one.',
  },
  {
    pregunta: 'What do I keep when a project ends?',
    respuesta:
      'The code, the keys, the data and the documentation. You are not tied to us: everything we build is yours.',
  },
  {
    pregunta: 'Is there human oversight in what you build?',
    respuesta:
      'Yes, by default. Every automation or assistant has a human owner and a monthly follow-up with verifiable metrics.',
  },
];
---

<Base
  title="Artificial intelligence for SMEs"
  description="Artificial intelligence for SMEs: fractional AI director, assessment, operational transformation and technology partner. Start with 30 free minutes."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>Artificial intelligence</p>
        <h1
          class="mt-7 max-w-[20ch] font-display text-[clamp(36px,4.6vw,60px)] font-extralight leading-[1.04] tracking-[-0.035em]"
          data-reveal
        >
          Applied AI so your company <span class="font-semibold text-oro-oscuro">spends less</span> and produces more.
        </h1>
        <p class="mt-8 max-w-[54ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
          Knowledge, consulting and AI development for SMEs. We start with a free 30-minute assessment and you decide
          how far to go.
        </p>
        <div class="mt-12 flex flex-wrap gap-4" data-reveal>
          <Boton href={href('/contacto/')}>Book an assessment →</Boton>
          <Boton href="#servicios" variante="linea">See the five services</Boton>
        </div>
      </div>
      <HeroFoto foto="equipo" alt="A team gathered in an office" class="lg:col-span-5" />
    </div>
  </section>

  <!-- Qué hacemos -->
  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">What we do</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Knowledge, consulting and development, in that order.
        </h2>
      </div>
      <ul class="mt-16 grid gap-10 md:grid-cols-3" role="list">
        {
          queHacemos.map((q) => (
            <li class="border-t border-linea pt-8" data-reveal>
              <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-oro-oscuro">{q.etiqueta}</span>
              <p class="mt-4 text-[15px] text-pizarra">{q.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Los cinco servicios -->
  <section id="servicios" class="hairline scroll-mt-[68px]">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">The five services</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Pick one or combine them. All of them start with the assessment.
        </h2>
      </div>
      <div class="mt-16 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3 lg:[&>a:last-child]:col-span-2">
        {
          servicios.map((s) => (
            <a
              href={href(s.ruta)}
              class="group flex flex-col bg-panel p-8 transition-colors hover:bg-oro/5 md:p-10"
              data-reveal
            >
              <Icono nombre={s.icono} class="h-8 w-8 text-oro-oscuro" />
              <span class="eyebrow mt-6 text-pizarra">{s.etiqueta}</span>
              <h3 class="mt-3 font-display text-[22px] font-semibold">{s.titulo}</h3>
              <p class="mt-3 flex-1 text-[15px] text-pizarra">{s.texto}</p>
              <span class="mt-8 font-mono text-[12px] text-tinta/80 group-hover:text-oro-oscuro">See the details →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cómo trabajamos -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow text-oro-luz">How we work</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Four steps. The decision is yours at every one.
        </h2>
      </div>
      <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          pasos.map((p, i) => (
            <li class="border-t border-marfil/15 pt-6" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-luz">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-4 font-display text-[19px] font-semibold">{p.titulo}</h3>
              <p class="mt-3 text-[15px] text-marfil/70">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Acreditación ACCIÓ -->
  <section id="cupo" class="hairline scroll-mt-[68px] bg-oro/[0.06]">
    <div class="wrap grid gap-10 py-20 md:grid-cols-12 md:py-24">
      <div class="md:col-span-7" data-reveal>
        <p class="eyebrow">Accreditation</p>
        <h2 class="mt-5 font-display text-[clamp(26px,3.2vw,40px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Accredited provider of ACCIÓ's Cupó IA.
        </h2>
        <p class="mt-6 max-w-[58ch] text-[17px] text-pizarra">
          {site.sociedad} is an accredited provider of ACCIÓ's Cupó IA. ACCIÓ is the Generalitat de
          Catalunya agency for business competitiveness.
        </p>
      </div>
      <div class="self-center md:col-span-5" data-reveal>
        <img
          src={href('/img/logos/accio.png')}
          alt="ACCIÓ, Generalitat de Catalunya"
          width={accio?.width}
          height={accio?.height}
          loading="lazy"
          decoding="async"
          class="h-14 w-auto"
        />
      </div>
    </div>
  </section>

  <!-- Otras líneas -->
  <section class="hairline">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">The other lines</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          AI does not work alone.
        </h2>
      </div>
      <ul class="space-y-6 text-[17px] text-pizarra md:col-span-7" role="list" data-reveal>
        <li>
          AI needs well-shared, well-governed data:
          <a class="text-oro-oscuro underline underline-offset-4" href={href('/espacios-de-datos/')}>Data spaces</a>
          feeds it.
        </li>
        <li>
          An AI assistant is also an attack surface:
          <a class="text-oro-oscuro underline underline-offset-4" href={href('/ciberseguridad/')}>Cybersecurity</a>
          reviews it.
        </li>
        <li>
          Identity decides who gets access to what:
          <a class="text-oro-oscuro underline underline-offset-4" href={href('/identidad-digital/')}>Digital identity</a>
          solves it.
        </li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Frequently asked questions</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          What people ask us most before they start
        </h2>
      </div>
      <div class="md:col-span-7" data-reveal>
        {
          faq.map((f) => (
            <details class="group border-t border-linea py-5 last:border-b">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[17px] font-semibold marker:content-none">
                {f.pregunta}
                <span class="mt-1 shrink-0 font-mono text-[14px] text-oro-oscuro transition-transform duration-200 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-[62ch] text-[15px] text-pizarra">{f.respuesta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <FaqSchema faq={faq} />

  <Cta
    titulo="30 minutes. No commitment. The decision is yours."
    texto="We send you back a proposal with a starting point, a work plan and a budget."
    boton="Book an assessment"
  />
</Base>

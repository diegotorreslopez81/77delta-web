---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import type { IdiomaOpcion } from '../components/SelectorIdiomas.astro';
import Footer from '../components/Footer.astro';
import WhatsApp from '../components/WhatsApp.astro';
import Schema from '../components/Schema.astro';
import { metas } from '../lib/metas';
import { site, umami, searchConsole, href, equivalente, hreflangs, type Idioma } from '../lib/site';

interface Props {
  /** Título de la página, sin el nombre de la marca. */
  title: string;
  description?: string;
  /** Ruta de la imagen OG dentro de public/, sin base. */
  ogImage?: string;
  /** Borradores y páginas de prueba: fuera de buscadores. */
  noindex?: boolean;
  /** false en páginas sin versión en catalán: oculta el selector de idioma. */
  selectorIdioma?: boolean;
  /** Idioma de la página cuando no es es ni ca (gl, eu): fija <html lang>, hreflang propios y desactiva la detección. */
  lang?: string;
  /** hreflang propios, solo junto a `lang`. */
  alternates?: { hreflang: string; href: string }[];
  /** Píldoras de idioma en la cabecera (ES CA GL EU). */
  idiomas?: IdiomaOpcion[];
  /** Mapa idioma -> ruta: activa la detección del idioma del navegador entre es, ca, gl y eu. */
  deteccion?: Record<string, string>;
  /** Migas propias para el schema BreadcrumbList (artículos). */
  migas?: { nombre: string; ruta: string }[];
  /** og:type. 'article' en artículos del blog. */
  ogType?: 'website' | 'article';
}
const { title: tituloProp, description: descripcionProp = site.descripcion, ogImage = '/img/og.png', noindex = false, selectorIdioma = true, lang, alternates, idiomas, deteccion, ogType = 'website', migas } = Astro.props;

const metaPagina = metas[Astro.url.pathname];
const title = metaPagina?.title ?? tituloProp;
const description = metaPagina?.description ?? descripcionProp;

const idioma: Idioma = Astro.currentLocale === 'ca' || Astro.currentLocale === 'en' ? Astro.currentLocale : 'es';
const claimIdioma = idioma === 'ca' ? site.claimCa : idioma === 'en' ? site.claimEn : site.claim;
const tituloCompleto = title ? `${title} · ${site.nombre}` : `${site.nombre} · ${claimIdioma}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL(href(ogImage), Astro.site).href;
// Alternativas de idioma para hreflang y para la detección: la propia página y sus equivalentes (es, ca, en).
// x-default apunta al inglés cuando existe (el inglés es el idioma por defecto para quien no habla es ni ca).
const rutas: Partial<Record<Idioma, string>> = {};
for (const i of ['es', 'ca', 'en'] as const) {
  const r = i === idioma ? Astro.url.pathname : equivalente(Astro.url.pathname, i);
  if (r) rutas[i] = r;
}
const alternativas = (Object.keys(rutas) as Idioma[]).map((i) => ({ hreflang: hreflangs[i], href: new URL(rutas[i]!, Astro.site).href }));
const xDefault = new URL(rutas.en ?? rutas.es ?? Astro.url.pathname, Astro.site).href;
const ogLocale: Record<Idioma, string> = { es: 'es_ES', ca: 'ca_ES', en: 'en_GB' };
---

<!doctype html>
<html lang={lang ?? idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      !noindex && alternates && (
        <>
          {alternates.map((a) => (
            <link rel="alternate" hreflang={a.hreflang} href={a.href} />
          ))}
        </>
      )
    }
    {
      !noindex && !alternates && (
        <>
          {alternativas.map((a) => (
            <link rel="alternate" hreflang={a.hreflang} href={a.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={xDefault} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
    <link rel="alternate icon" href={href('/favicon.ico')} sizes="16x16 32x32 48x48" />
    <meta name="theme-color" content="#06101F" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {searchConsole && <meta name="google-site-verification" content={searchConsole} />}
    {umami.script && <script defer src={umami.script} data-website-id={umami.websiteId} is:inline />}

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[idioma]} />
    {(Object.keys(rutas) as Idioma[]).filter((i) => i !== idioma).map((i) => (
      <meta property="og:locale:alternate" content={ogLocale[i]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    {!lang && !deteccion && selectorIdioma && <script is:inline define:vars={{ idioma, rutas }}>
      // Detección de idioma por navegador (Diego, 23-10-2026): castellano, catalán o, para cualquier otro idioma, inglés.
      // Una elección manual guardada manda siempre. Los rastreadores no se redirigen, para que cada versión se indexe sola.
      // Corre lo antes posible (antes de pintar el body) para minimizar el parpadeo de idioma.
      try {
        var guardado = localStorage.getItem('idioma-77delta');
        var ua = navigator.userAgent || '';
        if (!guardado && !navigator.webdriver && !/bot|crawl|spider|slurp|headless|lighthouse|preview/i.test(ua)) {
          var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
          var codigo = 'en';
          for (var n = 0; n < langs.length; n++) {
            var p = String(langs[n]).toLowerCase().slice(0, 2);
            if (p === 'es' || p === 'ca' || p === 'en') { codigo = p; break; }
          }
          localStorage.setItem('idioma-77delta', codigo);
          if (codigo !== idioma && rutas[codigo]) location.replace(rutas[codigo]);
        }
      } catch (e) {}
    </script>}
    {deteccion && <script is:inline define:vars={{ actual: lang ?? idioma, deteccion }}>
      // Detección entre es, ca, gl y eu. Una elección guardada manda; sin ella, primer idioma del navegador soportado.
      // Nunca se redirige a castellano de forma automática: así los buscadores y quien llega por enlace a gl, eu o ca ven esa versión.
      try {
        if (!localStorage.getItem('idioma-77delta')) {
          var langs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
          var codigo = 'es';
          for (var n = 0; n < langs.length; n++) {
            var p = String(langs[n]).toLowerCase().slice(0, 2);
            if (p === 'ca' || p === 'gl' || p === 'eu') { codigo = p; break; }
          }
          localStorage.setItem('idioma-77delta', codigo);
          if (codigo !== 'es' && codigo !== actual && deteccion[codigo]) location.replace(deteccion[codigo]);
        }
      } catch (e) {}
    </script>}
    {!noindex && <Schema title={title} description={description} idioma={idioma} canonical={canonical} lang={lang} migas={migas} />}
  </head>
  <body class="min-h-screen bg-papel text-tinta">
    <Nav selectorIdioma={selectorIdioma} idiomas={idiomas} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsApp />

    <script>
      // Aparición al hacer scroll y contadores. Sin librerías.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const reveals = document.querySelectorAll<HTMLElement>('[data-reveal]');
      const contadores = document.querySelectorAll<HTMLElement>('[data-contador]');

      function contar(el: HTMLElement) {
        const fin = Number(el.dataset.contador ?? '0');
        const sufijo = el.dataset.sufijo ?? '';
        const decimales = (el.dataset.contador ?? '').split('.')[1]?.length ?? 0;
        if (reduce) {
          el.textContent = fin.toFixed(decimales) + sufijo;
          return;
        }
        const t0 = performance.now();
        const dur = 1100;
        const paso = (t: number) => {
          const p = Math.min(1, (t - t0) / dur);
          const e = 1 - Math.pow(1 - p, 3);
          el.textContent = (fin * e).toFixed(decimales) + sufijo;
          if (p < 1) requestAnimationFrame(paso);
        };
        requestAnimationFrame(paso);
      }

      if (!('IntersectionObserver' in window) || reduce) {
        reveals.forEach((e) => e.classList.add('es-visible'));
        contadores.forEach(contar);
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const en of entries) {
              if (!en.isIntersecting) continue;
              const el = en.target as HTMLElement;
              if (el.hasAttribute('data-reveal')) el.classList.add('es-visible');
              if (el.hasAttribute('data-contador')) contar(el);
              io.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.15 },
        );
        reveals.forEach((e) => io.observe(e));
        contadores.forEach((e) => io.observe(e));
      }
    </script>
  </body>
</html>

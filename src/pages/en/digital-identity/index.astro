---
import Base from '../../../layouts/Base.astro';
import HeroFoto from '../../../components/HeroFoto.astro';
import Icono from '../../../components/Icono.astro';
import Boton from '../../../components/Boton.astro';
import Cta from '../../../components/Cta.astro';
import FaqSchema from '../../../components/FaqSchema.astro';
import { hrefEn as href } from '../../../lib/site';

const faq = [
  {
    "pregunta": "Is this a product you sell me?",
    "respuesta": "No. It is consultancy and bespoke development on open standards, so you can decide with sound judgement and not depend on a single vendor."
  },
  {
    "pregunta": "Do I have to wait for the European wallet to get started?",
    "respuesta": "No. You can design processes, sign and verify identity today, and issue credentials using the same standards the wallet will use."
  },
  {
    "pregunta": "Does a verifiable credential replace the electronic signature?",
    "respuesta": "No, they complement each other. The credential proves a piece of data; the signature proves intent and the integrity of a document."
  },
  {
    "pregunta": "What is the difference between simple, advanced and qualified electronic signatures?",
    "respuesta": "The level of assurance about who is signing. A qualified signature has the same legal effect as a handwritten one."
  },
  {
    "pregunta": "How do I stop a supplier's bank account being changed by email?",
    "respuesta": "By verifying bank account ownership before the first payment and on every change. It can be automated in your payment flow."
  },
  {
    "pregunta": "How does it fit with GDPR?",
    "respuesta": "Well designed, it reduces the data that is shared and stored. We review it case by case with your data protection officer."
  }
] as const;
---

<Base
  title="Digital identity and verifiable credentials"
  description="Digital identity for businesses: electronic signature, customer verification and verifiable credentials. Preparation for the European digital identity wallet (eIDAS 2)."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>Digital identity</p>
        <h1
          class="mt-7 max-w-[20ch] font-display text-[clamp(32px,4.2vw,54px)] font-extralight leading-[1.06] tracking-[-0.035em]"
          data-reveal
        >
          Let your customers, students and citizens prove <span class="font-semibold text-oro-oscuro">who they are</span> without handing over all their data.
        </h1>
        <p class="mt-8 max-w-[52ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
          We help you understand, plan and build verifiable digital identity: signatures, customer verification and credentials, with technical and legal judgement.
        </p>
        <div class="mt-12 flex flex-wrap gap-4" data-reveal>
          <Boton href={href('/contacto/')}>Book a free assessment</Boton>
          <Boton href="#casos" variante="linea">See use cases</Boton>
        </div>
      </div>
      <HeroFoto foto="despachos" alt="Professionals reviewing documents in an office" class="lg:col-span-5" />
    </div>
  </section>

  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">What it is for</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Three everyday questions: who signs, who is who, and who gets paid
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="propuesta" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Sign and contract</h3>
          <p class="mt-3 text-[15px] text-pizarra">Legally valid electronic signature built into your workflow: quotes, contracts and customer onboarding. No printing, no waiting.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="medir" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Onboard customers and suppliers</h3>
          <p class="mt-3 text-[15px] text-pizarra">Onboarding with identity verification and document checks, so you know who is on the other side before you contract or pay.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="integracion" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Verify an IBAN change</h3>
          <p class="mt-3 text-[15px] text-pizarra">Check bank account ownership before the first payment and on every change, so a fake email cannot divert a transfer.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">What it is, in three lines</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Self-sovereign identity, verifiable credentials and the European wallet
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Self-sovereign identity (SSI)</h3>
          <p class="mt-3 text-[15px] text-pizarra">People keep their own credentials and decide what to show and to whom, without relying on a central database.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Verifiable credential</h3>
          <p class="mt-3 text-[15px] text-pizarra">A signed digital document (degree, licence, certificate) that anyone can check instantly, using open standards such as W3C VC and OpenID4VC.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">European digital identity wallet (EUDI Wallet)</h3>
          <p class="mt-3 text-[15px] text-pizarra">The app provided for by Regulation (EU) 2024/1183, known as eIDAS 2, to identify yourself, sign and share accredited documents from your phone.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">What we do</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Knowledge, consulting and development
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="formacion" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Knowledge</h3>
          <p class="mt-3 text-[15px] text-pizarra">What eIDAS 2 requires of your organisation if you issue, accept or manage credentials; the standards (W3C VC, OpenID4VC, decentralised identifiers) and how mature they really are; training for management, IT and legal with examples from your sector.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="diagnostico" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Consulting</h3>
          <p class="mt-3 text-[15px] text-pizarra">A map of the points where your company relies on an identity (onboarding, payments, signatures, access) and what to verify at each one; design of the trust model; a roadmap to prepare for the European wallet, with risks and how it fits with security and data protection.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="integracion" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Development</h3>
          <p class="mt-3 text-[15px] text-pizarra">Integration of signatures, identity and document verification, and credential issuing and checking, into your CRM, ERP, website or academic management system; working prototypes to validate with real users before investing more.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="casos" class="hairline scroll-mt-24">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Use cases</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Where digital identity makes a difference
        </h2>
      </div>
      <ul class="mt-14 grid gap-4 md:grid-cols-2" role="list">
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Signing documents and contracts with legal validity, with no paper and no intermediaries.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Customer onboarding in banking, health or regulated services with reusable attributes and fewer ID copies.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>A supplier's IBAN change: ownership checked before you pay.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Academic degrees issued as credentials and presented to an employer without paper.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Supplier accreditation: showing you are up to date or certified without resending documents for every tender or onboarding.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Document verification: checking in seconds that a certificate, power of attorney or report is authentic and has not been altered.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Dealings with public administration, sharing only the data the procedure needs.</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">How we work</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          From knowing where it helps you to having it running
        </h2>
      </div>
      <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">01</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Assessment</h3>
          <p class="mt-3 text-[15px] text-pizarra">Processes, documents and obligations; what is worth verifying digitally first.</p>
        </li>
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">02</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Design</h3>
          <p class="mt-3 text-[15px] text-pizarra">Trust model, standards and architecture, validated with IT and legal.</p>
        </li>
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">03</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Prototype</h3>
          <p class="mt-3 text-[15px] text-pizarra">A focused case tested with real users before scaling.</p>
        </li>
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">04</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Integration and handover</h3>
          <p class="mt-3 text-[15px] text-pizarra">Connection to your systems, documentation and training.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Who it is for</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Organisations that need to know who they are dealing with
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Companies in regulated sectors</h3>
          <p class="mt-3 text-[15px] text-pizarra">Finance, health and services: less friction and risk in onboarding, contracts and suppliers.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Universities and training centres</h3>
          <p class="mt-3 text-[15px] text-pizarra">Verifiable academic credentials, from degrees to micro-credentials.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Public administration</h3>
          <p class="mt-3 text-[15px] text-pizarra">Preparation to accept or issue identity and credentials under eIDAS 2.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Líneas relacionadas -->
  <section class="hairline">
    <div class="wrap py-16 md:py-20">
      <p class="eyebrow" data-reveal>Related areas</p>
      <div class="mt-8 flex flex-wrap gap-4" data-reveal>
        <Boton href={href('/ciberseguridad/')} variante="linea">Cybersecurity →</Boton>
        <Boton href={href('/espacios-de-datos/')} variante="linea">Data spaces →</Boton>
        <Boton href={href('/inteligencia-artificial/')} variante="linea">Artificial intelligence →</Boton>
        <Boton href={href('/sectores/administracion/')} variante="linea">Public administration sector →</Boton>
        <Boton href={href('/sectores/formacion/')} variante="linea">Education sector →</Boton>
      </div>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="hairline">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Frequently asked questions</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          What we are asked most before getting started
        </h2>
      </div>

      <div class="md:col-span-7" data-reveal>
        {
          faq.map((f) => (
            <details class="group border-t border-linea py-5 last:border-b">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[17px] font-semibold marker:content-none">
                {f.pregunta}
                <span class="mt-1 shrink-0 font-mono text-[14px] text-oro-oscuro transition-transform duration-200 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-[62ch] text-[15px] text-pizarra">{f.respuesta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Cta
    titulo="Start by finding out where digital identity helps you."
    texto="A short assessment to identify your use cases, your obligations and a realistic first step."
    boton="Book a free assessment"
  />
  <FaqSchema faq={faq} />
</Base>

---
import Base from '../../../layouts/Base.astro';
import HeroFoto from '../../../components/HeroFoto.astro';
import { hrefEn as href } from '../../../lib/site';
import { proyectosEnCurso } from '../../../data/proyectos-en-curso.en';
---

<Base
  title="Ongoing projects"
  description="Real projects under way with clients, within ACCIÓ's Cupó IA. Client, year, scope and what we are doing now."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>Ongoing projects</p>
        <h1
          class="mt-7 max-w-[20ch] font-display text-[clamp(36px,4.6vw,60px)] font-extralight leading-[1.04] tracking-[-0.035em]"
          data-reveal
        >
          What we are <span class="font-semibold text-oro-oscuro">working on right now</span>, with each client's name.
        </h1>
        <p class="mt-8 max-w-[58ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
          These projects are under way, not closed. That is why we do not publish result figures yet: only which
          company, in which sector, and what we are doing now. When they finish, they move to
          <a href={href('/historias-de-exito/')} class="text-oro-oscuro hover:underline">success stories</a>, with verified
          results.
        </p>
      </div>
      <HeroFoto foto="campus" alt="People walking between office buildings" tamanos={[1600]} class="lg:col-span-5" />
    </div>
  </section>

  <!-- Lista de proyectos -->
  <section class="hairline">
    <div class="wrap py-8 md:py-12">
      <ol role="list">
        {
          proyectosEnCurso.map((p) => (
            <li class="border-b border-linea py-10 last:border-b-0 md:py-14" data-reveal>
              <div class="grid gap-4 md:grid-cols-12 md:gap-10">
                <div class="md:col-span-4">
                  <h2 class="font-display text-[22px] font-semibold leading-[1.2]">{p.cliente}</h2>
                  <p class="mt-2 font-mono text-[12px] uppercase tracking-[0.14em] text-pizarra">
                    {p.ambito} · {p.anio}
                  </p>
                </div>
                <div class="md:col-span-8">
                  <p class="text-[16px] leading-[1.6] text-pizarra">{p.queHacemos}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Acreditación -->
  <section class="hairline bg-panel">
    <div class="wrap py-16">
      <p class="max-w-[60ch] text-[14px] leading-[1.7] text-pizarra">
        Projects delivered as an accredited provider of ACCIÓ's <b class="text-tinta">Cupó IA</b> (Government of
        Catalonia). Invoiced by Next Gen Academy SL, tax ID B44861649.
      </p>
    </div>
  </section>
</Base>

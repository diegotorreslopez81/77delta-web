---
import Base from '../../../layouts/Base.astro';
import HeroFoto from '../../../components/HeroFoto.astro';
import Icono from '../../../components/Icono.astro';
import Boton from '../../../components/Boton.astro';
import Cta from '../../../components/Cta.astro';
import FaqSchema from '../../../components/FaqSchema.astro';
import { hrefCa as href } from '../../../lib/site';

const faq = [
  {
    "pregunta": "Això és un producte que em veneu?",
    "respuesta": "No. És consultoria i desenvolupament a mida sobre estàndards oberts, per decidir amb criteri i no dependre d’un proveïdor concret."
  },
  {
    "pregunta": "He d’esperar la cartera europea per començar?",
    "respuesta": "No. Pots dissenyar processos, signar i verificar identitat avui, i emetre credencials amb els mateixos estàndards que farà servir la cartera."
  },
  {
    "pregunta": "Una credencial verificable substitueix la signatura electrònica?",
    "respuesta": "No, es complementen. La credencial prova una dada; la signatura prova voluntat i integritat d’un document."
  },
  {
    "pregunta": "Quina diferència hi ha entre signatura electrònica simple, avançada i qualificada?",
    "respuesta": "El nivell de garantia sobre qui signa. La qualificada té el mateix efecte legal que la signatura manuscrita."
  },
  {
    "pregunta": "Com evito que em canviïn el compte bancari d’un proveïdor per correu?",
    "respuesta": "Verificant la titularitat del compte abans del primer pagament i davant de cada canvi. Es pot automatitzar al teu flux de pagaments."
  },
  {
    "pregunta": "Com encaixa amb el RGPD?",
    "respuesta": "Ben dissenyada, redueix les dades que es comparteixen i es conserven. Es revisa cas per cas amb el teu responsable de protecció de dades."
  }
] as const;
---

<Base
  title="Identitat digital i credencials verificables"
  description="Identitat digital per a empreses: signatura electrònica, verificació de clients i credencials verificables. Preparació per a la cartera europea (eIDAS 2)."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>Identitat digital</p>
        <h1
          class="mt-7 max-w-[20ch] font-display text-[clamp(32px,4.2vw,54px)] font-extralight leading-[1.06] tracking-[-0.035em]"
          data-reveal
        >
          Que els teus clients, alumnes i ciutadans demostrin <span class="font-semibold text-oro-oscuro">qui són</span> sense lliurar totes les seves dades.
        </h1>
        <p class="mt-8 max-w-[52ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
          T’ajudem a entendre, planificar i construir identitat digital verificable: signatura, verificació de clients i credencials, amb criteri tècnic i legal.
        </p>
        <div class="mt-12 flex flex-wrap gap-4" data-reveal>
          <Boton href={href('/contacto/')}>Reservar diagnòstic</Boton>
          <Boton href="#casos" variante="linea">Veure casos d’aplicació</Boton>
        </div>
      </div>
      <HeroFoto foto="despachos" alt="Professionals revisant documents en un despatx" class="lg:col-span-5" />
    </div>
  </section>

  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Per a què serveix</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Tres preguntes de cada dia: qui signa, qui és i qui cobra
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="propuesta" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Signar i contractar</h3>
          <p class="mt-3 text-[15px] text-pizarra">Signatura electrònica amb validesa legal integrada al teu flux: pressupostos, contractes i altes de client. Sense imprimir, sense esperar.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="medir" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Donar d’alta clients i proveïdors</h3>
          <p class="mt-3 text-[15px] text-pizarra">Alta amb verificació d’identitat i comprovació de documents, per saber qui hi ha a l’altra banda abans de contractar o de pagar.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="integracion" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Verificar un canvi d’IBAN</h3>
          <p class="mt-3 text-[15px] text-pizarra">Comprovar la titularitat del compte abans del primer pagament i davant de cada canvi, perquè un correu fals no desviï una transferència.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Què és, en tres línies</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Identitat autosobirana, credencials verificables i cartera europea
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Identitat autosobirana (SSI)</h3>
          <p class="mt-3 text-[15px] text-pizarra">La persona guarda les seves credencials i decideix què ensenya i a qui, sense dependre d’una base de dades central.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Credencial verificable</h3>
          <p class="mt-3 text-[15px] text-pizarra">Document digital signat (títol, llicència, certificat) que qualsevol pot comprovar a l’instant, amb estàndards oberts com W3C VC i OpenID4VC.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Cartera europea d’identitat digital (EUDI Wallet)</h3>
          <p class="mt-3 text-[15px] text-pizarra">L’aplicació que preveu el Reglament (UE) 2024/1183, conegut com a eIDAS 2, per identificar-se, signar i compartir documents acreditats des del mòbil.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Què fem</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Coneixement, consultoria i desenvolupament
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="formacion" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Coneixement</h3>
          <p class="mt-3 text-[15px] text-pizarra">Què exigeix eIDAS 2 a la teva organització si emets, acceptes o gestiones credencials; estàndards (W3C VC, OpenID4VC, identificadors descentralitzats) i la seva maduresa real; formació a direcció, IT i jurídic amb exemples del teu sector.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="diagnostico" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Consultoria</h3>
          <p class="mt-3 text-[15px] text-pizarra">Mapa dels punts on la teva empresa confia en una identitat (altes, pagaments, signatures, accessos) i què verificar en cadascun; disseny del model de confiança; full de ruta de preparació per a la cartera europea, amb riscos i encaix amb seguretat i protecció de dades.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="integracion" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Desenvolupament</h3>
          <p class="mt-3 text-[15px] text-pizarra">Integració de signatura, verificació d’identitat i de documents, i emissió i verificació de credencials, al teu CRM, ERP, web o gestió acadèmica; prototips funcionals per validar amb usuaris reals abans d’invertir més.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="casos" class="hairline scroll-mt-24">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Casos d’aplicació</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          On es nota la identitat digital
        </h2>
      </div>
      <ul class="mt-14 grid gap-4 md:grid-cols-2" role="list">
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Signatura de documents i contractes amb validesa legal, sense paper i sense intermediaris.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Alta de clients en banca, salut o serveis regulats amb atributs reutilitzables i menys còpies de DNI.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Canvi d’IBAN d’un proveïdor: titularitat comprovada abans de pagar.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Títols acadèmics emesos com a credencial i presentats a una empresa sense paper.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Acreditació de proveïdors: demostrar que s’està al corrent o certificat sense reenviar documents a cada licitació o alta.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Verificació de documents: comprovar en segons que un certificat, poder o informe és autèntic i no s’ha alterat.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Tràmits amb l’administració compartint només la dada que el tràmit necessita.</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Com treballem</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          De saber on et serveix a tenir-ho funcionant
        </h2>
      </div>
      <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">01</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Diagnòstic</h3>
          <p class="mt-3 text-[15px] text-pizarra">Processos, documents i obligacions; què convé verificar digitalment primer.</p>
        </li>
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">02</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Disseny</h3>
          <p class="mt-3 text-[15px] text-pizarra">Model de confiança, estàndards i arquitectura, validats amb IT i jurídic.</p>
        </li>
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">03</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Prototip</h3>
          <p class="mt-3 text-[15px] text-pizarra">Cas acotat provat amb usuaris reals abans d’escalar.</p>
        </li>
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">04</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Integració i traspàs</h3>
          <p class="mt-3 text-[15px] text-pizarra">Connexió als teus sistemes, documentació i formació.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Per a qui</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Organitzacions que necessiten saber amb qui tracten
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Empreses de sectors regulats</h3>
          <p class="mt-3 text-[15px] text-pizarra">Finances, salut i serveis: menys fricció i risc en altes, contractes i proveïdors.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Universitats i centres de formació</h3>
          <p class="mt-3 text-[15px] text-pizarra">Credencials acadèmiques verificables, de títols a microcredencials.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Administració pública</h3>
          <p class="mt-3 text-[15px] text-pizarra">Preparació per acceptar o emetre identitat i credencials en el marc d’eIDAS 2.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Líneas relacionadas -->
  <section class="hairline">
    <div class="wrap py-16 md:py-20">
      <p class="eyebrow" data-reveal>Línies relacionades</p>
      <div class="mt-8 flex flex-wrap gap-4" data-reveal>
        <Boton href={href('/ciberseguretat/')} variante="linea">Ciberseguretat →</Boton>
        <Boton href={href('/espais-de-dades/')} variante="linea">Espais de dades →</Boton>
        <Boton href={href('/intel-ligencia-artificial/')} variante="linea">Intel·ligència artificial →</Boton>
        <Boton href={href('/sectores/administracion/')} variante="linea">Sector administració →</Boton>
        <Boton href={href('/sectores/formacion/')} variante="linea">Sector formació →</Boton>
      </div>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="hairline">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Preguntes freqüents</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          El que més ens pregunten abans de començar
        </h2>
      </div>

      <div class="md:col-span-7" data-reveal>
        {
          faq.map((f) => (
            <details class="group border-t border-linea py-5 last:border-b">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[17px] font-semibold marker:content-none">
                {f.pregunta}
                <span class="mt-1 shrink-0 font-mono text-[14px] text-oro-oscuro transition-transform duration-200 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-[62ch] text-[15px] text-pizarra">{f.respuesta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Cta
    titulo="Comença per saber on et serveix la identitat digital."
    texto="Un diagnòstic breu per identificar els teus casos d’ús, les teves obligacions i un primer pas realista."
    boton="Reservar diagnòstic"
  />
  <FaqSchema faq={faq} />
</Base>

    citaN: 'Diego Torres · Fundador i director tècnic',
    dato: '+500',
    datoT: 'startups mentoritzades pel nostre fundador',
    diegoAlt: 'Diego Torres, fundador de 77 Delta',
    rolesE: '04 · Troba el teu lloc',
    roles: 'Dues maneres de començar.',
    tec: 'Ets tècnic?',
    tecP: 'Desenvolupament, dades i IA. Tenim un procés propi, pensat per treballar amb el teu agent.',
    tecB: 'Veure el procés tècnic',
    tecAlt: 'Desenvolupadors treballant junts en equip',
    otro: 'Un altre rol',
    otroP: 'Màrqueting, gestió de projectes, formació. Escriu-nos amb el teu CV i l’enllaç al teu LinkedIn.',
    otroAlt: 'Persones treballant juntes amb portàtils',
    roles_: ['Màrqueting', 'Gestió de projectes', 'Formació'],
    asunto: 'Candidatura',
    cuerpo: 'Hola,\n\nAdjunto el meu CV.\nLinkedIn: \n\nUna salutació.',
    ctaT: 'No veus el teu rol? Explica’ns què saps fer.',
    ctaX: 'Escriu-nos amb el teu CV i el teu LinkedIn. Llegim totes les candidatures.',
    ctaB: 'Enviar candidatura',
    gdpr: 'Responsable: Next Gen Academy SL (77 Delta). Fem servir les teves dades només per valorar la teva candidatura. Esborrament: hola@77delta.com.',
    dev: '/ca/treballa-amb-nosaltres/developer/',
  },
}[idioma];

const rutas = { es: '/trabaja-con-nosotros/', en: '/en/work-with-us/', ca: '/ca/treballa-amb-nosaltres/' };
const lang = idioma === 'en' ? 'en' : undefined;
const alternates =
  idioma === 'en'
    ? [
        { hreflang: 'es', href: rutas.es },
        { hreflang: 'ca', href: rutas.ca },
        { hreflang: 'en', href: rutas.en },
      ]
    : undefined;
const mailtoGeneral = `mailto:${MAIL}?subject=${encodeURIComponent(t.asunto)}&body=${encodeURIComponent(t.cuerpo)}`;
const mailto = (rol: string) =>
  `mailto:${MAIL}?subject=${encodeURIComponent(`${t.asunto} - ${rol}`)}&body=${encodeURIComponent(t.cuerpo)}`;
---

<Base title={t.title} description={t.desc} noindex={true} lang={lang} alternates={alternates} selectorIdioma={false}>
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>{t.eyebrow}</p>
        <h1 class="mt-7 max-w-[16ch] font-display text-[clamp(36px,4.6vw,60px)] font-extralight leading-[1.04] tracking-[-0.035em]" data-reveal>{t.h1}</h1>
        <p class="mt-8 max-w-[52ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>{t.p}</p>
        <div class="mt-10 flex flex-wrap gap-3" data-reveal>
          <Boton href="#como">{t.cta1}</Boton>
        </div>
      </div>
      <HeroFoto foto="equipo" alt={t.heroAlt} class="lg:col-span-5" />
    </div>
  </section>

  <section class="hairline">
    <div class="wrap grid items-center gap-12 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-6" data-reveal>
        <p class="eyebrow">{t.quienesE}</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">{t.quienes}</h2>
        <div class="mt-8 space-y-5 text-[17px] text-pizarra">{t.quienesP.map((x) => <p>{x}</p>)}</div>
      </div>
      <div class="md:col-span-6" data-reveal>
        <img src="/img/fotos/diagnostico-1600.webp" srcset="/img/fotos/diagnostico-900.webp 900w, /img/fotos/diagnostico-1600.webp 1600w" sizes="(min-width: 768px) 45vw, 100vw" alt={t.quienesAlt} loading="lazy" decoding="async" class="aspect-[5/4] w-full rounded-[20px] object-cover shadow-[0_30px_80px_rgba(10,22,40,.18)]" />
      </div>
    </div>
  </section>

  <section id="como" class="hairline bg-panel scroll-mt-20">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">{t.comoE}</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">{t.como}</h2>
      </div>
      <ul class="mt-16 grid gap-x-12 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          t.items.map(([ic, a, b]) => (
            <li class="border-t border-linea pt-6" data-reveal>
              <span class="flex h-12 w-12 items-center justify-center rounded-[12px] border border-linea bg-marfil text-oro-oscuro"><Icono nombre={ic as any} class="h-6 w-6" /></span>
              <h3 class="mt-5 font-display text-[20px] font-semibold">{a}</h3>
              <p class="mt-3 text-[16px] text-pizarra">{b}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="relative isolate overflow-hidden bg-marino text-marfil">
    <div class="wrap grid items-center gap-12 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-7" data-reveal>
        <p class="eyebrow !text-oro-luz">{t.culturaE}</p>
        <h2 class="mt-5 max-w-[20ch] font-display text-[clamp(28px,3.6vw,48px)] font-extralight leading-[1.1] tracking-[-0.03em]">{t.cultura}</h2>
        <p class="mt-6 max-w-[54ch] text-[17px] text-marfil/78">{t.culturaP}</p>
        <figure class="mt-10 max-w-[54ch] border-l border-oro-luz pl-6">
          <blockquote class="font-display text-[clamp(20px,2.2vw,26px)] font-extralight leading-[1.25] tracking-[-0.02em]">{t.citaP}</blockquote>
          <figcaption class="mt-4 font-mono text-[12px] uppercase tracking-[0.14em] text-marfil/70">{t.citaN}</figcaption>
        </figure>
      </div>
      <div class="md:col-span-5" data-reveal>
        <Image src={diego} width={720} format="webp" alt={t.diegoAlt} loading="lazy" class="w-full max-w-[360px] rounded-[16px] border border-marfil/15 object-cover" />
        <p class="mt-8 font-display text-[clamp(44px,6vw,76px)] font-extralight leading-none tracking-[-0.03em] text-oro-luz">{t.dato}</p>
        <p class="mt-2 text-[15px] text-marfil/78">{t.datoT}</p>
      </div>
    </div>
  </section>

  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">{t.rolesE}</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">{t.roles}</h2>
      </div>
      <div class="mt-16 grid gap-8 md:grid-cols-2">
        <article class="overflow-hidden rounded-[20px] border border-linea bg-panel" data-reveal>
          <img src="/img/fotos/gerente-900.webp" alt={t.tecAlt} loading="lazy" decoding="async" class="aspect-[16/9] w-full object-cover" />
          <div class="p-8 md:p-10">
            <span class="flex h-12 w-12 items-center justify-center rounded-[12px] border border-linea bg-marfil text-oro-oscuro"><Icono nombre="produccion" class="h-6 w-6" /></span>
            <h3 class="mt-5 font-display text-[clamp(24px,2.6vw,32px)] font-extralight tracking-[-0.02em]">{t.tec}</h3>
            <p class="mt-4 text-[17px] text-pizarra">{t.tecP}</p>
            <div class="mt-8"><Boton href={t.dev}>{t.tecB} →</Boton></div>
          </div>
        </article>
        <article class="overflow-hidden rounded-[20px] border border-linea bg-panel" data-reveal>
          <img src="/img/fotos/formacion-900.webp" alt={t.otroAlt} loading="lazy" decoding="async" class="aspect-[16/9] w-full object-cover" />
          <div class="p-8 md:p-10">
            <span class="flex h-12 w-12 items-center justify-center rounded-[12px] border border-linea bg-marfil text-oro-oscuro"><Icono nombre="partner" class="h-6 w-6" /></span>
            <h3 class="mt-5 font-display text-[clamp(24px,2.6vw,32px)] font-extralight tracking-[-0.02em]">{t.otro}</h3>
            <p class="mt-4 text-[17px] text-pizarra">{t.otroP}</p>
            <div class="mt-8 flex flex-wrap gap-3">
              {t.roles_.map((r) => <Boton href={mailto(r)} variante="linea">{r}</Boton>)}
            </div>
          </div>
        </article>
      </div>
      <p class="mt-8 max-w-[72ch] text-[14px] text-pizarra">{t.gdpr}</p>
    </div>
  </section>

  <Cta titulo={t.ctaT} texto={t.ctaX} boton={t.ctaB} enlace={mailtoGeneral} />
</Base>

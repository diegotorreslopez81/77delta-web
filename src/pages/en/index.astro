<style>
  .home{
    --paper:#F3EEE4; --white:#FAF7F0; --ink:#0A1628; --ink-2:#26354D; --ink-3:#5C6879; --ink-4:#9AA3B0;
    --accent:#A7781B; --accent-2:#8A6216; --accent-luz:#D4A03A; --accent-soft:rgba(167,120,27,.12); --accent-glow:rgba(167,120,27,.30);
    --line:rgba(10,22,40,.10); --line-strong:rgba(10,22,40,.18); --dark:#06101F; --ease:cubic-bezier(.2,.7,.2,1);
  }

  section{max-width:100%;overflow-x:clip;position:relative}
  h1,h2,h3,h4{font-family:'Sora',system-ui,sans-serif;font-weight:600;letter-spacing:-.025em;line-height:1.08}
  .cont{max-width:1280px;margin:0 auto;padding:0 32px}


  /* HERO asimétrico (texto izquierda + foto derecha) */
  .hero{min-height:min(calc(100vh - 72px),880px);padding:60px 0;position:relative;overflow:hidden;display:flex;align-items:center;background:var(--dark);color:#EDEAE3}
  .hero::before{content:"";position:absolute;top:-30%;right:-10%;width:700px;height:700px;background:radial-gradient(circle,rgba(167,120,27,.16),transparent 60%);filter:blur(70px);pointer-events:none}
  .hero .cont{position:relative;z-index:1}
  .hero .cont{width:100%;position:relative;z-index:1}
  .hero .grid{display:grid;grid-template-columns:6fr 6fr;gap:64px;align-items:center}
  .hero .pill{display:inline-flex;align-items:center;gap:10px;padding:8px 16px;border:1px solid rgba(237,234,227,.22);background:rgba(237,234,227,.07);border-radius:100px;font-family:'IBM Plex Sans',system-ui,sans-serif;font-size:13px;color:rgba(237,234,227,.88);margin-bottom:28px;font-weight:500;white-space:nowrap}
  .hero .pill .sep{color:rgba(237,234,227,.45);margin:0 2px}
  .hero .pill .claude{width:15px;height:15px;color:#D97757;flex-shrink:0}
  .hero .pill .badge{width:8px;height:8px;background:var(--accent);border-radius:50%;box-shadow:0 0 12px var(--accent-glow),0 0 4px var(--accent)}
  .hero h1{font-size:clamp(36px,4.2vw,58px);font-weight:600;letter-spacing:-.03em;margin-bottom:28px;color:#EDEAE3}
  .hero h1 em{font-style:normal;color:var(--accent-luz);font-weight:700}
  .hero .lead{font-size:19px;color:rgba(237,234,227,.78);margin-bottom:36px;line-height:1.5}
  .hero .ctas{display:flex;gap:12px;flex-wrap:wrap}
  .btn-primary{background:var(--accent);color:#EDEAE3;padding:15px 26px;border-radius:10px;font-weight:600;font-size:15px;display:inline-flex;align-items:center;gap:10px;transition:background .2s,transform .2s,box-shadow .2s;box-shadow:0 6px 24px var(--accent-glow)}
  .btn-primary:hover{background:var(--ink);color:#EDEAE3;transform:translateY(-1px);box-shadow:0 12px 32px rgba(10,22,40,.25)}
  .hero .btn-primary:hover{background:#EDEAE3;color:var(--ink);box-shadow:0 12px 32px rgba(0,0,0,.35)}
  .btn-ghost{background:transparent;color:#EDEAE3;padding:15px 26px;border-radius:10px;font-weight:600;font-size:15px;border:1px solid rgba(237,234,227,.3);transition:background .2s,border-color .2s}
  .btn-ghost:hover{background:rgba(237,234,227,.1);border-color:#EDEAE3}
  .hero .photo{aspect-ratio:5/4;border-radius:20px;overflow:hidden;background:#E0D9CB;position:relative;box-shadow:0 30px 80px rgba(0,0,0,.45)}
  .hero .photo img{width:100%;height:100%;object-fit:cover}
  .hero .photo .tag{position:absolute;bottom:24px;left:24px;background:rgba(10,22,40,.78);backdrop-filter:blur(20px);color:#EDEAE3;padding:10px 16px;border-radius:100px;font-size:12px;font-weight:600;letter-spacing:.05em;text-transform:uppercase}


  /* Seguridad de IA */
  .aisec{padding:140px 0;background:var(--dark);color:#EDEAE3}
  .aisec::before{content:"";position:absolute;top:-20%;left:-8%;width:620px;height:620px;background:radial-gradient(circle,rgba(167,120,27,.14),transparent 62%);filter:blur(70px);pointer-events:none}
  .aisec .cont{position:relative;z-index:1}
  .aisec-grid{display:grid;grid-template-columns:7fr 5fr;gap:72px;align-items:center}
  .aisec .section-tag{color:var(--accent-luz)}
  .aisec h2{font-size:clamp(30px,3.6vw,46px);font-weight:200;letter-spacing:-.03em;margin-bottom:24px;color:#EDEAE3}
  .aisec h2 em{font-style:normal;font-weight:600;color:var(--accent-luz)}
  .aisec p{font-size:17px;line-height:1.6;color:rgba(237,234,227,.72);margin-bottom:18px;max-width:56ch}
  .aisec .aisec-nota{font-size:15px;color:rgba(237,234,227,.55)}
  .aisec-enlace{color:var(--accent-luz);font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:12px;letter-spacing:.04em}
  .aisec-enlace:hover{color:#EDEAE3}
  .aisec .ctas{display:flex;gap:12px;flex-wrap:wrap;margin-top:32px}
  .aisec .btn-primary:hover{background:#EDEAE3;color:var(--ink);box-shadow:0 12px 32px rgba(0,0,0,.35)}
  .aisec-informe{border:1px solid rgba(237,234,227,.14);background:rgba(237,234,227,.04);border-radius:14px;padding:26px 24px}
  .aisec-informe-cab{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-bottom:16px;border-bottom:1px solid rgba(237,234,227,.12);font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(237,234,227,.8)}
  .aisec-ejemplo{color:rgba(237,234,227,.45)}
  .aisec-informe ul{list-style:none;margin:6px 0 0}
  .aisec-informe li{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px solid rgba(237,234,227,.08)}
  .aisec-informe li .q{font-size:14px;color:rgba(237,234,227,.86)}
  .aisec-informe li .s{flex-shrink:0;font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:10px;letter-spacing:.12em;text-transform:uppercase;padding:5px 10px;border-radius:100px;border:1px solid}
  .aisec-informe li .s1{color:rgba(237,234,227,.6);border-color:rgba(237,234,227,.22)}
  .aisec-informe li .s2{color:var(--accent-luz);border-color:rgba(212,160,58,.4)}
  .aisec-informe li .s3{color:#06101F;background:var(--accent-luz);border-color:var(--accent-luz);font-weight:700}
  .aisec-pie{font-size:12px;line-height:1.6;color:rgba(237,234,227,.45);margin:18px 0 0}


  /* Capacidades */
  .caps{padding:140px 0;background:var(--white);border-top:1px solid var(--line)}
  .caps-grid{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:4px;overflow:hidden;margin-top:56px}
  .caps-grid li{background:var(--paper)}
  .caps-grid a{display:flex;flex-direction:column;height:100%;padding:28px 24px;transition:background .2s}
  .caps-grid a:hover{background:rgba(167,120,27,.06)}
  .caps-grid .num{font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:11px;letter-spacing:.14em;color:var(--accent-2)}
  .caps-grid h3{font-size:17px;font-weight:600;margin:12px 0 10px;line-height:1.25;color:var(--ink)}
  .caps-grid p{font-size:14px;line-height:1.55;color:var(--ink-3);flex:1;margin:0}
  .caps-grid .cuenta{margin-top:18px;font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-4)}
  .caps-link{display:inline-flex;align-items:center;gap:10px;margin-top:36px;font-family:'Sora',system-ui,sans-serif;font-size:15px;font-weight:600;color:var(--accent-2)}
  .caps-link:hover{color:var(--ink)}


  /* Prueba social bajo el hero */
  .proof{padding:40px 0 44px;background:var(--dark);border-top:1px solid rgba(237,234,227,.08)}
  .proof-txt{font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:rgba(237,234,227,.45);text-align:center;margin-bottom:26px}
  .proof-logos{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:22px 44px}
  .proof-logos img{height:26px;width:auto;max-width:130px;object-fit:contain;filter:brightness(0) invert(1);opacity:.5;transition:opacity .2s}
  .proof-logos a:hover img{opacity:.95}
  .proof-mas{display:block;text-align:center;margin-top:26px;font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:11px;letter-spacing:.1em;color:rgba(237,234,227,.4)}
  .proof-mas:hover{color:var(--accent-luz)}

  .trust{padding:80px 0 100px;background:var(--paper);border-top:1px solid var(--line)}
  .trust .header{text-align:center;margin-bottom:48px}
  .trust .header .section-tag{display:inline-block;font-size:12px;color:var(--accent);font-weight:700;letter-spacing:.14em;text-transform:uppercase;margin-bottom:14px}
  .trust .header h2{font-size:clamp(28px,3vw,40px);max-width:680px;margin:0 auto 14px}
  .trust .header p{font-size:16px;color:var(--ink-3);max-width:580px;margin:0 auto;line-height:1.5}
  .trust .logos{display:grid;grid-template-columns:repeat(6,1fr);gap:32px 24px;align-items:center;max-width:1080px;margin:0 auto}
  .trust .logo{display:flex;align-items:center;justify-content:center;padding:14px 10px;min-height:64px;text-decoration:none}
  .trust .logo img{max-height:34px;max-width:140px;width:auto;height:auto;object-fit:contain;filter:brightness(0) opacity(.5);transition:filter .25s var(--ease),transform .25s var(--ease)}
  .trust .logo.tall img{max-height:48px;max-width:90px}
  .trust .logo.wide img{max-height:28px;max-width:170px}
  .trust .logo:hover img{filter:brightness(0) opacity(.9);transform:scale(1.04)}

  /* PROBLEMA (foto izq + texto derecha) · DARK ANCHOR */
  .problem{min-height:min(100vh,880px);padding:120px 0;background:var(--white);color:var(--ink);position:relative;overflow:hidden;display:flex;align-items:center}
  .problem::before{content:"";position:absolute;top:-20%;right:-10%;width:600px;height:600px;background:radial-gradient(circle,rgba(167,120,27,.10),transparent 60%);filter:blur(60px);pointer-events:none}
  .problem .cont{position:relative;z-index:1}
  .problem .grid{display:grid;grid-template-columns:6fr 6fr;gap:80px;align-items:center}
  .problem .photo{aspect-ratio:4/5;border-radius:20px;overflow:hidden}
  .problem .photo img{width:100%;height:100%;object-fit:cover}
  .problem h2{font-size:clamp(34px,4vw,52px);margin-bottom:28px;color:var(--ink)}
  .problem h2 em{color:var(--accent);font-style:normal;font-weight:600}
  .problem .lead{font-size:18px;color:var(--ink-2);margin-bottom:24px;line-height:1.55}
  .problem .section-tag{color:var(--accent-2)}
  .problem .questions{font-size:18px;color:var(--ink-2);font-family:'Sora',system-ui,sans-serif;font-style:normal;line-height:1.5;padding:24px;background:rgba(167,120,27,.12);border-radius:14px;border-left:3px solid var(--accent);backdrop-filter:blur(20px)}

  /* SERVICIOS */
  .services{padding:140px 0}
  .section-head{margin-bottom:64px;max-width:880px}
  .section-tag{display:inline-block;font-size:12px;color:var(--accent);font-weight:700;letter-spacing:.14em;text-transform:uppercase;margin-bottom:18px}
  .section-head h2{font-size:clamp(34px,4vw,52px);margin-bottom:18px}
  .section-head p{font-size:18px;color:var(--ink-3);line-height:1.55}

  .svc-featured{position:relative;border-radius:24px;overflow:hidden;margin-bottom:20px;min-height:460px;box-shadow:0 24px 60px rgba(10,22,40,.18)}
  .svc-featured img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
  .svc-featured::before{content:"";position:absolute;inset:0;background:linear-gradient(115deg,rgba(10,22,40,.35) 0%,rgba(10,22,40,.15) 60%,transparent 100%)}
  .svc-featured .content{position:relative;padding:48px;display:flex;flex-direction:column;justify-content:flex-end;height:100%;min-height:460px}
  .svc-featured .text-panel{background:rgba(10,22,40,.48);backdrop-filter:blur(40px) saturate(180%);-webkit-backdrop-filter:blur(40px) saturate(180%);border:1px solid rgba(255,255,255,.14);border-radius:20px;padding:36px;max-width:540px;box-shadow:0 20px 60px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.08)}
  .svc-featured .badge{display:inline-flex;align-items:center;background:rgba(167,120,27,.32);backdrop-filter:blur(20px);color:#EDEAE3;padding:8px 16px;border-radius:100px;font-size:11px;font-weight:700;letter-spacing:.12em;margin-bottom:22px;width:fit-content;border:1px solid rgba(167,120,27,.55);box-shadow:0 0 20px rgba(167,120,27,.35)}
  .svc-featured h3{font-size:42px;color:#EDEAE3;margin-bottom:14px;font-weight:500;text-shadow:0 2px 16px rgba(0,0,0,.4)}
  .svc-featured p{color:rgba(255,255,255,.94);font-size:16px;margin-bottom:24px;line-height:1.55;text-shadow:0 1px 8px rgba(0,0,0,.35)}
  .svc-featured .arrow-btn{display:inline-flex;align-items:center;gap:10px;color:#EDEAE3;font-weight:600;font-size:15px;padding:14px 24px;background:var(--accent);border-radius:10px;border:1px solid rgba(255,255,255,.18);width:fit-content;transition:background .2s,transform .2s,box-shadow .2s;box-shadow:0 6px 24px rgba(167,120,27,.5)}
  .svc-featured .arrow-btn:hover{background:#EDEAE3;color:var(--ink);transform:translateY(-1px);box-shadow:0 12px 32px rgba(0,0,0,.35)}

  .svc-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
  .svc-card{background:var(--white);border:1px solid var(--line);border-radius:18px;padding:40px;transition:transform .25s var(--ease),box-shadow .25s var(--ease),border-color .25s var(--ease)}
  .svc-card:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(10,22,40,.08);border-color:var(--line-strong)}
  .svc-card .num{font-family:'Sora',system-ui,sans-serif;font-size:13px;color:var(--accent);font-weight:600;margin-bottom:24px;letter-spacing:.05em}
  .svc-card h3{font-size:24px;margin-bottom:12px}
  .svc-card p{color:var(--ink-3);font-size:15px;margin-bottom:24px;line-height:1.55}
  .svc-card .price{font-size:14px;color:var(--ink-2);font-weight:600;padding-top:20px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}
  .svc-card .price .arrow{color:var(--accent);font-size:18px}


  /* DIRECTOR DE IA (servicio principal) */
  .director{padding:0 0 140px}
  .director-panel{background:var(--dark);color:#EDEAE3;border-radius:24px;padding:64px;position:relative;overflow:hidden;box-shadow:0 24px 60px rgba(10,22,40,.18)}
  .director-panel::before{content:"";position:absolute;top:-40%;right:-10%;width:600px;height:600px;background:radial-gradient(circle,rgba(167,120,27,.18),transparent 60%);filter:blur(70px);pointer-events:none}
  .director-panel>*{position:relative;z-index:1}
  .director-head{max-width:760px}
  .director .section-tag{color:var(--accent-luz)}
  .director h2{font-size:clamp(32px,3.8vw,50px);color:#EDEAE3;margin-bottom:20px}
  .director h2 em{font-style:normal;color:var(--accent-luz);font-weight:700}
  .director .lead{font-size:18px;line-height:1.55;color:rgba(237,234,227,.78);margin:0}
  .director-paquetes{list-style:none;display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:44px 0 0;padding:0}
  .director-paquetes li{border:1px solid rgba(237,234,227,.14);background:rgba(237,234,227,.05);border-radius:14px;padding:24px;display:flex;flex-direction:column;gap:8px}
  .director-paquetes .nombre{font-family:'IBM Plex Mono',ui-monospace,monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--accent-luz)}
  .director-paquetes .precio{font-family:'Sora',system-ui,sans-serif;font-size:26px;font-weight:600;letter-spacing:-.02em;color:#EDEAE3}
  .director-paquetes .detalle{font-size:14px;line-height:1.5;color:rgba(237,234,227,.7)}
  .director-pie{display:flex;align-items:center;justify-content:space-between;gap:24px;flex-wrap:wrap;margin-top:36px;padding-top:28px;border-top:1px solid rgba(237,234,227,.12)}
  .director-pie .garantia{font-size:16px;line-height:1.5;color:rgba(237,234,227,.82);max-width:60ch;margin:0}
  .director-pie .garantia strong{color:var(--accent-luz);font-weight:600}
  .director-pie .nota{font-size:13px;line-height:1.5;color:rgba(237,234,227,.5);margin:6px 0 0}
  .director .btn-primary{flex-shrink:0}
  .director .btn-primary:hover{background:#EDEAE3;color:var(--ink);box-shadow:0 12px 32px rgba(0,0,0,.35)}

  /* SECTORES (fotos verticales con overlay) */
  .sectors{padding:140px 0;background:var(--white)}

---
import Articulo from '../../components/blog/Articulo.astro';
import { entradas } from '../../lib/blog';

export async function getStaticPaths() {
  return (await entradas('es')).map((entrada) => ({ params: { slug: entrada.id }, props: { entrada } }));
}
const { entrada } = Astro.props;
---

<Articulo entrada={entrada} idioma="es" />

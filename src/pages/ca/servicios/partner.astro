---
import GuiasRelacionadas from '../../../components/blog/GuiasRelacionadas.astro';
import Base from '../../../layouts/Base.astro';
import Boton from '../../../components/Boton.astro';
import Cta from '../../../components/Cta.astro';
import { hrefCa as href } from '../../../lib/site';
import { paquetes, ritmo, cadaMes, resumen } from '../../../data/servicios.ca';
import { ambitosCa as ambitos } from '../../../data/partner';

const otros = resumen.filter((r) => r.titulo !== 'Soci tecnològic');
---

<Base
  title="Soci tecnològic"
  description="Soci tècnic per a tota la teva tecnologia, no només la IA: programari a mida, CRM i ERP, entorn Microsoft, Java, maquinari, infraestructura i R+D. Revisió de proveïdors, interlocució tècnica i full de ruta trimestral. Tres paquets des de 1.000 € al mes."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <p class="eyebrow" data-reveal>
      <a href={href('/servicios/')} class="transition-colors hover:text-tinta">Serveis</a> · 03 · Acompanyament continu
    </p>
    <h1
      class="mt-7 max-w-[19ch] font-display text-[clamp(38px,6vw,76px)] font-extralight leading-[1.04] tracking-[-0.035em]"
      data-reveal
    >
      Un soci tècnic per a tota la teva tecnologia, <span class="font-semibold text-oro-oscuro">no només per a la IA</span>.
    </h1>
    <p class="mt-8 max-w-[54ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
      Programari a mida, CRM i ERP, entorn Microsoft, Java, maquinari, infraestructura, R+D. Revisem el que et
      proposen, parlem amb els teus proveïdors de tu a tu i decidim amb tu on va cada euro de tecnologia.
    </p>

    <div class="mt-14 flex flex-wrap items-center gap-8" data-reveal>
      <div class="rounded-[4px] border border-linea bg-panel px-8 py-6">
        <p class="font-display text-[30px] font-extralight leading-none tracking-[-0.03em] text-oro-oscuro">
          Des de 1.000 €/mes
        </p>
        <p class="mt-3 max-w-[34ch] font-mono text-[12px] leading-[1.6] text-pizarra">
          Tres paquets amb descompte per volum · revisió trimestral
        </p>
      </div>
      <Boton href={href('/contacto/')}>Sol·licitar proposta →</Boton>
    </div>
  </section>

  <!-- Per a qui -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-12 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Per a qui és</p>
        <h2 class="mt-5 font-display text-[clamp(26px,3.2vw,38px)] font-extralight leading-[1.15] tracking-[-0.03em]">
          Per a qui no té un director de tecnologia en nòmina.
        </h2>
      </div>
      <div class="md:col-span-7 md:pl-6" data-reveal>
        <p class="text-[17px] text-pizarra">
          Per a empreses amb tecnologia de diversos proveïdors i ningú a dins que la governi: l’ERP d’un, el CRM
          d’un altre, el web d’una agència, les màquines amb el seu propi programari. Posem un responsable tècnic
          al teu costat per molt menys del que costa un CTO en plantilla. Si el que necessites és només IA, el
          servei és el <a href={href('/servicios/director-ia/')} class="font-medium text-tinta underline decoration-oro/60 underline-offset-4 transition-colors hover:text-oro-oscuro">Director d’IA extern</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Què cobrim -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Què cobrim</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Tota la tecnologia de l’empresa, amb un sol interlocutor.
        </h2>
      </div>
      <ul class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3" role="list">
        {
          ambitos.map((a) => (
            <li class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-pizarra">{a.n}</span>
              <h3 class="mt-3 font-display text-[20px] font-semibold leading-[1.3]">{a.titulo}</h3>
              <p class="mt-3 flex-1 text-[15px] text-pizarra">{a.texto}</p>
              {a.enlace && (
                <a href={href(a.enlace.ruta)} class="mt-6 font-mono text-[12px] text-tinta/80 transition-colors hover:text-oro-oscuro">
                  {a.enlace.texto} →
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Paquets -->
  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Tres paquets</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Amb descompte per volum. Sense permanència llarga.
        </h2>
      </div>
      <ul class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea md:grid-cols-3" role="list">
        {
          paquetes.map((p) => (
            <li class="bg-papel p-8 md:p-10" data-reveal>
              <p class="eyebrow text-pizarra">{p.nombre}</p>
              <p class="mt-5 font-display text-[30px] font-extralight tracking-[-0.03em] text-oro-oscuro">
                {p.precio}
              </p>
              <p class="mt-3 text-[15px] text-tinta/85">{p.horas}</p>
              <p class="mt-2 font-mono text-[12px] text-pizarra">{p.pie}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 font-mono text-[12px] text-pizarra" data-reveal>
        Canal directe per Slack o WhatsApp · sempre actiu · sis mesos mínim
      </p>
    </div>
  </section>

  <!-- El ritme mensual -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow text-oro-luz">El ritme mensual</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Què passa cada mes, sense que ho hagis de demanar.
        </h2>
      </div>
      <ol class="mt-14 grid gap-8 md:grid-cols-4" role="list">
        {
          ritmo.map((r) => (
            <li class="border-t border-marfil/15 pt-6" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-luz">{r.n}</span>
              <h3 class="mt-3 font-display text-[18px] font-semibold leading-[1.3]">{r.titulo}</h3>
              <p class="mt-2 text-[14px] text-marfil/65">{r.texto}</p>
            </li>
          ))
        }
      </ol>
      <ul class="mt-16 grid gap-x-12 gap-y-8 md:grid-cols-2" role="list">
        {
          cadaMes.map((c) => (
            <li class="border-t border-marfil/12 pt-6" data-reveal>
              <h3 class="font-display text-[18px] font-semibold leading-[1.3]">{c.titulo}</h3>
              <p class="mt-2 text-[15px] text-marfil/65">{c.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Altres serveis -->
  <section class="hairline bg-panel">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow" data-reveal>Altres formes de treballar</p>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-3" role="list">
        {
          otros.map((o) => (
            <li class="bg-panel" data-reveal>
              <a href={href(o.ruta)} class="group flex h-full flex-col p-8 transition-colors hover:bg-oro/5">
                <span class="eyebrow text-pizarra">{o.etiqueta}</span>
                <h3 class="mt-3 font-display text-[20px] font-semibold">{o.titulo}</h3>
                <p class="mt-2 flex-1 text-[15px] text-pizarra">{o.pie}</p>
                <span class="mt-6 font-mono text-[12px] text-tinta/80 group-hover:text-oro-oscuro">Veure el detall →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <GuiasRelacionadas ruta={'/servicios/partner/'} idioma="ca" />

  <Cta
    titulo="30 minuts. Sense compromís. Tu decideixes després."
    texto="Entrevista estructurada amb la teva empresa. Et lliurem una proposta personalitzada amb estat inicial, pla de treball i pressupost."
    boton="Reservar diagnòstic gratuït"
  />
</Base>

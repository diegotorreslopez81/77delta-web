---
import Base from '../../../layouts/Base.astro';
import HeroFoto from '../../../components/HeroFoto.astro';
import Cta from '../../../components/Cta.astro';
import { hrefEn as href, site } from '../../../lib/site';
import { resumen, recorrido, faq } from '../../../data/servicios.en';
---

<Base
  title="Services"
  description="A free assessment, operational transformation with AI, a technology partner and security audits of AI assistants. Four ways to work with 77 Delta to cut costs and increase your business's output."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>Services</p>
        <h1
          class="mt-7 max-w-[20ch] font-display text-[clamp(36px,4.6vw,60px)] font-extralight leading-[1.04] tracking-[-0.035em]"
          data-reveal
        >
          A fractional AI director and four more ways to work with you. One goal: <span
            class="font-semibold text-oro-oscuro">cut costs</span
          > and increase your output with applied AI, without opening up risks along the way.
        </h1>
        <p class="mt-8 max-w-[52ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
          Every business is different, which is why we always start with the assessment. From there, you choose the
          route: an AI director on a fixed fee, a one-off project, ongoing support or a combination.
        </p>
      </div>
      <HeroFoto foto="gerente" alt="Two professionals talking in an office" class="lg:col-span-5" />
    </div>

    <a
      href={href('/servicios/director-ia/')}
      class="group mt-16 flex flex-col gap-6 rounded-[4px] border border-oro/40 bg-marino p-8 text-marfil transition-colors hover:bg-tinta md:flex-row md:items-center md:justify-between md:p-10"
      data-reveal
    >
      <div>
        <span class="eyebrow text-oro-luz">Core service · Fixed monthly fee</span>
        <h2 class="mt-4 font-display text-[clamp(24px,3vw,34px)] font-extralight leading-[1.15] tracking-[-0.03em]">
          Your AI director <span class="font-semibold text-oro-luz">from €1,200 a month</span>.
        </h2>
        <p class="mt-3 max-w-[60ch] text-[15px] text-marfil/70">
          One morning a month at your company with your technical team, the rest remotely, and savings guaranteed by contract:
          if by the third month the savings do not reach twice the fee, you can end the contract at no cost.
        </p>
      </div>
      <span class="shrink-0 font-mono text-[12px] text-marfil/80 group-hover:text-oro-luz">See the service →</span>
    </a>

    <div class="mt-4 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-4">
      {
        resumen.map((r) => (
          <a
            href={href(r.ruta)}
            class="group flex flex-col bg-panel p-8 transition-colors hover:bg-oro/5 md:p-10"
            data-reveal
          >
            <span class="eyebrow text-pizarra">{r.etiqueta}</span>
            <h2 class="mt-4 font-display text-[22px] font-semibold">{r.titulo}</h2>
            <p class="mt-3 flex-1 text-[15px] text-pizarra">{r.pie}</p>
            <span class="mt-8 font-mono text-[12px] text-tinta/80 group-hover:text-oro-oscuro">See the details →</span>
          </a>
        ))
      }
    </div>

    <p class="mt-8 max-w-[60ch] font-mono text-[12px] leading-[1.7] text-pizarra" data-reveal>
      You can start with one and add another when you need it. Or combine them from the outset.
    </p>
  </section>

  <!-- 04 · Seguridad de IA -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="grid gap-10 md:grid-cols-12">
        <div class="md:col-span-7" data-reveal>
          <p class="eyebrow text-oro-luz">04 · Security</p>
          <p class="eyebrow mt-6 text-marfil/50">Free scan · quoted remediation</p>
          <h2
            class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]"
          >
            An audit of the AI assistants already live on your website.
          </h2>
          <p class="mt-6 max-w-[56ch] text-[17px] text-marfil/72">
            An AI chatbot on your website speaks on your behalf and can reveal more than it should. We test yours the
            way an attacker would, show you what information leaks out and, if you wish, fix the
            vulnerabilities. The scan is free.
          </p>
          <a href={href('/servicios/seguridad-ia/')} class="mt-8 inline-flex items-center gap-2 font-display text-[15px] text-oro-luz">
            See how we audit →
          </a>
        </div>
        <ul class="grid gap-4 self-center md:col-span-5" role="list" data-reveal>
          {
            [
              ['Instructions', 'the system prompt and what the bot is forbidden to say'],
              ['Terms', 'prices, discounts and margins that come out if you keep pushing'],
              ['Data', 'customer information the assistant can reach'],
              ['Off script', 'prompt injection and answers that run out of control'],
            ].map(([campo, texto]) => (
              <li class="flex items-baseline gap-4 rounded-[4px] border border-marfil/12 bg-marfil/[0.04] px-5 py-4">
                <span class="shrink-0 whitespace-nowrap font-mono text-[11px] uppercase tracking-[0.14em] text-oro-luz">{campo}</span>
                <span class="text-[14px] text-marfil/70">{texto}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="cupo" class="hairline scroll-mt-[68px] bg-oro/[0.06]">
    <div class="wrap grid gap-10 py-20 md:grid-cols-12 md:py-24">
      <div class="md:col-span-7" data-reveal>
        <p class="eyebrow">Accreditation</p>
        <h2 class="mt-5 font-display text-[clamp(26px,3.2vw,40px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          An ACCIÓ-accredited provider.
        </h2>
        <p class="mt-6 max-w-[58ch] text-[17px] text-pizarra">
          {site.sociedad} is listed in the official register of technology providers of ACCIÓ, the Catalan
          government agency for business competitiveness. If your company is eligible for any of its
          grants, we will look into it in our first conversation.
        </p>
      </div>
      <div class="self-center md:col-span-5" data-reveal>
        <img
          src={href('/img/logos/accio.png')}
          alt="ACCIÓ, Catalan government"
          width="320"
          height="120"
          loading="lazy"
          decoding="async"
          class="h-14 w-auto"
        />
      </div>
    </div>
  </section>

  <!-- El recorrido típico -->
  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">The typical journey</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          From a conversation to transformation, in clear steps
        </h2>
        <p class="mt-6 text-[17px] text-pizarra">
          Every business moves at its own pace. There is no obligation to move on to the next step. The decision is yours at
          every stage.
        </p>
      </div>

      <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          recorrido.map((p) => (
            <li class="border-t border-linea pt-6" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{p.n}</span>
              <h3 class="mt-4 font-display text-[19px] font-semibold">{p.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="hairline">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Frequently asked questions</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          What people ask us most before they start
        </h2>
      </div>

      <div class="md:col-span-7" data-reveal>
        {
          faq.map((f) => (
            <details class="group border-t border-linea py-5 last:border-b">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[17px] font-semibold marker:content-none">
                {f.pregunta}
                <span class="mt-1 shrink-0 font-mono text-[14px] text-oro-oscuro transition-transform duration-200 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-[62ch] text-[15px] text-pizarra">{f.respuesta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Cta
    titulo="The first step is a conversation. No strings attached."
    texto="30 minutes to understand your situation and give you sound advice on applying AI in your business."
    boton="Book a free assessment"
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.pregunta, acceptedAnswer: { '@type': 'Answer', text: f.respuesta } })),
    })}
  />
</Base>

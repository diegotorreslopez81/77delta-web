---
/** Página para ayuntamientos. El contenido vive en src/data/ayuntamientos.ts; una página fina por idioma. */
import Base from '../layouts/Base.astro';
import Boton from './Boton.astro';
import Icono from './Icono.astro';
import { href, hrefCa } from '../lib/site';
import { areas, contenidos, hreflangs, rutas, type Idioma } from '../data/ayuntamientos';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const c = contenidos[idioma];
const lista = areas[idioma];
const enlace = idioma === 'ca' ? hrefCa : href;
const orden: Idioma[] = ['es', 'ca', 'gl', 'eu'];

const abs = (r: string) => new URL(href(r), Astro.site).href;
const alternates = [
  ...orden.map((i) => ({ hreflang: hreflangs[i], href: abs(rutas[i]) })),
  { hreflang: 'x-default', href: abs(rutas.es) },
];
const opciones = orden.map((i) => ({
  codigo: i,
  etiqueta: contenidos[i].etiquetaIdioma,
  ruta: href(rutas[i]),
  hreflang: hreflangs[i],
  activo: i === idioma,
}));
const deteccion = Object.fromEntries(orden.map((i) => [i, href(rutas[i])]));
---

<Base
  title={c.meta.title}
  description={c.meta.description}
  selectorIdioma={false}
  lang={idioma === 'es' || idioma === 'ca' ? undefined : idioma}
  alternates={alternates}
  idiomas={opciones}
  deteccion={deteccion}
>
  <!-- Hero corto -->
  <section class="wrap pb-10 pt-16 md:pt-24">
    <div class="flex flex-wrap items-center justify-between gap-4" data-reveal>
      <p class="eyebrow">{c.eyebrow}</p>
    </div>
    <h1 class="mt-6 max-w-[18ch] font-display text-[clamp(34px,5.4vw,60px)] font-bold leading-[1.06] tracking-[-0.02em]" data-reveal>
      {c.h1[0]}<span class="text-oro-oscuro">{c.h1[1]}</span>{c.h1[2]}
    </h1>
    <p class="mt-5 max-w-[44ch] text-[clamp(17px,1.6vw,19px)] text-pizarra" data-reveal>{c.lead}</p>
    <div class="mt-8 flex flex-wrap items-center gap-4" data-reveal>
      <Boton href={enlace('/contacto/')}>{c.boton} →</Boton>
      <span class="inline-flex items-center gap-2 rounded-full border border-linea bg-panel px-4 py-2 text-[14px]">
        <Icono nombre="propuesta" class="h-5 w-5 text-oro-oscuro" />
        {c.acred.sello}
      </span>
    </div>
  </section>

  <!-- Áreas -->
  <section class="wrap py-10 md:py-14">
    <div class="mb-6" data-reveal>
      <p class="eyebrow">{c.areasEyebrow}</p>
      <h2 class="mt-3 font-display text-[clamp(24px,3.2vw,34px)] font-semibold leading-[1.15]">{c.areasTitulo}</h2>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      {
        lista.map((a) => (
          <article class="flex flex-col gap-3 rounded-2xl border border-linea bg-panel p-6" data-reveal>
            <Icono nombre={a.icono} class="h-7 w-7 text-oro-oscuro" />
            <h3 class="font-display text-[21px] font-semibold leading-[1.2]">{a.titulo}</h3>
            <p class="text-[16px] text-pizarra">{a.frase}</p>
            <ul class="mt-auto space-y-1.5 border-t border-linea pt-3 text-[15px]" role="list">
              {a.casos.map((caso) => (
                <li class="flex gap-3">
                  <span class="mt-[11px] h-px w-3 shrink-0 bg-oro" aria-hidden="true" />
                  <span>{caso}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
    <p class="mt-6 text-[15px]" data-reveal>
      <span class="text-pizarra">{c.historias.texto}</span>
      <a href={enlace('/historias-de-exito/')} class="ml-2 font-mono text-[12px] text-oro-oscuro hover:text-tinta">{c.historias.enlace} →</a>
    </p>
  </section>

  <!-- Pasos -->
  <section class="wrap py-10 md:py-14">
    <div class="rounded-[20px] bg-marino p-8 text-marfil md:p-12">
      <p class="font-mono text-[12px] uppercase tracking-[0.12em] text-oro-luz">{c.serviciosEyebrow}</p>
      <h2 class="mt-3 font-display text-[clamp(24px,3.2vw,34px)] font-semibold leading-[1.15] text-white">{c.serviciosTitulo}</h2>
      <ol class="mt-8 grid gap-3 md:grid-cols-2" role="list">
        {
          c.servicios.map((s, i) => (
            <li class="flex items-start gap-4 rounded-xl border border-white/10 bg-white/5 p-4" data-reveal>
              <span class="font-display text-[28px] font-bold leading-none text-oro-luz">{i + 1}</span>
              <div>
                <p class="flex items-center gap-2 font-display text-[18px] font-semibold text-white">
                  <Icono nombre={s.icono} class="h-5 w-5 text-oro-luz" />
                  {s.titulo}
                </p>
                <p class="mt-1 text-[15px] text-pizarra-clara">{s.texto}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Sello ACCIÓ -->
  <section class="wrap py-6">
    <div class="flex flex-wrap items-center gap-5 rounded-2xl border border-oro bg-panel p-6" data-reveal>
      <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full border-2 border-oro-oscuro text-oro-oscuro">
        <Icono nombre="propuesta" class="h-7 w-7" />
      </span>
      <div class="min-w-[220px] flex-1">
        <p class="font-display text-[19px] font-semibold">{c.acred.sello}</p>
        <p class="text-[15px] text-pizarra">{c.acred.texto}</p>
      </div>
      <a href="https://www.accio.gencat.cat" target="_blank" rel="noopener" class="font-mono text-[12px] text-oro-oscuro hover:text-tinta">
        {c.acred.enlace} →
      </a>
    </div>
  </section>

  <!-- CTA -->
  <section class="wrap pb-28 pt-10">
    <div class="rounded-[20px] bg-marino px-6 py-12 text-center text-marfil md:px-12" data-reveal>
      <h2 class="font-display text-[clamp(26px,3.6vw,38px)] font-semibold text-white">{c.cta.titulo}</h2>
      <p class="mx-auto mt-3 max-w-[40ch] text-pizarra-clara">{c.cta.texto}</p>
      <div class="mt-7"><Boton href={enlace('/contacto/')}>{c.cta.boton} →</Boton></div>
    </div>
  </section>

  <!-- CTA fijo -->
  <div class="fixed inset-x-0 bottom-0 z-40 border-t border-linea bg-panel/95 backdrop-blur">
    <div class="wrap flex items-center justify-between gap-4 py-3">
      <span class="hidden text-[15px] sm:block">{c.cta.titulo}</span>
      <a href={enlace('/contacto/')} class="ml-auto rounded-[10px] bg-oro-oscuro px-5 py-2.5 text-[15px] font-semibold text-white hover:bg-oro">
        {c.cta.boton} →
      </a>
    </div>
  </div>
</Base>

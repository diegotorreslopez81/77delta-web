---
import GuiasRelacionadas from '../../../components/blog/GuiasRelacionadas.astro';
import Base from '../../../layouts/Base.astro';
import Boton from '../../../components/Boton.astro';
import Cta from '../../../components/Cta.astro';
import { hrefCa as href } from '../../../lib/site';
import { resumen } from '../../../data/servicios.ca';
import { ambitosCa as ambitos, modalidadesCa as modalidades } from '../../../data/partner';

const otros = resumen.filter((r) => r.titulo !== 'Soci tecnològic');
---

<Base
  title="Soci tecnològic"
  description="Soci tècnic per a tota la tecnologia de la teva empresa: programari a mida, integració, CRM i ERP, Microsoft, núvol, ciberseguretat, maquinari i planta, web, dades, IA i R+D. Un sol interlocutor, sense fabricants imposats."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <p class="eyebrow" data-reveal>
      <a href={href('/servicios/')} class="transition-colors hover:text-tinta">Serveis</a> · 03 · Acompanyament continu
    </p>
    <h1
      class="mt-7 max-w-[19ch] font-display text-[clamp(38px,6vw,76px)] font-extralight leading-[1.04] tracking-[-0.035em]"
      data-reveal
    >
      Tota la tecnologia de la teva empresa, <span class="font-semibold text-oro-oscuro">amb un sol interlocutor</span>.
    </h1>
    <p class="mt-8 max-w-[56ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
      Programari a mida, integració, CRM i ERP, Microsoft, núvol, ciberseguretat, maquinari i planta, web, dades, IA
      i R+D. Un soci tècnic que entén tot el que t’envolta i t’ho explica en el teu idioma.
    </p>

    <div class="mt-14 flex flex-wrap items-center gap-8" data-reveal>
      <p class="font-mono text-[12px] leading-[1.6] tracking-[0.04em] text-pizarra">
        Dotze àmbits · Un interlocutor · Sense fabricants imposats
      </p>
      <Boton href={href('/contacto/')}>Explica’ns el teu cas →</Boton>
    </div>
  </section>

  <!-- Per a qui -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-12 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Per a qui és</p>
        <h2 class="mt-5 font-display text-[clamp(26px,3.2vw,38px)] font-extralight leading-[1.15] tracking-[-0.03em]">
          Per a qui no té un director de tecnologia en nòmina.
        </h2>
      </div>
      <div class="md:col-span-7 md:pl-6" data-reveal>
        <p class="text-[17px] text-pizarra">
          Per a empreses amb tecnologia de diversos proveïdors i ningú a dins que la governi: l’ERP d’un, el CRM
          d’un altre, el web d’una agència, les màquines amb el seu propi programari. Posem un responsable tècnic
          al teu costat que coneix totes aquestes peces. Si el que necessites és només IA, el servei és el
          <a href={href('/servicios/director-ia/')} class="font-medium text-tinta underline decoration-oro/60 underline-offset-4 transition-colors hover:text-oro-oscuro">Director d’IA extern</a>.
        </p>
      </div>
    </div>
  </section>

  <!-- Què cobrim -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Què cobrim</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          De la nau al núvol: dotze àmbits i les tecnologies de cadascun.
        </h2>
      </div>
      <ul class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3" role="list">
        {
          ambitos.map((a) => (
            <li class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-pizarra">{a.n}</span>
              <h3 class="mt-3 font-display text-[20px] font-semibold leading-[1.3]">{a.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{a.texto}</p>
              <ul class="mt-5 flex flex-1 flex-wrap content-start gap-2" role="list">
                {a.tecnologias.map((t) => (
                  <li class="rounded-[3px] border border-linea bg-papel px-2.5 py-1 font-mono text-[11px] text-tinta/80">{t}</li>
                ))}
              </ul>
              {a.enlace && (
                <a href={href(a.enlace.ruta)} class="mt-6 font-mono text-[12px] text-tinta/80 transition-colors hover:text-oro-oscuro">
                  {a.enlace.texto} →
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Com treballem -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow text-oro-luz">Com treballem</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Què pots esperar de nosaltres, sigui quina sigui la tecnologia.
        </h2>
      </div>
      <ol class="mt-14 grid gap-8 md:grid-cols-4" role="list">
        {
          modalidades.map((m) => (
            <li class="border-t border-marfil/15 pt-6" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-luz">{m.n}</span>
              <h3 class="mt-3 font-display text-[18px] font-semibold leading-[1.3]">{m.titulo}</h3>
              <p class="mt-2 text-[14px] text-marfil/65">{m.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Altres serveis -->
  <section class="hairline bg-panel">
    <div class="wrap py-20 md:py-24">
      <p class="eyebrow" data-reveal>Altres formes de treballar</p>
      <ul class="mt-10 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-3" role="list">
        {
          otros.map((o) => (
            <li class="bg-panel" data-reveal>
              <a href={href(o.ruta)} class="group flex h-full flex-col p-8 transition-colors hover:bg-oro/5">
                <span class="eyebrow text-pizarra">{o.etiqueta}</span>
                <h3 class="mt-3 font-display text-[20px] font-semibold">{o.titulo}</h3>
                <p class="mt-2 flex-1 text-[15px] text-pizarra">{o.pie}</p>
                <span class="mt-6 font-mono text-[12px] text-tinta/80 group-hover:text-oro-oscuro">Veure el detall →</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <GuiasRelacionadas ruta={'/servicios/partner/'} idioma="ca" />

  <Cta
    titulo="30 minuts. Sense compromís. Tu decideixes després."
    texto="Entrevista estructurada amb la teva empresa. Et lliurem una proposta personalitzada amb estat inicial, pla de treball i pressupost."
    boton="Reservar diagnòstic gratuït"
  />
</Base>

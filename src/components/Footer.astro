// Rutas canónicas en castellano también en inglés: `hrefEn` las traduce a /en/... (y al castellano si no hay versión inglesa).
const columnasEn = [
  {
    titulo: 'What we do',
    enlaces: [
      { texto: 'Artificial intelligence', ruta: '/inteligencia-artificial/' },
      { texto: 'Cybersecurity', ruta: '/ciberseguridad/' },
      { texto: 'Digital identity', ruta: '/identidad-digital/' },
      { texto: 'Data spaces', ruta: '/espacios-de-datos/' },
      { texto: 'Fractional AI director', ruta: '/servicios/director-ia/' },
      { texto: 'Assessment', ruta: '/servicios/diagnostico/' },
      { texto: 'Operational transformation', ruta: '/servicios/transformacion/' },
      { texto: 'AI assistant security', ruta: '/ciberseguridad/#asistentes-ia' },
      { texto: 'Technology partner', ruta: '/servicios/partner/' },
      { texto: 'ACCIÓ accreditation', ruta: '/inteligencia-artificial/#cupo' },
    ],
  },
  {
    titulo: 'Results',
    enlaces: [
      { texto: 'Case studies', ruta: '/historias-de-exito/' },
      { texto: 'Use cases', ruta: '/casos-de-uso/' },
      { texto: 'Sectors', ruta: '/sectores/' },
      { texto: 'Ongoing projects', ruta: '/proyectos-en-curso/' },
    ],
  },
  {
    titulo: 'Tools',
    enlaces: [
      { texto: 'Licita', ruta: '/licita/' },
      { texto: 'Corpora', ruta: '/herramientas/#corpora' },
    ],
  },
  {
    titulo: 'Company',
    enlaces: [
      { texto: 'About us', ruta: '/sobre-nosotros/' },
      { texto: 'Blog', ruta: '/blog/' },
      { texto: 'Work with us', ruta: '/trabaja-con-nosotros/' },
      { texto: 'Contact', ruta: '/contacto/' },
    ],
  },
  {
    titulo: 'Legal',
    enlaces: [
      { texto: 'Legal notice', ruta: '/aviso-legal/' },
      { texto: 'Privacy', ruta: '/politica-privacidad/' },
      { texto: 'Cookies', ruta: '/politica-cookies/' },
    ],
  },
];

const columnasFinal = idioma === 'ca' ? columnasCa : idioma === 'en' ? columnasEn : columnasEs;
const t = {
  es: { inicio: '77 Delta, inicio', oficina: 'Oficina en ', marca: 'es una marca de', datos: 'Datos procesados en la Unión Europea · RGPD',
        lema: 'Consultora tecnológica especializada en pymes. Transformamos pymes con inteligencia artificial aplicada con criterio.' },
  ca: { inicio: '77 Delta, inici', oficina: 'Oficina a ', marca: 'és una marca de', datos: 'Dades processades a la Unió Europea · RGPD',
        lema: 'Consultora tecnològica especialitzada en pimes. Transformem pimes amb intel·ligència artificial aplicada amb criteri.' },
  en: { inicio: '77 Delta, home', oficina: 'Office in ', marca: 'is a brand of', datos: 'Data processed in the European Union · GDPR',
        lema: 'Technology consultancy for small and mid-sized businesses. We transform SMEs with artificial intelligence applied with judgement.' },
}[idioma];
---

<footer class="bg-marino text-marfil/70">
  <div class="wrap grid gap-10 py-20 sm:grid-cols-2 lg:grid-cols-5 xl:grid-cols-[1.4fr_repeat(5,1fr)]">
    <div class="sm:col-span-2 lg:col-span-5 xl:col-span-1">
      <a href={enlace('/')} class="text-marfil" aria-label={t.inicio}><Monograma size={30} /></a>
      <p class="mt-5 max-w-[28ch] text-[14px] leading-[1.55] text-marfil/60">{t.lema}</p>
      <p class="mt-6 text-[13px] text-marfil/55">
        {t.oficina}
        <strong class="font-semibold text-marfil/85">{site.ciudad}</strong>
      </p>
    </div>

    {
      columnasFinal.map((c) => (
        <div>
          <h4 class="mb-4 text-[13px] font-semibold uppercase tracking-[0.05em] text-marfil">{c.titulo}</h4>
          <ul class="space-y-2.5">
            {c.enlaces.map((e) => (
              <li>
                <a href={enlace(e.ruta)} class="text-[14px] text-marfil/65 transition-colors hover:text-marfil">
                  {e.texto}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="border-t border-marfil/10">
    <div class="wrap flex flex-col gap-3 py-8 text-[13px] text-marfil/50 md:flex-row md:items-center md:justify-between">
      <p>
        © {site.anio} {site.nombre} {t.marca} <strong class="font-semibold text-marfil/80">{site.sociedad}</strong> ·
        CIF {site.cif} · {site.direccion}
      </p>
      <p class="flex items-center gap-5 whitespace-nowrap">
        <span>{t.datos}</span>
        <a href={site.linkedin} target="_blank" rel="noopener" class="transition-colors hover:text-marfil">LinkedIn</a>
      </p>
    </div>
  </div>
</footer>

---
/** Página para ayuntamientos. El contenido vive en src/data/ayuntamientos.ts; una página fina por idioma. */
import Base from '../layouts/Base.astro';
import Boton from './Boton.astro';
import Cta from './Cta.astro';
import { href, hrefCa } from '../lib/site';
import { areas, contenidos, hreflangs, rutas, type Idioma } from '../data/ayuntamientos';

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const c = contenidos[idioma];
const lista = areas[idioma];
const enlace = idioma === 'ca' ? hrefCa : href;
const orden: Idioma[] = ['es', 'ca', 'gl', 'eu'];

const abs = (r: string) => new URL(href(r), Astro.site).href;
const alternates = [
  ...orden.map((i) => ({ hreflang: hreflangs[i], href: abs(rutas[i]) })),
  { hreflang: 'x-default', href: abs(rutas.es) },
];
---

<Base
  title={c.meta.title}
  description={c.meta.description}
  selectorIdioma={false}
  lang={idioma === 'es' || idioma === 'ca' ? undefined : idioma}
  alternates={alternates}
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="flex flex-wrap items-center justify-between gap-4" data-reveal>
      <p class="eyebrow">{c.eyebrow}</p>
      <nav aria-label={c.selector} class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-[12px]">
        {
          orden.map((i) => (
            <a
              href={href(rutas[i])}
              hreflang={hreflangs[i]}
              lang={i}
              aria-current={i === idioma ? 'page' : undefined}
              class={i === idioma ? 'text-oro-oscuro underline underline-offset-4' : 'text-pizarra hover:text-tinta'}
            >
              {contenidos[i].etiquetaIdioma}
            </a>
          ))
        }
      </nav>
    </div>
    <h1
      class="mt-7 max-w-[18ch] font-display text-[clamp(38px,6vw,76px)] font-extralight leading-[1.04] tracking-[-0.035em]"
      data-reveal
    >
      {c.h1[0]}<span class="font-semibold text-oro-oscuro">{c.h1[1]}</span>{c.h1[2]}
    </h1>
    <p class="mt-8 max-w-[54ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>{c.lead}</p>
    <div class="mt-14" data-reveal>
      <Boton href={enlace('/contacto/')}>{c.boton} →</Boton>
    </div>
  </section>

  <!-- Ejemplos por área -->
  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">{c.areasEyebrow}</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          {c.areasTitulo}
        </h2>
        <p class="mt-6 text-[17px] text-pizarra">{c.areasNota}</p>
      </div>

      <div class="mt-16 grid gap-x-12 gap-y-16 md:grid-cols-2">
        {
          lista.map((a, i) => (
            <article data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-4 font-display text-[22px] font-semibold leading-[1.25]">{a.titulo}</h3>
              <p class="mt-3 text-[16px] text-pizarra">{a.intro}</p>
              <ul class="mt-5 space-y-3 border-t border-linea pt-5 text-[15px]" role="list">
                {a.casos.map((caso) => (
                  <li class="flex gap-3">
                    <span class="mt-[9px] h-px w-3 shrink-0 bg-oro" aria-hidden="true" />
                    <span>{caso}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>

      <p class="mt-16" data-reveal>
        <span class="text-[16px] text-pizarra">{c.historias.texto}</span>
        <a href={enlace('/historias-de-exito/')} class="ml-3 font-mono text-[12px] text-oro-oscuro hover:text-tinta">
          {c.historias.enlace} →
        </a>
      </p>
    </div>
  </section>

  <!-- Servicios -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">{c.serviciosEyebrow}</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          {c.serviciosTitulo}
        </h2>
      </div>
      <ol class="mt-16 grid gap-x-12 gap-y-12 md:grid-cols-2" role="list">
        {
          c.servicios.map((s, i) => (
            <li data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{String(i + 1).padStart(2, '0')}</span>
              <p class="mt-4 font-display text-[19px] font-semibold leading-[1.3]">{s.titulo}</p>
              <p class="mt-3 text-[16px] text-pizarra">{s.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Acreditación -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-10 py-20 md:grid-cols-12 md:py-24">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">{c.acred.eyebrow}</p>
        <h2 class="mt-5 font-display text-[clamp(24px,3vw,36px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          {c.acred.titulo}
        </h2>
      </div>
      <div class="md:col-span-7 md:pt-10" data-reveal>
        <p class="text-[17px] text-pizarra">{c.acred.texto}</p>
        <a
          href="https://www.accio.gencat.cat"
          target="_blank"
          rel="noopener"
          class="mt-6 inline-block font-mono text-[12px] text-oro-oscuro hover:text-tinta"
        >
          {c.acred.enlace} →
        </a>
      </div>
    </div>
  </section>

  <Cta titulo={c.cta.titulo} texto={c.cta.texto} boton={c.cta.boton} />
</Base>

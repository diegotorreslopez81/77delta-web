---
/**
 * Página corporativa de empleo (es, en, ca). El reto técnico con agente vive en /developer/.
 * Sin precios ni promesas de sueldo. Noindex hasta el OK de Diego.
 */
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import Boton from './Boton.astro';
import HeroFoto from './HeroFoto.astro';
import Icono from './Icono.astro';
import Cta from './Cta.astro';
import diego from '../assets/diego.png';

interface Props {
  idioma: 'es' | 'en' | 'ca';
}
const { idioma } = Astro.props;

const MAIL = 'team@77delta.com';

const t = {

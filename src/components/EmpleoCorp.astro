  },
  ca: {
    title: 'Treballa amb nosaltres',
    desc: "Consultora d'IA amb base a Barcelona. Treballem en remot i per projecte amb agents i automatització.",
    eyebrow: 'Treballa amb nosaltres',
    h1: 'Construïm amb IA. Busquem gent amb criteri.',
    p: "Som una consultora tecnològica de Barcelona. Ajudem pimes a aplicar intel·ligència artificial amb criteri: agents i automatització que canvien com treballa l'empresa.",

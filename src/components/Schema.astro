---
/**
 * JSON-LD: Organization en la home (es/ca), Service en /servicios/<x>/ y en las cuatro líneas de trabajo.
 * Todo sale de site.ts y de los props de la página; nada inventado.
 */
import { site, nav, navCa, navEn, enlaceDe } from '../lib/site';

interface Props {
  title: string;
  description: string;
  idioma: 'es' | 'ca' | 'en';
  canonical: string;
  /** Idioma real de la página (es, ca, gl, eu). */
  lang?: string;
  /** Migas propias (artículos): sustituyen a las derivadas de la ruta. */
  migas?: { nombre: string; ruta: string }[];
}
const { title, description, idioma, canonical, lang, migas } = Astro.props;
const origen = new URL('/', Astro.site).href;
const ruta = new URL(canonical).pathname.replace(/^\/(ca|en)(?=\/)/, '');
const esHome = ruta === '/';
// Líneas de trabajo del reorden de 2026-10 (es, ca y en), también Service.
const esLinea = /^\/(inteligencia-artificial|ciberseguridad|identidad-digital|espacios-de-datos|intel-ligencia-artificial|ciberseguretat|identitat-digital|espais-de-dades|artificial-intelligence|cybersecurity|digital-identity|data-spaces)\/$/.test(ruta);
const esServicio = esLinea || /^\/servicios\/[^/]+\/$/.test(ruta) || /^\/(ayuntamientos|ajuntaments|gl\/concellos|eu\/udalak)\/$/.test(ruta);
const esProducto = /^\/productos\/[^/]+\/$/.test(ruta);

const organizacion = {
  '@type': 'Organization',
  '@id': `${origen}#organizacion`,
  name: site.nombre,
  legalName: site.sociedad,
  url: origen,
  description: idioma === 'ca' ? site.descripcionCa : idioma === 'en' ? site.descripcionEn : site.descripcion,
  image: new URL('/img/og.png', Astro.site).href,
  telephone: `+${site.whatsapp}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Carrer Penedès 27',
    postalCode: '08184',
    addressLocality: 'Palau-solità i Plegamans',
    addressRegion: 'Barcelona',
    addressCountry: 'ES',
  },
  areaServed: 'ES',
  knowsLanguage: ['es', 'ca'],
};

const nodoWebSite = {
  '@type': 'WebSite',
  '@id': `${origen}#web`,
  name: site.nombre,
  url: origen,
  inLanguage: ['es', 'ca'],
  publisher: { '@id': `${origen}#organizacion` },
};

const nodoServicio = {
  '@type': 'Service',
  name: title,
  description,
  url: canonical,
  inLanguage: lang ?? idioma,
  provider: { '@id': `${origen}#organizacion` },
  areaServed: 'ES',
};

const nodoProducto = {
  '@type': 'SoftwareApplication',
  name: title,
  description,
  url: canonical,
  applicationCategory: 'BusinessApplication',
  inLanguage: lang ?? idioma,
  publisher: { '@id': `${origen}#organizacion` },
};

// Migas: inicio > sección (etiqueta del menú) > página. Solo ruta real, sin inventar niveles.
const items = idioma === 'ca' ? navCa : idioma === 'en' ? navEn : nav;
const prefijo = idioma === 'ca' ? '/ca' : idioma === 'en' ? '/en' : '';
const enlace = enlaceDe(idioma);
// Entradas del menú aplanadas; los hijos van antes para que una ruta anidada tome su propia etiqueta.
const planos = items.flatMap((n) => [...(n.hijos ?? []), n]);
const partes = new URL(canonical).pathname.replace(/\/$/, '').split('/').filter(Boolean).filter((x, i) => !(i === 0 && (x === 'ca' || x === 'en')));
const derivadas = partes.map((seg, i) => {
  const r = '/' + partes.slice(0, i + 1).join('/') + '/';
  const esUltima = i === partes.length - 1;
  // En inglés las rutas de la URL ya son inglesas: la etiqueta se busca por la ruta canónica que traduce `enlace`.
  const etiqueta = planos.find((n) => n.ruta === r || enlace(n.ruta) === prefijo + r)?.texto;
  return { nombre: esUltima ? title : etiqueta, ruta: prefijo + r };
}).filter((m) => m.nombre);
const lista = [{ nombre: site.nombre, ruta: idioma === 'en' ? enlace('/') : prefijo + '/' }, ...(migas ?? derivadas)];
const nodoMigas = {
  '@type': 'BreadcrumbList',
  itemListElement: lista.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.nombre, item: new URL(m.ruta, Astro.site).href })),
};

const grafo = esHome
  ? [organizacion, nodoWebSite]
  : [esServicio ? nodoServicio : esProducto ? nodoProducto : null, partes.length > 0 || migas ? nodoMigas : null].filter(Boolean);
const datos = grafo.length ? { '@context': 'https://schema.org', '@graph': grafo } : null;
---

{datos && <script type="application/ld+json" set:html={JSON.stringify(datos)} />}

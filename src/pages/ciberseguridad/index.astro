---
import Base from '../../layouts/Base.astro';
import HeroFoto from '../../components/HeroFoto.astro';
import Boton from '../../components/Boton.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import Cta from '../../components/Cta.astro';
import { href } from '../../lib/site';

const protegemos = [
  {
    titulo: 'Asistentes y agentes de IA',
    texto:
      'Los probamos como un atacante: instrucciones internas, precios que no debería dar, datos de clientes a los que llega y lo que hace cuando se le saca del guion.',
  },
  {
    titulo: 'Datos que salen de la empresa',
    texto:
      'Qué pega tu equipo en herramientas públicas, con qué permisos y con qué contrato. Una política de uso de IA que la gente cumple porque es corta.',
  },
  {
    titulo: 'Pagos y accesos',
    texto:
      'Suplantación de proveedores, cambios de cuenta bancaria por correo y accesos sin segundo factor. Lo que se detecta antes de pagar no se recupera después.',
  },
];

const fugas = [
  {
    titulo: 'Las instrucciones internas',
    texto:
      'El system prompt completo: cómo se le ha dicho al bot que se comporte, qué no debe decir y con qué datos trabaja. Es el mapa para todo lo demás.',
  },
  {
    titulo: 'Precios, descuentos y márgenes',
    texto:
      'Rangos de honorarios, condiciones especiales y umbrales de negociación que están en el contexto del bot porque se incluyeron para mejorar sus respuestas.',
  },
  {
    titulo: 'Datos de clientes',
    texto:
      'Si el chatbot consulta un CRM, un histórico de pedidos o una base de conocimiento con datos reales, se le puede pedir que hable de ellos.',
  },
  {
    titulo: 'Comportamiento fuera de guion',
    texto:
      'Con una inyección de instrucciones, el bot de tu web puede acabar diciendo lo que decida un tercero. Lo hace bajo la imagen de tu marca.',
  },
  {
    titulo: 'Promesas que no puedes cumplir',
    texto:
      'Plazos, garantías y condiciones inventadas sobre la marcha. Un chatbot en tu dominio es tu voz, y lo que afirma tiene efecto frente al cliente.',
  },
  {
    titulo: 'Acceso a herramientas conectadas',
    texto:
      'Cuando el agente puede reservar, consultar o escribir en tus sistemas, la pregunta deja de ser qué cuenta y pasa a ser qué hace.',
  },
];

const pasosIa = [
  {
    titulo: 'Detección',
    texto:
      'Recorremos tu web como lo haría un visitante y localizamos los asistentes con IA publicados, incluidos los que marketing publicó sin informar al departamento de sistemas.',
  },
  {
    titulo: 'Pruebas',
    texto:
      'Lanzamos una batería de pruebas de fuga sobre cada asistente: extracción de instrucciones, condiciones comerciales, datos personales, inyección de instrucciones y salida de guion.',
  },
  {
    titulo: 'Informe',
    texto:
      'Cada respuesta se puntúa contra una rúbrica y tiene que citar el fragmento exacto que constituye la fuga. Sin ese fragmento, no lo contamos como hallazgo.',
  },
  {
    titulo: 'Remediación',
    texto:
      'Reescribimos el system prompt, ponemos guardarraíles y filtros de salida, acotamos lo que el agente puede consultar y dejamos pruebas de regresión para que no vuelva a abrirse.',
  },
];

const entregables = [
  {
    etiqueta: 'Gratuito',
    titulo: 'Escaneo inicial',
    texto:
      'Un informe de una página con lo que se ve desde fuera: severidad global y categorías de fuga detectadas. Suficiente para saber si tienes un problema y de qué tamaño.',
  },
  {
    etiqueta: 'Precio cerrado por alcance',
    titulo: 'Auditoría y remediación',
    texto:
      'El detalle reproducible de cada hallazgo, con la conversación exacta y la recomendación técnica, y la corrección con tu proveedor o con nosotros.',
  },
  {
    etiqueta: 'Opcional',
    titulo: 'Vigilancia continua',
    texto:
      'Repetimos el escaneo cada mes. Cambiar el system prompt o añadir una fuente al asistente puede reabrir lo que estaba cerrado.',
  },
];

const queHacemos = [
  {
    etiqueta: 'Conocimiento',
    texto:
      'Concienciación a medida (phishing, suplantación, cambio de IBAN), simulacros de fraude y ejercicios de mesa, y guías breves de buenas prácticas, incluido el uso responsable de herramientas de IA.',
  },
  {
    etiqueta: 'Consultoría',
    texto:
      'Diagnóstico con plan priorizado (qué cerrar primero, qué puede esperar), preparación para NIS2, ENS y RGPD, y plan de respuesta a incidentes con roles y contactos, con acompañamiento si llega.',
  },
  {
    etiqueta: 'Desarrollo',
    texto:
      'Hardening de equipos, cuentas, correo y nube. Desarrollo seguro de aplicaciones y automatizaciones, con revisión de código y dependencias, y seguridad de sistemas con IA.',
  },
];

const problemas = [
  { frase: 'Nos llegó un correo del proveedor con un IBAN nuevo y casi pagamos.', causa: 'Fraude de suplantación y cambio de cuenta' },
  { frase: 'No sé si estamos expuestos ni por dónde empezar.', causa: 'Falta de visibilidad y de prioridades' },
  { frase: 'Nos piden NIS2 o ENS y no sabemos si nos afecta.', causa: 'Normativa sin traducir a tareas' },
  { frase: 'Si nos atacan mañana, nadie sabe qué hacer.', causa: 'Sin plan, sin responsables y sin copias probadas' },
  { frase: 'Hemos puesto un asistente con IA y nadie lo ha revisado.', causa: 'Herramientas fuera del radar de IT' },
];

const pasos = [
  { titulo: 'Escuchamos', texto: 'Tu negocio, tus sistemas y qué no puedes permitirte perder.' },
  { titulo: 'Diagnosticamos', texto: 'Accesos, correo, copias, proveedores y sistemas con IA, solo con autorización expresa.' },
  { titulo: 'Priorizamos y corregimos', texto: 'Plan por riesgo y esfuerzo. Lo que podemos cerrar, lo cerramos.' },
  { titulo: 'Dejamos criterio', texto: 'Formación y documentación para que no dependas de nosotros.' },
];

const paraQuien = [
  'Gerentes de pyme que quieren reducir el riesgo de fraude sin convertirse en técnicos.',
  'Responsables de IT con poco equipo que necesitan segundo criterio, plan y apoyo en preparación normativa.',
  'Administración pública y entidades vinculadas que deben alinearse con ENS y NIS2.',
];

const faq = [
  {
    pregunta: '¿Mi pyme es un objetivo real?',
    respuesta:
      'Sí. Los ataques automatizados no distinguen tamaños y el fraude por correo busca empresas con procesos poco verificados.',
  },
  {
    pregunta: '¿Me afecta NIS2 o el ENS?',
    respuesta:
      'Depende de tu sector y de si prestas servicios a entidades obligadas. El diagnóstico lo aclara y te preparamos para lo que corresponda.',
  },
  {
    pregunta: '¿Hacéis pruebas intrusivas?',
    respuesta: 'Solo con autorización por escrito y alcance acordado.',
  },
  {
    pregunta: '¿Y si ya hemos tenido un incidente?',
    respuesta:
      'Te ayudamos a contenerlo, a entender qué pasó y a cumplir los avisos obligatorios.',
  },
  {
    pregunta: '¿Qué información se le puede sacar a un chatbot de empresa?',
    respuesta:
      'Sus instrucciones internas, precios y condiciones, datos de clientes si consulta un CRM, y respuestas fuera de guion bajo tu marca.',
  },
  {
    pregunta: '¿Cuánto tarda el escaneo inicial de un asistente?',
    respuesta:
      'Días laborables y sin tocar tus sistemas: solo lo que se ve desde fuera. Para la remediación necesitamos el acceso mínimo, acordado por escrito.',
  },
  {
    pregunta: '¿Es compatible con el RGPD?',
    respuesta:
      'Sí: el informe señala qué datos personales expone el asistente y cómo se corrige.',
  },
];
---

<Base
  title="Ciberseguridad para pymes"
  description="Ciberseguridad para pymes que usan IA: auditamos tus asistentes, los datos que salen y los pagos que entran. Escaneo inicial gratuito y precio cerrado."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>Ciberseguridad</p>
        <h1
          class="mt-7 max-w-[20ch] font-display text-[clamp(36px,4.6vw,60px)] font-extralight leading-[1.04] tracking-[-0.035em]"
          data-reveal
        >
          La IA abre puertas nuevas. <span class="font-semibold text-oro-oscuro">Nosotros las cerramos.</span>
        </h1>
        <p class="mt-8 max-w-[54ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
          Publicar un asistente con IA o conectar una herramienta a tus datos es rápido. Comprobar qué se
          escapa por ahí es lo que casi nadie hace. Ayudamos a pymes y administraciones a saber dónde están
          expuestas y a cerrar lo importante, sin jerga ni miedo.
        </p>
        <div class="mt-12 flex flex-wrap gap-4" data-reveal>
          <Boton href={href('/contacto/')}>Reservar diagnóstico →</Boton>
          <Boton href="#como-trabajamos" variante="linea">Ver cómo trabajamos</Boton>
        </div>
      </div>
      <HeroFoto foto="despachos" alt="Persona firmando un documento" class="lg:col-span-5" />
    </div>
  </section>

  <!-- Qué protegemos -->
  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Qué protegemos</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Tres frentes donde la IA y el fraude se encuentran con tu empresa.
        </h2>
      </div>
      <ul class="mt-16 grid gap-10 md:grid-cols-3" role="list">
        {
          protegemos.map((p, i) => (
            <li class="border-t border-linea pt-8" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-4 font-display text-[20px] font-semibold leading-[1.3]">{p.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{p.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Asistentes de IA -->
  <section id="asistentes-ia" class="hairline scroll-mt-[68px]">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Asistentes de IA</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Tu chatbot revela más información de la que crees.
        </h2>
        <p class="mt-6 text-[17px] text-pizarra">
          No hace falta ser un atacante sofisticado: basta con formular las preguntas adecuadas. En nuestro
          rastreo de webs españolas, algunos de los asistentes con IA encontrados dejaron escapar algo al
          probarlos a fondo, con una segunda revisión adversa sobre cada hallazgo. Nadie vulneró nada: solo
          hubo que escribir en el chat.
        </p>
        <a
          href={href('/estudio-asistentes-ia/')}
          class="mt-5 inline-block font-mono text-[12px] text-oro-oscuro transition-colors hover:text-tinta"
        >
          Ver el estudio completo con los datos →
        </a>
      </div>

      <ul class="mt-16 grid gap-x-12 gap-y-12 md:grid-cols-2 lg:grid-cols-3" role="list">
        {
          fugas.map((f, i) => (
            <li data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-4 font-display text-[19px] font-semibold leading-[1.3]">{f.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{f.texto}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-24 max-w-[62ch]" data-reveal>
        <h3 class="font-display text-[clamp(24px,3vw,34px)] font-extralight leading-[1.15] tracking-[-0.03em]">
          Cuatro pasos para auditar tus asistentes.
        </h3>
      </div>
      <ol class="mt-10 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea md:grid-cols-2" role="list">
        {
          pasosIa.map((p, i) => (
            <li class="bg-panel p-8 md:p-10" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{String(i + 1).padStart(2, '0')}</span>
              <h4 class="mt-4 font-display text-[20px] font-semibold leading-[1.3]">{p.titulo}</h4>
              <p class="mt-3 text-[15px] text-pizarra">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Qué te llevas -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow text-oro-luz">Qué te llevas</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          El escaneo inicial es gratuito. La corrección de las vulnerabilidades, con precio cerrado.
        </h2>
        <p class="mt-6 text-[15px] text-marfil/70">
          Es un diagnóstico, no un ataque. Hablamos con el asistente como lo haría cualquier visitante, desde
          la web pública y a un ritmo limitado. No entramos en sistemas ni tocamos nada que no esté publicado, y
          los hallazgos se enseñan solo al responsable de la empresa.
        </p>
      </div>
      <ul class="mt-16 grid gap-10 md:grid-cols-3" role="list">
        {
          entregables.map((e) => (
            <li class="border-t border-marfil/15 pt-8" data-reveal>
              <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-oro-luz">{e.etiqueta}</span>
              <h3 class="mt-4 font-display text-[20px] font-semibold leading-[1.3]">{e.titulo}</h3>
              <p class="mt-3 text-[15px] text-marfil/70">{e.texto}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-12" data-reveal>
        <Boton href={href('/contacto/')}>Pedir el escaneo gratuito →</Boton>
      </div>
    </div>
  </section>

  <!-- Conocimiento, consultoría y desarrollo -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Qué hacemos</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Conocimiento, consultoría y desarrollo.
        </h2>
      </div>
      <ul class="mt-16 grid gap-10 md:grid-cols-3" role="list">
        {
          queHacemos.map((q) => (
            <li class="border-t border-linea pt-8" data-reveal>
              <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-oro-oscuro">{q.etiqueta}</span>
              <p class="mt-4 text-[15px] text-pizarra">{q.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Problemas que resolvemos -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Problemas que resolvemos</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Si te suena alguna de estas frases, hablemos.
        </h2>
      </div>
      <ul class="md:col-span-7" role="list">
        {
          problemas.map((p) => (
            <li class="border-t border-linea py-6 first:border-t-0 first:pt-0" data-reveal>
              <p class="font-display text-[18px] font-semibold leading-[1.35]">«{p.frase}»</p>
              <p class="mt-2 font-mono text-[12px] text-pizarra">{p.causa}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Cómo trabajamos -->
  <section id="como-trabajamos" class="hairline scroll-mt-[68px]">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Cómo trabajamos</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Cuatro pasos, de la conversación al criterio propio.
        </h2>
      </div>
      <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          pasos.map((p, i) => (
            <li class="border-t border-linea pt-6" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-4 font-display text-[19px] font-semibold">{p.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{p.texto}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-12 max-w-[62ch] font-mono text-[12px] leading-[1.7] text-pizarra" data-reveal>
        El diagnóstico general parte de la <a class="text-oro-oscuro underline underline-offset-4" href={href('/servicios/diagnostico/')}>conversación inicial de 30 minutos</a>.
      </p>
    </div>
  </section>

  <!-- Para quién -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Para quién</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Pensado para quien no puede dedicarse solo a esto.
        </h2>
      </div>
      <ul class="space-y-5 text-[17px] text-pizarra md:col-span-7" role="list" data-reveal>
        {paraQuien.map((t) => <li class="border-t border-linea pt-5 first:border-t-0 first:pt-0">{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="hairline">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Lo que más nos preguntan antes de empezar
        </h2>
      </div>
      <div class="md:col-span-7" data-reveal>
        {
          faq.map((f) => (
            <details class="group border-t border-linea py-5 last:border-b">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[17px] font-semibold marker:content-none">
                {f.pregunta}
                <span class="mt-1 shrink-0 font-mono text-[14px] text-oro-oscuro transition-transform duration-200 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-[62ch] text-[15px] text-pizarra">{f.respuesta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <FaqSchema faq={faq} />

  <Cta
    titulo="Empieza por saber dónde estás."
    texto="Cuéntanos tu situación y reservamos un diagnóstico. Sin compromiso, con un plan claro al final."
    boton="Reservar diagnóstico"
  />
</Base>

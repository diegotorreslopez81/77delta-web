---
import Base from '../../../layouts/Base.astro';
import HeroFoto from '../../../components/HeroFoto.astro';
import Boton from '../../../components/Boton.astro';
import FaqSchema from '../../../components/FaqSchema.astro';
import Cta from '../../../components/Cta.astro';
import { hrefCa as href } from '../../../lib/site';

const protegemos = [
  {
    titulo: 'Assistents i agents d’IA',
    texto:
      'Els provem com un atacant: instruccions internes, preus que no hauria de donar, dades de clients a les quals arriba i què fa quan el treuen del guió.',
  },
  {
    titulo: 'Dades que surten de l’empresa',
    texto:
      'Què enganxa el teu equip en eines públiques, amb quins permisos i amb quin contracte. Una política d’ús d’IA que la gent compleix perquè és curta.',
  },
  {
    titulo: 'Pagaments i accessos',
    texto:
      'Suplantació de proveïdors, canvis de compte bancari per correu i accessos sense segon factor. El que es detecta abans de pagar no es recupera després.',
  },
];

const fugas = [
  {
    titulo: 'Les instruccions internes',
    texto:
      'El system prompt complet: com se li ha dit al bot que es comporti, què no ha de dir i amb quines dades treballa. És el mapa per a tota la resta.',
  },
  {
    titulo: 'Preus, descomptes i marges',
    texto:
      'Rangs d’honoraris, condicions especials i llindars de negociació que són al context del bot perquè s’hi van incloure per millorar les seves respostes.',
  },
  {
    titulo: 'Dades de clients',
    texto:
      'Si el chatbot consulta un CRM, un històric de comandes o una base de coneixement amb dades reals, se li pot demanar que en parli.',
  },
  {
    titulo: 'Comportament fora de guió',
    texto:
      'Amb una injecció d’instruccions, el bot de la teva web pot acabar dient el que decideixi un tercer. Ho fa sota la imatge de la teva marca.',
  },
  {
    titulo: 'Promeses que no pots complir',
    texto:
      'Terminis, garanties i condicions inventades sobre la marxa. Un chatbot al teu domini és la teva veu, i el que afirma té efecte davant del client.',
  },
  {
    titulo: 'Accés a eines connectades',
    texto:
      'Quan l’agent pot reservar, consultar o escriure als teus sistemes, la pregunta deixa de ser què explica i passa a ser què fa.',
  },
];

const pasosIa = [
  {
    titulo: 'Detecció',
    texto:
      'Recorrem la teva web com ho faria un visitant i localitzem els assistents amb IA publicats, inclosos els que màrqueting va publicar sense informar el departament de sistemes.',
  },
  {
    titulo: 'Proves',
    texto:
      'Llancem una bateria de proves de fuita sobre cada assistent: extracció d’instruccions, condicions comercials, dades personals, injecció d’instruccions i sortida de guió.',
  },
  {
    titulo: 'Informe',
    texto:
      'Cada resposta es puntua contra una rúbrica i ha de citar el fragment exacte que constitueix la fuita. Sense aquest fragment, no ho comptem com a troballa.',
  },
  {
    titulo: 'Remediació',
    texto:
      'Reescrivim el system prompt, posem baranes i filtres de sortida, acotem el que l’agent pot consultar i deixem proves de regressió perquè no es torni a obrir.',
  },
];

const entregables = [
  {
    etiqueta: 'Gratuït',
    titulo: 'Escaneig inicial',
    texto:
      'Un informe d’una pàgina amb el que es veu des de fora: severitat global i categories de fuita detectades. Suficient per saber si tens un problema i de quina mida.',
  },
  {
    etiqueta: 'Preu tancat per abast',
    titulo: 'Auditoria i remediació',
    texto:
      'El detall reproduïble de cada troballa, amb la conversa exacta i la recomanació tècnica, i la correcció amb el teu proveïdor o amb nosaltres.',
  },
  {
    etiqueta: 'Opcional',
    titulo: 'Vigilància contínua',
    texto:
      'Repetim l’escaneig cada mes. Canviar el system prompt o afegir una font a l’assistent pot reobrir el que estava tancat.',
  },
];

const queHacemos = [
  {
    etiqueta: 'Coneixement',
    texto:
      'Conscienciació a mida (phishing, suplantació, canvi d’IBAN), simulacres de frau i exercicis de taula, i guies breus de bones pràctiques, inclòs l’ús responsable d’eines d’IA.',
  },
  {
    etiqueta: 'Consultoria',
    texto:
      'Diagnòstic amb pla prioritzat (què tancar primer, què pot esperar), preparació per a NIS2, ENS i RGPD, i pla de resposta a incidents amb rols i contactes, amb acompanyament si arriba.',
  },
  {
    etiqueta: 'Desenvolupament',
    texto:
      'Hardening d’equips, comptes, correu i núvol. Desenvolupament segur d’aplicacions i automatitzacions, amb revisió de codi i dependències, i seguretat de sistemes amb IA.',
  },
];

const problemas = [
  { frase: 'Ens va arribar un correu del proveïdor amb un IBAN nou i quasi paguem.', causa: 'Frau de suplantació i canvi de compte' },
  { frase: 'No sé si estem exposats ni per on començar.', causa: 'Manca de visibilitat i de prioritats' },
  { frase: 'Ens demanen NIS2 o ENS i no sabem si ens afecta.', causa: 'Normativa sense traduir a tasques' },
  { frase: 'Si ens ataquen demà, ningú sap què fer.', causa: 'Sense pla, sense responsables i sense còpies provades' },
  { frase: 'Hem posat un assistent amb IA i ningú l’ha revisat.', causa: 'Eines fora del radar d’IT' },
];

const pasos = [
  { titulo: 'Escoltem', texto: 'El teu negoci, els teus sistemes i què no et pots permetre perdre.' },
  { titulo: 'Diagnostiquem', texto: 'Accessos, correu, còpies, proveïdors i sistemes amb IA, només amb autorització expressa.' },
  { titulo: 'Prioritzem i corregim', texto: 'Pla per risc i esforç. El que podem tancar, ho tanquem.' },
  { titulo: 'Deixem criteri', texto: 'Formació i documentació perquè no depenguis de nosaltres.' },
];

const paraQuien = [
  'Gerents de pime que volen reduir el risc de frau sense convertir-se en tècnics.',
  'Responsables d’IT amb poc equip que necessiten segon criteri, pla i suport en preparació normativa.',
  'Administració pública i entitats vinculades que s’han d’alinear amb ENS i NIS2.',
];

const faq = [
  {
    pregunta: 'La meva pime és un objectiu real?',
    respuesta:
      'Sí. Els atacs automatitzats no distingeixen mides i el frau per correu busca empreses amb processos poc verificats.',
  },
  {
    pregunta: 'M’afecta NIS2 o l’ENS?',
    respuesta:
      'Depèn del teu sector i de si prestes serveis a entitats obligades. El diagnòstic ho aclareix i et preparem per al que correspongui.',
  },
  {
    pregunta: 'Feu proves intrusives?',
    respuesta: 'Només amb autorització per escrit i abast acordat.',
  },
  {
    pregunta: 'I si ja hem tingut un incident?',
    respuesta:
      'T’ajudem a contenir-lo, a entendre què va passar i a complir els avisos obligatoris.',
  },
  {
    pregunta: 'Quina informació se li pot treure a un chatbot d’empresa?',
    respuesta:
      'Les seves instruccions internes, preus i condicions, dades de clients si consulta un CRM, i respostes fora de guió sota la teva marca.',
  },
  {
    pregunta: 'Quant triga l’escaneig inicial d’un assistent?',
    respuesta:
      'Dies laborables i sense tocar els teus sistemes: només el que es veu des de fora. Per a la remediació necessitem l’accés mínim, acordat per escrit.',
  },
  {
    pregunta: 'És compatible amb el RGPD?',
    respuesta:
      'Sí: l’informe assenyala quines dades personals exposa l’assistent i com es corregeix.',
  },
];
---

<Base
  title="Ciberseguretat per a pimes"
  description="Ciberseguretat per a pimes que usen IA: auditem els teus assistents, les dades que surten i els pagaments que entren. Escaneig inicial gratuït i preu tancat."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>Ciberseguretat</p>
        <h1
          class="mt-7 max-w-[20ch] font-display text-[clamp(36px,4.6vw,60px)] font-extralight leading-[1.04] tracking-[-0.035em]"
          data-reveal
        >
          La IA obre portes noves. <span class="font-semibold text-oro-oscuro">Nosaltres les tanquem.</span>
        </h1>
        <p class="mt-8 max-w-[54ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
          Publicar un assistent amb IA o connectar una eina a les teves dades és ràpid. Comprovar què
          s’escapa per aquí és el que gairebé ningú fa. Ajudem pimes i administracions a saber on són
          exposades i a tancar el que és important, sense argot ni por.
        </p>
        <div class="mt-12 flex flex-wrap gap-4" data-reveal>
          <Boton href={href('/contacto/')}>Reservar diagnòstic →</Boton>
          <Boton href="#como-trabajamos" variante="linea">Veure com treballem</Boton>
        </div>
      </div>
      <HeroFoto foto="despachos" alt="Persona signant un document" class="lg:col-span-5" />
    </div>
  </section>

  <!-- Qué protegemos -->
  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Què protegim</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Tres fronts on la IA i el frau es troben amb la teva empresa.
        </h2>
      </div>
      <ul class="mt-16 grid gap-10 md:grid-cols-3" role="list">
        {
          protegemos.map((p, i) => (
            <li class="border-t border-linea pt-8" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-4 font-display text-[20px] font-semibold leading-[1.3]">{p.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{p.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Asistentes de IA -->
  <section id="asistentes-ia" class="hairline scroll-mt-[68px]">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Assistents d’IA</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          El teu chatbot revela més informació de la que creus.
        </h2>
        <p class="mt-6 text-[17px] text-pizarra">
          No cal ser un atacant sofisticat: n’hi ha prou de formular les preguntes adequades. En el nostre
          rastreig de webs espanyoles, alguns dels assistents amb IA trobats van deixar escapar alguna cosa en
          provar-los a fons, amb una segona revisió adversa sobre cada troballa. Ningú va vulnerar res: només
          calia escriure al xat.
        </p>
        <a
          href={href('/estudio-asistentes-ia/')}
          class="mt-5 inline-block font-mono text-[12px] text-oro-oscuro transition-colors hover:text-tinta"
        >
          Veure l’estudi complet amb les dades →
        </a>
      </div>

      <ul class="mt-16 grid gap-x-12 gap-y-12 md:grid-cols-2 lg:grid-cols-3" role="list">
        {
          fugas.map((f, i) => (
            <li data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-4 font-display text-[19px] font-semibold leading-[1.3]">{f.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{f.texto}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-24 max-w-[62ch]" data-reveal>
        <h3 class="font-display text-[clamp(24px,3vw,34px)] font-extralight leading-[1.15] tracking-[-0.03em]">
          Quatre passos per auditar els teus assistents.
        </h3>
      </div>
      <ol class="mt-10 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea md:grid-cols-2" role="list">
        {
          pasosIa.map((p, i) => (
            <li class="bg-panel p-8 md:p-10" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{String(i + 1).padStart(2, '0')}</span>
              <h4 class="mt-4 font-display text-[20px] font-semibold leading-[1.3]">{p.titulo}</h4>
              <p class="mt-3 text-[15px] text-pizarra">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Qué te llevas -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow text-oro-luz">Què t’emportes</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          L’escaneig inicial és gratuït. La correcció de les vulnerabilitats, amb preu tancat.
        </h2>
        <p class="mt-6 text-[15px] text-marfil/70">
          És un diagnòstic, no un atac. Parlem amb l’assistent com ho faria qualsevol visitant, des de
          la web pública i a un ritme limitat. No entrem en sistemes ni toquem res que no estigui publicat, i
          les troballes només es mostren al responsable de l’empresa.
        </p>
      </div>
      <ul class="mt-16 grid gap-10 md:grid-cols-3" role="list">
        {
          entregables.map((e) => (
            <li class="border-t border-marfil/15 pt-8" data-reveal>
              <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-oro-luz">{e.etiqueta}</span>
              <h3 class="mt-4 font-display text-[20px] font-semibold leading-[1.3]">{e.titulo}</h3>
              <p class="mt-3 text-[15px] text-marfil/70">{e.texto}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-12" data-reveal>
        <Boton href={href('/contacto/')}>Demanar l’escaneig gratuït →</Boton>
      </div>
    </div>
  </section>

  <!-- Conocimiento, consultoría y desarrollo -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Què fem</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Coneixement, consultoria i desenvolupament.
        </h2>
      </div>
      <ul class="mt-16 grid gap-10 md:grid-cols-3" role="list">
        {
          queHacemos.map((q) => (
            <li class="border-t border-linea pt-8" data-reveal>
              <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-oro-oscuro">{q.etiqueta}</span>
              <p class="mt-4 text-[15px] text-pizarra">{q.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Problemas que resolvemos -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Problemes que resolem</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Si et sona alguna d’aquestes frases, parlem-ne.
        </h2>
      </div>
      <ul class="md:col-span-7" role="list">
        {
          problemas.map((p) => (
            <li class="border-t border-linea py-6 first:border-t-0 first:pt-0" data-reveal>
              <p class="font-display text-[18px] font-semibold leading-[1.35]">«{p.frase}»</p>
              <p class="mt-2 font-mono text-[12px] text-pizarra">{p.causa}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Cómo trabajamos -->
  <section id="como-trabajamos" class="hairline scroll-mt-[68px]">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Com treballem</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Quatre passos, de la conversa al criteri propi.
        </h2>
      </div>
      <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          pasos.map((p, i) => (
            <li class="border-t border-linea pt-6" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-4 font-display text-[19px] font-semibold">{p.titulo}</h3>
              <p class="mt-3 text-[15px] text-pizarra">{p.texto}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-12 max-w-[62ch] font-mono text-[12px] leading-[1.7] text-pizarra" data-reveal>
        El diagnòstic general parteix de la <a class="text-oro-oscuro underline underline-offset-4" href={href('/servicios/diagnostico/')}>conversa inicial de 30 minuts</a>.
      </p>
    </div>
  </section>

  <!-- Para quién -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Per a qui</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Pensat per a qui no es pot dedicar només a això.
        </h2>
      </div>
      <ul class="space-y-5 text-[17px] text-pizarra md:col-span-7" role="list" data-reveal>
        {paraQuien.map((t) => <li class="border-t border-linea pt-5 first:border-t-0 first:pt-0">{t}</li>)}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="hairline">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Preguntes freqüents</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          El que més ens pregunten abans de començar
        </h2>
      </div>
      <div class="md:col-span-7" data-reveal>
        {
          faq.map((f) => (
            <details class="group border-t border-linea py-5 last:border-b">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[17px] font-semibold marker:content-none">
                {f.pregunta}
                <span class="mt-1 shrink-0 font-mono text-[14px] text-oro-oscuro transition-transform duration-200 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-[62ch] text-[15px] text-pizarra">{f.respuesta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <FaqSchema faq={faq} />

  <Cta
    titulo="Comença per saber on ets."
    texto="Explica’ns la teva situació i reservem un diagnòstic. Sense compromís, amb un pla clar al final."
    boton="Reservar diagnòstic"
  />
</Base>

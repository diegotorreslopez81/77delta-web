---
/**
 * Home, English version. Same structure and styles as src/pages/index.astro; visible text is
 * translated and internal links go through hrefEn() with the canonical Spanish route.
 */
import Base from '../../layouts/Base.astro';
import { site, hrefEn as href } from '../../lib/site';
import { casos } from '../../data/casos-de-uso';

const familias = [
  { slug: 'conversacional', num: '01', titulo: 'Conversational assistants', texto: 'Chatbots and voice assistants for web, WhatsApp and phone, with search across your own information, handover to a human and conversation analytics. Customer service, healthcare, training and internal support.' },
  { slug: 'agentes', num: '02', titulo: 'Autonomous agents', texto: 'Agents that run real processes: they query internal systems, answer business questions from your data, monitor, test and prospect. Every step is fully logged so it can be audited.' },
  { slug: 'rag', num: '03', titulo: 'Search and knowledge', texto: 'Semantic search across your intranet, your regulations or your recordings. Role-based access control, mandatory source citation in every answer and incremental indexing.' },
  { slug: 'workflow', num: '04', titulo: 'Process automation', texto: 'Integration between disconnected systems, incident management, multichannel communication, automatic reports and technical proposals for tenders.' },
  { slug: 'governance', num: '05', titulo: 'Governance and compliance', texto: 'Governance of AI systems under the EU AI Act, ALTAI audits and multi-framework compliance with GDPR, NIS2 and accessibility standards. The mandatory documentation is generated automatically.' },
  { slug: 'seguridad', num: '06', titulo: 'AI security', texto: 'Auditing and hardening of the assistants you already have live: what information can be extracted, how, and how to fix it. Includes adversarial testing, guardrails and ongoing monitoring.' },
  { slug: 'verticales', num: '07', titulo: 'Vertical platforms and synthetic data', texto: 'Industry-specific AI platforms (insurance, legal, healthcare, business acceleration), digital simulation and privacy-preserving synthetic data generation.' },
  { slug: 'modelos', num: '08', titulo: 'Custom models and forecasting', texto: 'Fine-tuning of open models for a vertical, forecasting and anomaly detection, supervised classification, bespoke document recognition and model evaluation.' },
];
---

<Base title="" description={site.descripcionEn}>
<div class="home">
<!-- HERO -->
<section class="hero">
  <div class="cont">
    <div class="grid">
      <div>
        <div class="pill"><span class="badge"></span>Accredited by ACCIÓ</div>
        <h1>We use AI to <em>cut your company's costs</em>.</h1>
        <p class="lead">Technology consultancy for SMEs. A free assessment, AI-driven operational transformation and an ongoing technology partner.</p>
        <div class="ctas">
          <a href={href('/contacto/')} class="btn-primary" data-umami-event="reservar" data-umami-event-pagina={Astro.url.pathname} data-umami-event-lugar="hero">Book a free assessment <span>→</span></a>
          <a href={href('/servicios/')} class="btn-ghost">See how we work</a>
        </div>
      </div>
      <div class="photo">
        <img src="/img/fotos/equipo-1600.webp" alt="Professional team at work" srcset="/img/fotos/equipo-900.webp 900w, /img/fotos/equipo-1600.webp 1600w" sizes="(min-width: 900px) 50vw, 100vw" fetchpriority="high" decoding="async">
      </div>
    </div>
  </div>
</section>

<!-- PROBLEMA -->
<!-- PRUEBA SOCIAL -->
<section class="proof">
  <div class="cont">
    <p class="proof-txt">Over seven years applying AI with sound judgement for leading institutions and corporations</p>
    <div class="proof-logos">
      <a href="https://www.accio.gencat.cat" target="_blank" rel="noopener"><img src="/img/logos/accio.png" alt="ACCIÓ" loading="lazy"></a>
      <a href="https://www.gencat.cat" target="_blank" rel="noopener"><img src="/img/logos/gencat.svg" alt="Generalitat de Catalunya" loading="lazy"></a>
      <a href="https://www.bancsabadell.com" target="_blank" rel="noopener"><img src="/img/logos/sabadell.png" alt="Banc Sabadell" loading="lazy"></a>
      <a href="https://futurium.ec.europa.eu" target="_blank" rel="noopener"><img src="/img/logos/futurium.svg" alt="European Commission" loading="lazy"></a>
      <a href="https://i2cat.net" target="_blank" rel="noopener"><img src="/img/logos/i2cat.svg" alt="i2CAT" loading="lazy"></a>
      <a href="https://barcelonactiva.cat" target="_blank" rel="noopener"><img src="/img/logos/barcelona-activa.png" alt="Barcelona Activa" loading="lazy"></a>
      <a href="https://aws.amazon.com" target="_blank" rel="noopener"><img src="/img/logos/aws.svg" alt="Amazon Web Services" loading="lazy"></a>
    </div>
    <a href="#confianza" class="proof-mas">See all organisations <span>&#8594;</span></a>
  </div>
</section>

<section class="problem">
  <div class="cont">
    <div class="grid">
      <div class="photo">
        <img src="/img/fotos/gerente-1600.webp" alt="SME manager reviewing reports" srcset="/img/fotos/gerente-900.webp 900w, /img/fotos/gerente-1600.webp 1600w" sizes="(min-width: 900px) 50vw, 100vw" loading="lazy" decoding="async">
      </div>
      <div>
        <span class="section-tag">The problem</span>
        <h2>Artificial intelligence is reshaping your industry. <em>The question is not whether it will affect you, but how to use it well.</em></h2>
        <p class="lead">There is plenty of information out there, but telling what will genuinely transform your business from what merely looks impressive takes judgement and experience. The change is not only technological. It touches processes, teams and the way decisions get made.</p>
        <p class="questions">Which repetitive tasks eat up your team's day? Which decisions are taken without enough data? Which areas are overstretched? What happens when a key person is away? What does it really cost to start, and how is the return measured?</p>
      </div>
    </div>
  </div>
</section>

<!-- SERVICIOS -->
<section class="services" id="servicios">
  <div class="cont">
    <div class="section-head">
      <span class="section-tag">How we work</span>
      <h2>We start with an assessment. Then you choose the way forward.</h2>
      <p>Every company is different. The process is simple: first we understand how your business really works, then we deliver the transformation and, if you wish, we stay on as your technology partner for the medium and long term.</p>
    </div>

    <div class="svc-featured">
      <img src="/img/fotos/diagnostico-1600.webp" alt="Initial assessment" srcset="/img/fotos/diagnostico-900.webp 900w, /img/fotos/diagnostico-1600.webp 1600w" sizes="100vw" loading="lazy" decoding="async">
      <div class="content">
        <div class="text-panel">
          <span class="badge">FIRST STEP · FREE · 30 MIN</span>
          <h3>Assessment</h3>
          <p>A structured 30-minute interview and a short form so we can understand how your business works. You receive a tailored proposal covering where your company stands today, a work plan and a budget. No obligation.</p>
          <a href={href('/servicios/diagnostico/')} class="arrow-btn">See the assessment <span>→</span></a>
        </div>
      </div>
    </div>

    <div class="svc-grid">
      <a href={href('/servicios/transformacion/')} class="svc-card">
        <div class="num">02 · Tailor-made project</div>
        <h3>Operational transformation with AI</h3>
        <p>After the assessment, we deliver the agreed proposal: implementation, integration with your systems, process automation and training for your team. Everything the transformation requires. The investment is set out in the proposal and matched to the scope.</p>
        <div class="price"><span>Bespoke quote in the proposal</span><span class="arrow">→</span></div>
      </a>
      <a href={href('/servicios/partner/')} class="svc-card">
        <div class="num">03 · Ongoing support</div>
        <h3>Technology partner</h3>
        <p>A technical partner for all of your company's technology, not just AI: bespoke software, integration, CRM and ERP, Microsoft, cloud, cybersecurity, hardware and on-site infrastructure, web, data and R&D. A single point of contact who deals with your suppliers as an equal and makes decisions with you.</p>
        <div class="price"><span>Scope and budget tailored to you</span><span class="arrow">→</span></div>
      </a>
    </div>
  </div>
</section>

<!-- DIRECTOR DE IA · SERVICIO PRINCIPAL -->
<section class="director" id="director-ia">
  <div class="cont">
    <div class="director-panel">
      <div class="director-head">
        <span class="section-tag">Main service · Fixed monthly fee</span>
        <h2>Your fractional AI director, <em>from €1,200 a month</em>.</h2>
        <p class="lead">One morning a month on site with your technical lead, and the rest of the work done remotely. Every month, one fewer manual process and a report on the hours saved.</p>
      </div>
      <ul class="director-paquetes" role="list">
        <li><span class="nombre">Base</span><span class="precio">€1,200/month</span><span class="detalle">One morning on site and 4 remote hours.</span></li>
        <li><span class="nombre">Advance</span><span class="precio">€2,400/month</span><span class="detalle">Two mornings on site and 10 remote hours.</span></li>
        <li><span class="nombre">Intensive</span><span class="precio">€3,600/month</span><span class="detalle">One morning a week on site and 14 remote hours.</span></li>
      </ul>
      <div class="director-pie">
        <div>
          <p class="garantia"><strong>Guarantee:</strong> if by the third month the savings are not at least twice the fee, you can cancel the contract at no cost.</p>
          <p class="nota">Prices exclude VAT. Annual contract, fixed monthly fee.</p>
        </div>
        <a href={href('/servicios/director-ia/')} class="btn-primary">See the service <span>→</span></a>
      </div>
    </div>
  </div>
</section>

<!-- SEGURIDAD DE IA -->
<section class="aisec" id="seguridad">
  <div class="cont">
    <div class="aisec-grid">
      <div>
        <span class="section-tag">AI security</span>
        <h2>Your chatbot <em>reveals more than you think.</em></h2>
        <p>Putting an AI assistant on your website is quick. Auditing it is rare. We test it the way an attacker would and show you what it gives away: its internal instructions, prices it should not quote, the customer data it can reach and what it says when pushed off script.</p>
        <p class="aisec-nota">We do it with LeakAI, the tool we built for this. In September 2026 we used it to scan 391 Spanish websites, and we continue to audit in depth the AI assistants we find. The assessment is free. The paid service is fixing the vulnerabilities we uncover.</p>
        <p class="aisec-nota"><a href={href('/estudio-asistentes-ia/')} class="aisec-enlace">See the study with the data &#8594;</a></p>
        <div class="ctas">
          <a href={href('/servicios/seguridad-ia/')} class="btn-primary">Request a free scan <span>&#8594;</span></a>
          <a href={href('/productos/#leakai')} class="btn-ghost">Discover LeakAI</a>
        </div>
      </div>

      <aside class="aisec-informe" aria-label="Sample basic report">
        <div class="aisec-informe-cab">
          <span>Basic report</span>
          <span class="aisec-ejemplo">Example</span>
        </div>
        <ul>
          <li><span class="q">Instruction extraction</span><span class="s s3">Critical</span></li>
          <li><span class="q">Prices and terms</span><span class="s s2">High</span></li>
          <li><span class="q">Customer data</span><span class="s s1">Medium</span></li>
          <li><span class="q">Prompt injection</span><span class="s s2">High</span></li>
          <li><span class="q">Off-script behaviour</span><span class="s s1">Medium</span></li>
        </ul>
        <p class="aisec-pie">Every finding comes with the exact excerpt of the conversation that proves it.</p>
      </aside>
    </div>
  </div>
</section>

<!-- SECTORES -->
<section class="sectors" id="sectores">
  <div class="cont">
    <div class="section-head">
      <span class="section-tag">Industries</span>
      <h2>Six industries. One methodology.</h2>
      <p>In each one we apply a proven methodology. The technology is only the visible part. What really changes is how your team works.</p>
    </div>
    <div class="sec-grid">
      <a href={href('/sectores/clinicas/')} class="sec-card">
        <img src="/img/fotos/clinicas-900.webp" alt="Clinics" loading="lazy" decoding="async">
        <div class="content">
          <div class="num">Sector 01</div>
          <h3>Clinics and health centres</h3>
          <p>We rethink reception, scheduling, patient follow-up and clinical traceability.</p>
          <span class="arrow">See sector cases →</span>
        </div>
      </a>
      <a href={href('/sectores/industria/')} class="sec-card">
        <img src="/img/fotos/industria-900.webp" alt="Industry" loading="lazy" decoding="async">
        <div class="content">
          <div class="num">Sector 02</div>
          <h3>Industry and workshops</h3>
          <p>We transform quoting, maintenance and quality control across your production processes.</p>
          <span class="arrow">See sector cases →</span>
        </div>
      </a>
      <a href={href('/sectores/distribucion/')} class="sec-card">
        <img src="/img/fotos/distribucion-900.webp" alt="Distribution" loading="lazy" decoding="async">
        <div class="content">
          <div class="num">Sector 03</div>
          <h3>Distribution and logistics</h3>
          <p>We rethink how orders come in, how stock is checked and how your sales reps work.</p>
          <span class="arrow">See sector cases →</span>
        </div>
      </a>
      <a href={href('/sectores/despachos/')} class="sec-card">
        <img src="/img/fotos/despachos-900.webp" alt="Professional firms" loading="lazy" decoding="async">
        <div class="content">
          <div class="num">Sector 04</div>
          <h3>Professional firms</h3>
          <p>We free up senior staff time by automating repetitive documents and archive searches.</p>
          <span class="arrow">See sector cases →</span>
        </div>
      </a>
      <a href={href('/sectores/administracion/')} class="sec-card">
        <img src="/img/fotos/administracion-900.webp" alt="Public administration" loading="lazy" decoding="async">
        <div class="content">
          <div class="num">Sector 05</div>
          <h3>Public administration</h3>
          <p>We transform public-facing services, document management and the analysis of historical case files.</p>
          <span class="arrow">See sector cases →</span>
        </div>
      </a>
      <a href={href('/sectores/formacion/')} class="sec-card">
        <img src="/img/fotos/formacion-900.webp" alt="Training" loading="lazy" decoding="async">
        <div class="content">
          <div class="num">Sector 06</div>
          <h3>Training and human resources</h3>
          <p>We change how people are assessed, how they are onboarded and how learner progress is tracked.</p>
          <span class="arrow">See sector cases →</span>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- CASO DESTACADO · CARRUSEL ROTATIVO 5 CASOS -->
<!-- CAPACIDADES -->
<section class="caps" id="capacidades">
  <div class="cont">
    <div class="section-head">
      <span class="section-tag">What we can do</span>
      <h2>{casos.length} catalogued capabilities in eight families.</h2>
      <p>From conversational assistants to AI security, via agents, search across your documentation, process automation, EU compliance and custom models. All of them are running in production in real businesses. The examples are representative and anonymised.</p>
    </div>
    <ul class="caps-grid">
      {
        familias.map((f) => (
          <li>
            <a href={`${href('/casos-de-uso/')}?familia=${f.slug}`}>
              <span class="num">{f.num}</span>
              <h3>{f.titulo}</h3>
              <p>{f.texto}</p>
              <span class="cuenta">{casos.filter((c) => c.familia === f.slug).length} capabilities</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a href={href('/casos-de-uso/')} class="caps-link">Browse and filter the full catalogue <span>&#8594;</span></a>
  </div>
</section>

<section class="case" id="casos">
  <div class="slides">

    <!-- Slide 1 · Clínicas dentales -->
    <div class="slide active" data-slide="0">
      <img class="bg" src="/img/fotos/clinicas-1600.webp" alt="Modern clinic" srcset="/img/fotos/clinicas-900.webp 900w, /img/fotos/clinicas-1600.webp 1600w" sizes="100vw" loading="lazy" decoding="async">
      <div class="content"><div class="cont"><div class="grid">
        <div>
          <div class="big">38<span class="pct">%</span></div>
          <div class="label">fewer no-shows at appointments</div>
        </div>
        <div>
          <span class="section-tag">Case 1 of 5 · Dental clinics · Barcelona</span>
          <h3>Three dental clinics shared the same problem.</h3>
          <p>Many patients missed appointments without warning. Reception had no time for confirmation calls.</p>
          <p>In four weeks we rolled out Contestia, a virtual receptionist on WhatsApp. It paid for itself in under a month.</p>
          <a href={href('/historias-de-exito/clinicas-dentales-barcelona/')} class="arrow-btn">Read the full case <span>→</span></a>
        </div>
      </div></div></div>
    </div>

    <!-- Slide 2 · Distribuidora industrial -->
    <div class="slide" data-slide="1">
      <img class="bg" src="/img/fotos/distribucion-1600.webp" alt="Industrial distributor" srcset="/img/fotos/distribucion-900.webp 900w, /img/fotos/distribucion-1600.webp 1600w" sizes="100vw" loading="lazy" decoding="async">
      <div class="content"><div class="cont"><div class="grid">
        <div>
          <div class="big">2<span class="pct">h</span></div>
          <div class="label">saved per sales rep per day</div>
        </div>
        <div>
          <span class="section-tag">Case 2 of 5 · Industrial distribution · Catalonia</span>
          <h3>12 sales reps were losing two hours a day to manual order entry.</h3>
          <p>Orders came in by WhatsApp, phone and email, and the reps spent the first two hours of every day keying them into the ERP.</p>
          <p>We connected an AI assistant to the main WhatsApp line: it identifies the customer, recognises product references, checks stock and creates the order. The sales rep only steps in for exceptions.</p>
          <a href={href('/historias-de-exito/distribuidora-industrial/')} class="arrow-btn">Read the full case <span>→</span></a>
        </div>
      </div></div></div>
    </div>

    <!-- Slide 3 · Despacho de abogados -->
    <div class="slide" data-slide="2">
      <img class="bg" src="/img/fotos/despachos-1600.webp" alt="Law firm" srcset="/img/fotos/despachos-900.webp 900w, /img/fotos/despachos-1600.webp 1600w" sizes="100vw" loading="lazy" decoding="async">
      <div class="content"><div class="cont"><div class="grid">
        <div>
          <div class="big">20<span class="pct">h</span></div>
          <div class="label">freed up per senior partner per month</div>
        </div>
        <div>
          <span class="section-tag">Case 3 of 5 · Commercial law · Madrid</span>
          <h3>An 18-strong firm kept reworking the same five contract templates.</h3>
          <p>Each senior partner spent 4 to 6 hours a week drafting and reviewing contracts that were variations of the same templates.</p>
          <p>We built a contract generator based on their templates. Average client turnaround fell from 3 days to 6 hours.</p>
          <a href={href('/historias-de-exito/despacho-mercantil/')} class="arrow-btn">Read the full case <span>→</span></a>
        </div>
      </div></div></div>
    </div>

    <!-- Slide 4 · Taller industrial -->
    <div class="slide" data-slide="3">
      <img class="bg" src="/img/fotos/industria-1600.webp" alt="Industrial workshop" srcset="/img/fotos/industria-900.webp 900w, /img/fotos/industria-1600.webp 1600w" sizes="100vw" loading="lazy" decoding="async">
      <div class="content"><div class="cont"><div class="grid">
        <div>
          <div class="big">45<span class="pct">%</span></div>
          <div class="label">less time on quotes</div>
        </div>
        <div>
          <span class="section-tag">Case 4 of 5 · Metalworking industry · Sabadell</span>
          <h3>Every industrial quote took 3 days in the technical office.</h3>
          <p>Customers sent drawings by email. The technical office worked out materials, labour and margins by hand, and a quote took 3 days to go out.</p>
          <p>We deployed an AI system that reads the drawing, prices the job and suggests margins. The team reviews and approves. Turnaround: 4 hours.</p>
          <a href={href('/sectores/industria/')} class="arrow-btn">See the sector <span>→</span></a>
        </div>
      </div></div></div>
    </div>

    <!-- Slide 5 · Centro formación -->
    <div class="slide" data-slide="4">
      <img class="bg" src="/img/fotos/formacion-1600.webp" alt="Training centre" srcset="/img/fotos/formacion-900.webp 900w, /img/fotos/formacion-1600.webp 1600w" sizes="100vw" loading="lazy" decoding="async">
      <div class="content"><div class="cont"><div class="grid">
        <div>
          <div class="big">3<span class="pct">x</span></div>
          <div class="label">more students supported in tutoring</div>
        </div>
        <div>
          <span class="section-tag">Case 5 of 5 · Vocational training · Valencia</span>
          <h3>A vocational training centre had a month-long waiting list for one-to-one tutoring.</h3>
          <p>Tutors could not keep up with every individual question. Students waited up to a month for a session, which hurt pass rates.</p>
          <p>We built a learning assistant trained on their course material. It answers questions 24/7 and only hands over to a human tutor for complex cases. The waiting list disappeared.</p>
          <a href={href('/sectores/formacion/')} class="arrow-btn">See the sector <span>→</span></a>
        </div>
      </div></div></div>
    </div>

  </div>

  <button class="nav-btn prev" aria-label="Previous case" data-caso-prev>‹</button>
  <button class="nav-btn next" aria-label="Next case" data-caso-next>›</button>

  <div class="dots">
    <button class="dot active" data-caso-ir="0" aria-label="Case 1"></button>
    <button class="dot" data-caso-ir="1" aria-label="Case 2"></button>
    <button class="dot" data-caso-ir="2" aria-label="Case 3"></button>
    <button class="dot" data-caso-ir="3" aria-label="Case 4"></button>
    <button class="dot" data-caso-ir="4" aria-label="Case 5"></button>
  </div>
</section>

<!-- POR QUÉ INFINITE LABS -->
<section class="why">
  <div class="cont">
    <div class="section-head">
      <span class="section-tag">Why 77 Delta</span>
      <h2>Six reasons to trust us</h2>
    </div>
    <div class="why-grid">
      <div class="why-item">
        <div class="icon">01</div>
        <h3>Company-wide transformation, not just technology</h3>
        <p>AI changes processes, teams and the way decisions are made. Installing tools is not enough. We guide your organisation through the whole transformation.</p>
      </div>
      <div class="why-item">
        <div class="icon">02</div>
        <h3>AI augments people, it does not replace them</h3>
        <p>We design every rollout around your team. Human oversight by default: we take repetitive tasks off their plate so they can focus on work that adds value.</p>
      </div>
      <div class="why-item">
        <div class="icon">03</div>
        <h3>We build what we deploy</h3>
        <p>Our own products run in production at real companies. The technology we recommend is proven with active clients.</p>
      </div>
      <div class="why-item">
        <div class="icon">04</div>
        <h3>Data in Europe, compliance guaranteed</h3>
        <p>Our own infrastructure in the EU. GDPR compliant. No reliance on non-EU providers. Support in English, Spanish and Catalan.</p>
      </div>
      <div class="why-item">
        <div class="icon">05</div>
        <h3>Results measured in hours and in sales</h3>
        <p>Every project starts with a quantified estimate: time saved, lower costs, higher output or sales. Monthly reporting with verifiable metrics.</p>
      </div>
      <div class="why-item">
        <div class="icon">06</div>
        <h3>No technology lock-in</h3>
        <p>When the project ends, your company keeps the code, the keys, the data and the documentation. Full independence.</p>
      </div>
    </div>
  </div>
</section>

<!-- SOBRE NOSOTROS PREVIEW -->
<section class="about" id="sobre">
  <div class="cont">
    <div class="grid">
      <div>
        <span class="section-tag">About us</span>
        <h2>A consultancy with a track record, <em>built by people who have lived the problem.</em></h2>
        <p>Over 20 years applying technology in real companies. Accredited by the Government of Catalonia. Clients from Barcelona to Dubai. And one conviction: AI only adds value when it is applied with sound judgement.</p>
        <p>77 Delta grew out of two decades of experience built up by Diego Torres. After supporting more than 500 startups, he noticed a pattern: large companies had strategy consultancies, while SMEs were left struggling to keep pace with technological change. 77 Delta was created to be that trusted partner for your company.</p>
        <p class="signature"><strong>Diego Torres</strong>, founder</p>
        <a href={href('/sobre-nosotros/')} class="arrow-btn">Discover our mission <span>→</span></a>
      </div>
      <div class="photo">

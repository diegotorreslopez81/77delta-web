---
import Base from '../../layouts/Base.astro';
import HeroFoto from '../../components/HeroFoto.astro';
import Boton from '../../components/Boton.astro';
import Icono from '../../components/Icono.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import Cta from '../../components/Cta.astro';
import { href, site } from '../../lib/site';

const queHacemos = [
  {
    etiqueta: 'Conocimiento',
    texto:
      'Qué puede hacer la IA en tu sector y qué no, sin jerga. Formación al equipo con casos de su trabajo diario y criterio sobre qué herramientas y modelos tienen sentido para tu caso.',
  },
  {
    etiqueta: 'Consultoría',
    texto:
      'Mapa de procesos y prioridad donde la IA da un ahorro medible. Plan con fases, plazos y presupuesto orientativo, y un director de IA externo con informe mensual de horas ahorradas.',
  },
  {
    etiqueta: 'Desarrollo',
    texto:
      'Asistentes, agentes y automatizaciones a medida, integrados con tu ERP, CRM, WhatsApp y correo. Al terminar te quedas con el código, las claves, los datos y la documentación.',
  },
];

const servicios = [
  {
    icono: 'piloto',
    etiqueta: 'Cuota fija mensual',
    titulo: 'Director de IA externo',
    texto: 'Una mañana al mes en tu empresa y el resto a distancia, desde 1.200 €/mes.',
    ruta: '/servicios/director-ia/',
  },
  {
    icono: 'diagnostico',
    etiqueta: 'Gratuito',
    titulo: 'Diagnóstico',
    texto: '30 minutos, sin compromiso, con propuesta y plan de trabajo al final.',
    ruta: '/servicios/diagnostico/',
  },
  {
    icono: 'transformacion',
    etiqueta: 'Proyecto',
    titulo: 'Transformación operativa',
    texto: 'Implantación, integración y capacitación de la propuesta acordada.',
    ruta: '/servicios/transformacion/',
  },
  {
    icono: 'medir',
    etiqueta: 'Escaneo gratuito',
    titulo: 'Seguridad de IA',
    texto: 'Auditamos tus asistentes publicados y corregimos lo que se les escapa.',
    ruta: '/ciberseguridad/#asistentes-ia',
  },
  {
    icono: 'partner',
    etiqueta: 'Acompañamiento',
    titulo: 'Partner tecnológico',
    texto: 'Un solo socio técnico para toda la tecnología de tu empresa, no solo la IA.',
    ruta: '/servicios/partner/',
  },
] as const;

const pasos = [
  { titulo: 'Entendemos', texto: 'Entrevista de 30 minutos y un formulario sobre tu realidad.' },
  { titulo: 'Proponemos', texto: 'Estado inicial, plan de trabajo y presupuesto, sin compromiso.' },
  { titulo: 'Construimos', texto: 'Supervisión humana por defecto y tu equipo en el centro.' },
  { titulo: 'Medimos', texto: 'Seguimiento mensual con métricas verificables.' },
];

const faq = [
  {
    pregunta: '¿Por dónde empiezo con la IA en mi pyme?',
    respuesta:
      'Por un diagnóstico de 30 minutos, gratuito y sin compromiso. Entendemos tu operativa, identificamos dónde la IA da un ahorro medible y te devolvemos una propuesta con plan y presupuesto.',
  },
  {
    pregunta: '¿Necesito un equipo técnico propio?',
    respuesta:
      'No. Podemos actuar como tu director de IA externo o como partner tecnológico, y trabajar junto a tu equipo técnico si ya lo tienes.',
  },
  {
    pregunta: '¿Qué me llevo al terminar un proyecto?',
    respuesta:
      'El código, las claves, los datos y la documentación. No quedas atado a nosotros: todo lo construido es tuyo.',
  },
  {
    pregunta: '¿Hay supervisión humana en lo que construís?',
    respuesta:
      'Sí, por defecto. Cada automatización o asistente tiene un responsable humano y un seguimiento mensual con métricas verificables.',
  },
];
---

<Base
  title="Inteligencia artificial para pymes"
  description="Inteligencia artificial para pymes: director de IA externo, diagnóstico, transformación operativa y partner tecnológico. Empieza con 30 minutos gratis."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>Inteligencia artificial</p>
        <h1
          class="mt-7 max-w-[20ch] font-display text-[clamp(36px,4.6vw,60px)] font-extralight leading-[1.04] tracking-[-0.035em]"
          data-reveal
        >
          IA aplicada para que tu empresa <span class="font-semibold text-oro-oscuro">gaste menos</span> y produzca más.
        </h1>
        <p class="mt-8 max-w-[54ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
          Conocimiento, consultoría y desarrollo de IA para pymes. Empezamos por un diagnóstico gratuito de 30
          minutos y tú decides hasta dónde llegar.
        </p>
        <div class="mt-12 flex flex-wrap gap-4" data-reveal>
          <Boton href={href('/contacto/')}>Reservar diagnóstico →</Boton>
          <Boton href="#servicios" variante="linea">Ver los cinco servicios</Boton>
        </div>
      </div>
      <HeroFoto foto="equipo" alt="Equipo de trabajo reunido en una oficina" class="lg:col-span-5" />
    </div>
  </section>

  <!-- Qué hacemos -->
  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Qué hacemos</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Conocimiento, consultoría y desarrollo, en ese orden.
        </h2>
      </div>
      <ul class="mt-16 grid gap-10 md:grid-cols-3" role="list">
        {
          queHacemos.map((q) => (
            <li class="border-t border-linea pt-8" data-reveal>
              <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-oro-oscuro">{q.etiqueta}</span>
              <p class="mt-4 text-[15px] text-pizarra">{q.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Los cinco servicios -->
  <section id="servicios" class="hairline scroll-mt-[68px]">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Los cinco servicios</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Elige uno o combínalos. Todos empiezan por el diagnóstico.
        </h2>
      </div>
      <div class="mt-16 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3 lg:[&>a:last-child]:col-span-2">
        {
          servicios.map((s) => (
            <a
              href={href(s.ruta)}
              class="group flex flex-col bg-panel p-8 transition-colors hover:bg-oro/5 md:p-10"
              data-reveal
            >
              <Icono nombre={s.icono} class="h-8 w-8 text-oro-oscuro" />
              <span class="eyebrow mt-6 text-pizarra">{s.etiqueta}</span>
              <h3 class="mt-3 font-display text-[22px] font-semibold">{s.titulo}</h3>
              <p class="mt-3 flex-1 text-[15px] text-pizarra">{s.texto}</p>
              <span class="mt-8 font-mono text-[12px] text-tinta/80 group-hover:text-oro-oscuro">Ver el detalle →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cómo trabajamos -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow text-oro-luz">Cómo trabajamos</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Cuatro pasos. La decisión es tuya en cada uno.
        </h2>
      </div>
      <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          pasos.map((p, i) => (
            <li class="border-t border-marfil/15 pt-6" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-luz">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-4 font-display text-[19px] font-semibold">{p.titulo}</h3>
              <p class="mt-3 text-[15px] text-marfil/70">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Acreditación ACCIÓ -->
  <section id="cupo" class="hairline scroll-mt-[68px] bg-oro/[0.06]">
    <div class="wrap grid gap-10 py-20 md:grid-cols-12 md:py-24">
      <div class="md:col-span-7" data-reveal>
        <p class="eyebrow">Acreditación</p>
        <h2 class="mt-5 font-display text-[clamp(26px,3.2vw,40px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Proveedor acreditado del Cupó IA de ACCIÓ.
        </h2>
        <p class="mt-6 max-w-[58ch] text-[17px] text-pizarra">
          {site.sociedad} es proveedor acreditado del Cupó IA de ACCIÓ, la agencia de la Generalitat de
          Catalunya para la competitividad empresarial.
        </p>
      </div>
      <div class="self-center md:col-span-5" data-reveal>
        <img
          src={href('/img/logos/accio.png')}
          alt="ACCIÓ, Generalitat de Catalunya"
          width="320"
          height="120"
          loading="lazy"
          decoding="async"
          class="h-14 w-auto"
        />
      </div>
    </div>
  </section>

  <!-- Otras líneas -->
  <section class="hairline">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Las otras líneas</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          La IA no va sola.
        </h2>
      </div>
      <ul class="space-y-6 text-[17px] text-pizarra md:col-span-7" role="list" data-reveal>
        <li>
          La IA necesita datos bien compartidos y gobernados:
          <a class="text-oro-oscuro underline underline-offset-4" href={href('/espacios-de-datos/')}>Espacios de datos</a>
          la alimenta.
        </li>
        <li>
          Un asistente con IA también es una superficie de ataque:
          <a class="text-oro-oscuro underline underline-offset-4" href={href('/ciberseguridad/')}>Ciberseguridad</a>
          lo revisa.
        </li>
        <li>
          La identidad decide quién accede a qué:
          <a class="text-oro-oscuro underline underline-offset-4" href={href('/identidad-digital/')}>Identidad digital</a>
          lo resuelve.
        </li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Lo que más nos preguntan antes de empezar
        </h2>
      </div>
      <div class="md:col-span-7" data-reveal>
        {
          faq.map((f) => (
            <details class="group border-t border-linea py-5 last:border-b">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[17px] font-semibold marker:content-none">
                {f.pregunta}
                <span class="mt-1 shrink-0 font-mono text-[14px] text-oro-oscuro transition-transform duration-200 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-[62ch] text-[15px] text-pizarra">{f.respuesta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <FaqSchema faq={faq} />

  <Cta
    titulo="30 minutos. Sin compromiso. La decisión es tuya."
    texto="Te devolvemos una propuesta con estado inicial, plan de trabajo y presupuesto."
    boton="Reservar diagnóstico"
  />
</Base>

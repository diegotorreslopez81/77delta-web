---
import Base from '../../../layouts/Base.astro';
import HeroFoto from '../../../components/HeroFoto.astro';
import Boton from '../../../components/Boton.astro';
import Icono from '../../../components/Icono.astro';
import FaqSchema from '../../../components/FaqSchema.astro';
import Cta from '../../../components/Cta.astro';
import { hrefCa as href, site } from '../../../lib/site';

const queHacemos = [
  {
    etiqueta: 'Coneixement',
    texto:
      'Què pot fer la IA al teu sector i què no, sense argot. Formació a l’equip amb casos de la seva feina diària i criteri sobre quines eines i models tenen sentit per al teu cas.',
  },
  {
    etiqueta: 'Consultoria',
    texto:
      'Mapa de processos i prioritat allà on la IA dona un estalvi mesurable. Pla amb fases, terminis i pressupost orientatiu, i un director d’IA extern amb informe mensual d’hores estalviades.',
  },
  {
    etiqueta: 'Desenvolupament',
    texto:
      'Assistents, agents i automatitzacions a mida, integrats amb el teu ERP, CRM, WhatsApp i correu. En acabar, et quedes amb el codi, les claus, les dades i la documentació.',
  },
];

const servicios = [
  {
    icono: 'piloto',
    etiqueta: 'Quota fixa mensual',
    titulo: 'Director d’IA extern',
    texto: 'Un matí al mes a la teva empresa i la resta a distància, des de 1.200 €/mes.',
    ruta: '/servicios/director-ia/',
  },
  {
    icono: 'diagnostico',
    etiqueta: 'Gratuït',
    titulo: 'Diagnòstic',
    texto: '30 minuts, sense compromís, amb proposta i pla de treball al final.',
    ruta: '/servicios/diagnostico/',
  },
  {
    icono: 'transformacion',
    etiqueta: 'Projecte',
    titulo: 'Transformació operativa',
    texto: 'Implantació, integració i capacitació de la proposta acordada.',
    ruta: '/servicios/transformacion/',
  },
  {
    icono: 'medir',
    etiqueta: 'Escaneig gratuït',
    titulo: 'Seguretat d’IA',
    texto: 'Auditem els teus assistents publicats i corregim el que se’ls escapa.',
    ruta: '/ciberseguretat/#asistentes-ia',
  },
  {
    icono: 'partner',
    etiqueta: 'Acompanyament',
    titulo: 'Soci tecnològic',
    texto: 'Un sol soci tècnic per a tota la tecnologia de la teva empresa, no només la IA.',
    ruta: '/servicios/partner/',
  },
] as const;

const pasos = [
  { titulo: 'Entenem', texto: 'Entrevista de 30 minuts i un formulari sobre la teva realitat.' },
  { titulo: 'Proposem', texto: 'Estat inicial, pla de treball i pressupost, sense compromís.' },
  { titulo: 'Construïm', texto: 'Supervisió humana per defecte i el teu equip al centre.' },
  { titulo: 'Mesurem', texto: 'Seguiment mensual amb mètriques verificables.' },
];

const faq = [
  {
    pregunta: 'Per on començo amb la IA a la meva pime?',
    respuesta:
      'Per un diagnòstic de 30 minuts, gratuït i sense compromís. Entenem la teva operativa, identifiquem on la IA dona un estalvi mesurable i et retornem una proposta amb pla i pressupost.',
  },
  {
    pregunta: 'Necessito un equip tècnic propi?',
    respuesta:
      'No. Podem actuar com el teu director d’IA extern o com a soci tecnològic, i treballar amb el teu equip tècnic si ja el tens.',
  },
  {
    pregunta: 'Què m’emporto en acabar un projecte?',
    respuesta:
      'El codi, les claus, les dades i la documentació. No quedes lligat a nosaltres: tot el que construïm és teu.',
  },
  {
    pregunta: 'Hi ha supervisió humana en el que construïu?',
    respuesta:
      'Sí, per defecte. Cada automatització o assistent té un responsable humà i un seguiment mensual amb mètriques verificables.',
  },
];
---

<Base
  title="Intel·ligència artificial per a pimes"
  description="Intel·ligència artificial per a pimes: director d’IA extern, diagnòstic, transformació operativa i soci tecnològic. Comença amb 30 minuts gratuïts."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>Intel·ligència artificial</p>
        <h1
          class="mt-7 max-w-[20ch] font-display text-[clamp(36px,4.6vw,60px)] font-extralight leading-[1.04] tracking-[-0.035em]"
          data-reveal
        >
          IA aplicada perquè la teva empresa <span class="font-semibold text-oro-oscuro">gasti menys</span> i produeixi més.
        </h1>
        <p class="mt-8 max-w-[54ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
          Coneixement, consultoria i desenvolupament d’IA per a pimes. Comencem per un diagnòstic gratuït de 30
          minuts i tu decideixes fins on arribar.
        </p>
        <div class="mt-12 flex flex-wrap gap-4" data-reveal>
          <Boton href={href('/contacto/')}>Reservar diagnòstic →</Boton>
          <Boton href="#servicios" variante="linea">Veure els cinc serveis</Boton>
        </div>
      </div>
      <HeroFoto foto="equipo" alt="Equip de treball reunit en una oficina" class="lg:col-span-5" />
    </div>
  </section>

  <!-- Qué hacemos -->
  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Què fem</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Coneixement, consultoria i desenvolupament, en aquest ordre.
        </h2>
      </div>
      <ul class="mt-16 grid gap-10 md:grid-cols-3" role="list">
        {
          queHacemos.map((q) => (
            <li class="border-t border-linea pt-8" data-reveal>
              <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-oro-oscuro">{q.etiqueta}</span>
              <p class="mt-4 text-[15px] text-pizarra">{q.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Los cinco servicios -->
  <section id="servicios" class="hairline scroll-mt-[68px]">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Els cinc serveis</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Tria’n un o combina’ls. Tots comencen pel diagnòstic.
        </h2>
      </div>
      <div class="mt-16 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3 lg:[&>a:last-child]:col-span-2">
        {
          servicios.map((s) => (
            <a
              href={href(s.ruta)}
              class="group flex flex-col bg-panel p-8 transition-colors hover:bg-oro/5 md:p-10"
              data-reveal
            >
              <Icono nombre={s.icono} class="h-8 w-8 text-oro-oscuro" />
              <span class="eyebrow mt-6 text-pizarra">{s.etiqueta}</span>
              <h3 class="mt-3 font-display text-[22px] font-semibold">{s.titulo}</h3>
              <p class="mt-3 flex-1 text-[15px] text-pizarra">{s.texto}</p>
              <span class="mt-8 font-mono text-[12px] text-tinta/80 group-hover:text-oro-oscuro">Veure el detall →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cómo trabajamos -->
  <section class="hairline bg-marino text-marfil">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow text-oro-luz">Com treballem</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Quatre passos. La decisió és teva en cada un.
        </h2>
      </div>
      <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          pasos.map((p, i) => (
            <li class="border-t border-marfil/15 pt-6" data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-luz">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-4 font-display text-[19px] font-semibold">{p.titulo}</h3>
              <p class="mt-3 text-[15px] text-marfil/70">{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Acreditación ACCIÓ -->
  <section id="cupo" class="hairline scroll-mt-[68px] bg-oro/[0.06]">
    <div class="wrap grid gap-10 py-20 md:grid-cols-12 md:py-24">
      <div class="md:col-span-7" data-reveal>
        <p class="eyebrow">Acreditació</p>
        <h2 class="mt-5 font-display text-[clamp(26px,3.2vw,40px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Proveïdor acreditat del Cupó IA d’ACCIÓ.
        </h2>
        <p class="mt-6 max-w-[58ch] text-[17px] text-pizarra">
          {site.sociedad} és proveïdor acreditat del Cupó IA d’ACCIÓ, l’agència de la Generalitat de
          Catalunya per a la competitivitat empresarial.
        </p>
      </div>
      <div class="self-center md:col-span-5" data-reveal>
        <img
          src={href('/img/logos/accio.png')}
          alt="ACCIÓ, Generalitat de Catalunya"
          width="320"
          height="120"
          loading="lazy"
          decoding="async"
          class="h-14 w-auto"
        />
      </div>
    </div>
  </section>

  <!-- Otras líneas -->
  <section class="hairline">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Les altres línies</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          La IA no va sola.
        </h2>
      </div>
      <ul class="space-y-6 text-[17px] text-pizarra md:col-span-7" role="list" data-reveal>
        <li>
          La IA necessita dades ben compartides i governades:
          <a class="text-oro-oscuro underline underline-offset-4" href={href('/espais-de-dades/')}>Espais de dades</a>
          l’alimenta.
        </li>
        <li>
          Un assistent amb IA també és una superfície d’atac:
          <a class="text-oro-oscuro underline underline-offset-4" href={href('/ciberseguretat/')}>Ciberseguretat</a>
          el revisa.
        </li>
        <li>
          La identitat decideix qui accedeix a què:
          <a class="text-oro-oscuro underline underline-offset-4" href={href('/identitat-digital/')}>Identitat digital</a>
          ho resol.
        </li>
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Preguntes freqüents</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          El que més ens pregunten abans de començar
        </h2>
      </div>
      <div class="md:col-span-7" data-reveal>
        {
          faq.map((f) => (
            <details class="group border-t border-linea py-5 last:border-b">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[17px] font-semibold marker:content-none">
                {f.pregunta}
                <span class="mt-1 shrink-0 font-mono text-[14px] text-oro-oscuro transition-transform duration-200 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-[62ch] text-[15px] text-pizarra">{f.respuesta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <FaqSchema faq={faq} />

  <Cta
    titulo="30 minuts. Sense compromís. La decisió és teva."
    texto="Et retornem una proposta amb estat inicial, pla de treball i pressupost."
    boton="Reservar diagnòstic"
  />
</Base>

---
import Base from '../../layouts/Base.astro';
import HeroFoto from '../../components/HeroFoto.astro';
import Icono from '../../components/Icono.astro';
import Boton from '../../components/Boton.astro';
import Cta from '../../components/Cta.astro';
import FaqSchema from '../../components/FaqSchema.astro';
import { href } from '../../lib/site';

const faq = [
  {
    "pregunta": "¿Esto es un producto que me vendéis?",
    "respuesta": "No. Es consultoría y desarrollo a medida sobre estándares abiertos, para decidir con criterio y no depender de un proveedor concreto."
  },
  {
    "pregunta": "¿Tengo que esperar a la cartera europea para empezar?",
    "respuesta": "No. Puedes diseñar procesos, firmar y verificar identidad hoy, y emitir credenciales con los mismos estándares que usará la cartera."
  },
  {
    "pregunta": "¿Una credencial verificable sustituye a la firma electrónica?",
    "respuesta": "No, se complementan. La credencial prueba un dato; la firma prueba voluntad e integridad de un documento."
  },
  {
    "pregunta": "¿Qué diferencia hay entre firma electrónica simple, avanzada y cualificada?",
    "respuesta": "El nivel de garantía sobre quién firma. La cualificada tiene el mismo efecto legal que la firma manuscrita."
  },
  {
    "pregunta": "¿Cómo evito que me cambien la cuenta bancaria de un proveedor por correo?",
    "respuesta": "Verificando la titularidad de la cuenta antes del primer pago y ante cada cambio. Se puede automatizar en tu flujo de pagos."
  },
  {
    "pregunta": "¿Cómo encaja con el RGPD?",
    "respuesta": "Bien diseñada, reduce los datos que se comparten y conservan. Se revisa caso a caso con tu responsable de protección de datos."
  }
] as const;
---

<Base
  title="Identidad digital y credenciales verificables"
  description="Identidad digital para empresas: firma electrónica, verificación de clientes y credenciales verificables. Preparación para la cartera europea (eIDAS 2)."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="eyebrow" data-reveal>Identidad digital</p>
        <h1
          class="mt-7 max-w-[20ch] font-display text-[clamp(32px,4.2vw,54px)] font-extralight leading-[1.06] tracking-[-0.035em]"
          data-reveal
        >
          Que tus clientes, alumnos y ciudadanos prueben <span class="font-semibold text-oro-oscuro">quiénes son</span> sin entregar todos sus datos.
        </h1>
        <p class="mt-8 max-w-[52ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
          Te ayudamos a entender, planificar y construir identidad digital verificable: firma, verificación de clientes y credenciales, con criterio técnico y legal.
        </p>
        <div class="mt-12 flex flex-wrap gap-4" data-reveal>
          <Boton href={href('/contacto/')}>Reservar diagnóstico</Boton>
          <Boton href="#casos" variante="linea">Ver casos de aplicación</Boton>
        </div>
      </div>
      <HeroFoto foto="despachos" alt="Profesionales revisando documentos en un despacho" class="lg:col-span-5" />
    </div>
  </section>

  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Para qué sirve</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Tres preguntas de cada día: quién firma, quién es y quién cobra
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="propuesta" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Firmar y contratar</h3>
          <p class="mt-3 text-[15px] text-pizarra">Firma electrónica con validez legal integrada en tu flujo: presupuestos, contratos y altas de cliente. Sin imprimir, sin esperar.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="medir" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Dar de alta a clientes y proveedores</h3>
          <p class="mt-3 text-[15px] text-pizarra">Alta con verificación de identidad y comprobación de documentos, para saber quién está al otro lado antes de contratar o de pagar.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="integracion" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Verificar un cambio de IBAN</h3>
          <p class="mt-3 text-[15px] text-pizarra">Comprobar la titularidad de la cuenta antes del primer pago y ante cada cambio, para que un correo falso no desvíe una transferencia.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Qué es, en tres líneas</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Identidad autosoberana, credenciales verificables y cartera europea
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Identidad autosoberana (SSI)</h3>
          <p class="mt-3 text-[15px] text-pizarra">La persona guarda sus credenciales y decide qué enseña y a quién, sin depender de una base de datos central.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Credencial verificable</h3>
          <p class="mt-3 text-[15px] text-pizarra">Documento digital firmado (título, licencia, certificado) que cualquiera puede comprobar al instante, con estándares abiertos como W3C VC y OpenID4VC.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Cartera europea de identidad digital (EUDI Wallet)</h3>
          <p class="mt-3 text-[15px] text-pizarra">La aplicación que prevé el Reglamento (UE) 2024/1183, conocido como eIDAS 2, para identificarse, firmar y compartir documentos acreditados desde el móvil.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Qué hacemos</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Conocimiento, consultoría y desarrollo
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="formacion" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Conocimiento</h3>
          <p class="mt-3 text-[15px] text-pizarra">Qué exige eIDAS 2 a tu organización si emites, aceptas o gestionas credenciales; estándares (W3C VC, OpenID4VC, identificadores descentralizados) y su madurez real; formación a dirección, IT y jurídico con ejemplos de tu sector.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="diagnostico" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Consultoría</h3>
          <p class="mt-3 text-[15px] text-pizarra">Mapa de los puntos donde tu empresa confía en una identidad (altas, pagos, firmas, accesos) y qué verificar en cada uno; diseño del modelo de confianza; hoja de ruta de preparación para la cartera europea, con riesgos y encaje con seguridad y protección de datos.</p>
        </div>
        <div class="flex flex-col bg-marfil p-8 md:p-10" data-reveal>
          <Icono nombre="integracion" class="h-7 w-7 text-oro-oscuro" />
          <h3 class="mt-4 font-display text-[21px] font-semibold">Desarrollo</h3>
          <p class="mt-3 text-[15px] text-pizarra">Integración de firma, verificación de identidad y de documentos, y emisión y verificación de credenciales, en tu CRM, ERP, web o gestión académica; prototipos funcionales para validar con usuarios reales antes de invertir más.</p>
        </div>
      </div>
    </div>
  </section>

  <section id="casos" class="hairline scroll-mt-24">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Casos de aplicación</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Dónde se nota la identidad digital
        </h2>
      </div>
      <ul class="mt-14 grid gap-4 md:grid-cols-2" role="list">
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Firma de documentos y contratos con validez legal, sin papel y sin intermediarios.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Alta de clientes en banca, salud o servicios regulados con atributos reutilizables y menos copias de DNI.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Cambio de IBAN de un proveedor: titularidad comprobada antes de pagar.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Títulos académicos emitidos como credencial y presentados a un empleador sin papel.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Acreditación de proveedores: demostrar que se está al corriente o certificado sin reenviar documentos en cada licitación o alta.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Verificación de documentos: comprobar en segundos que un certificado, poder o informe es auténtico y no se ha alterado.</span>
        </li>
        <li class="flex gap-4 rounded-[4px] border border-linea bg-panel px-6 py-5 text-[15px] text-pizarra" data-reveal>
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-oro-oscuro"></span>
          <span>Trámites con la administración compartiendo solo el dato que el trámite necesita.</span>
        </li>
      </ul>
    </div>
  </section>

  <section class="hairline bg-panel">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Cómo trabajamos</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          De saber dónde te sirve a tenerlo funcionando
        </h2>
      </div>
      <ol class="mt-16 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">01</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Diagnóstico</h3>
          <p class="mt-3 text-[15px] text-pizarra">Procesos, documentos y obligaciones; qué conviene verificar digitalmente primero.</p>
        </li>
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">02</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Diseño</h3>
          <p class="mt-3 text-[15px] text-pizarra">Modelo de confianza, estándares y arquitectura, validados con IT y jurídico.</p>
        </li>
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">03</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Prototipo</h3>
          <p class="mt-3 text-[15px] text-pizarra">Caso acotado probado con usuarios reales antes de escalar.</p>
        </li>
        <li class="border-t border-linea pt-6" data-reveal>
          <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">04</span>
          <h3 class="mt-4 font-display text-[19px] font-semibold">Integración y traspaso</h3>
          <p class="mt-3 text-[15px] text-pizarra">Conexión a tus sistemas, documentación y formación.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Para quién</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Organizaciones que necesitan saber con quién tratan
        </h2>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-linea bg-linea sm:grid-cols-2 lg:grid-cols-3">
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Empresas de sectores regulados</h3>
          <p class="mt-3 text-[15px] text-pizarra">Finanzas, salud y servicios: menos fricción y riesgo en altas, contratos y proveedores.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Universidades y centros de formación</h3>
          <p class="mt-3 text-[15px] text-pizarra">Credenciales académicas verificables, de títulos a microcredenciales.</p>
        </div>
        <div class="flex flex-col bg-panel p-8 md:p-10" data-reveal>
          <h3 class="mt-4 font-display text-[21px] font-semibold">Administración pública</h3>
          <p class="mt-3 text-[15px] text-pizarra">Preparación para aceptar o emitir identidad y credenciales en el marco de eIDAS 2.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Líneas relacionadas -->
  <section class="hairline">
    <div class="wrap py-16 md:py-20">
      <p class="eyebrow" data-reveal>Líneas relacionadas</p>
      <div class="mt-8 flex flex-wrap gap-4" data-reveal>
        <Boton href={href('/ciberseguridad/')} variante="linea">Ciberseguridad →</Boton>
        <Boton href={href('/espacios-de-datos/')} variante="linea">Espacios de datos →</Boton>
        <Boton href={href('/inteligencia-artificial/')} variante="linea">Inteligencia artificial →</Boton>
        <Boton href={href('/sectores/administracion/')} variante="linea">Sector administración →</Boton>
        <Boton href={href('/sectores/formacion/')} variante="linea">Sector formación →</Boton>
      </div>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section class="hairline">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Preguntas frecuentes</p>
        <h2 class="mt-5 max-w-[16ch] font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Lo que más nos preguntan antes de empezar
        </h2>
      </div>

      <div class="md:col-span-7" data-reveal>
        {
          faq.map((f) => (
            <details class="group border-t border-linea py-5 last:border-b">
              <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-display text-[17px] font-semibold marker:content-none">
                {f.pregunta}
                <span class="mt-1 shrink-0 font-mono text-[14px] text-oro-oscuro transition-transform duration-200 group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="mt-4 max-w-[62ch] text-[15px] text-pizarra">{f.respuesta}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <Cta
    titulo="Empieza por saber dónde te sirve la identidad digital."
    texto="Un diagnóstico breve para identificar tus casos de uso, tus obligaciones y un primer paso realista."
    boton="Reservar diagnóstico"
  />
  <FaqSchema faq={faq} />
</Base>

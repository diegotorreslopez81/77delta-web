---
import Base from '../../layouts/Base.astro';
import Boton from '../../components/Boton.astro';
import Cta from '../../components/Cta.astro';
import { href } from '../../lib/site';

const lineas = [
  {
    titulo: 'Smart cities',
    texto: 'Datos del municipio al servicio de las decisiones: movilidad, residuos, energía y atención al ciudadano.',
  },
  {
    titulo: 'Consultoría de IA',
    texto: 'Diagnóstico de procesos y hoja de ruta antes de construir nada. Qué automatizar, qué no y en qué orden.',
  },
  {
    titulo: 'Formación de equipos',
    texto: 'Formación práctica para el personal municipal en herramientas de IA, adaptada a su trabajo diario.',
  },
  {
    titulo: 'Ejecución de proyectos',
    texto: 'Desarrollo e implantación de la solución acordada, con seguimiento claro y entregables definidos.',
  },
];
---

<Base
  title="IA para ayuntamientos"
  description="Consultoría de IA, smart cities, formación de equipos y ejecución de proyectos para ayuntamientos. Proveedores acreditados por ACCIÓ en proyectos de IA."
>
  <!-- Hero -->
  <section class="wrap py-24 md:py-32">
    <p class="eyebrow" data-reveal>Administración local</p>
    <h1
      class="mt-7 max-w-[18ch] font-display text-[clamp(38px,6vw,76px)] font-extralight leading-[1.04] tracking-[-0.035em]"
      data-reveal
    >
      IA útil para <span class="font-semibold text-oro-oscuro">tu ayuntamiento</span>.
    </h1>
    <p class="mt-8 max-w-[54ch] text-[clamp(17px,1.6vw,20px)] text-pizarra" data-reveal>
      Acompañamos a los ayuntamientos desde el primer diagnóstico hasta el proyecto en marcha. Sin promesas
      grandes: empezamos por entender cómo trabaja tu equipo.
    </p>
    <div class="mt-14" data-reveal>
      <Boton href={href('/contacto/')}>Hablemos →</Boton>
    </div>
  </section>

  <!-- Acreditación -->
  <section class="hairline bg-panel">
    <div class="wrap grid gap-10 py-24 md:grid-cols-12 md:py-32">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Acreditación</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Proveedores acreditados por ACCIÓ
        </h2>
      </div>
      <div class="md:col-span-7 md:pt-12" data-reveal>
        <p class="text-[17px] text-pizarra">
          Somos proveedores acreditados por ACCIÓ en proyectos de IA. Lo decimos para que sepas con quién
          hablas, nada más.
        </p>
        <a
          href="https://www.accio.gencat.cat"
          target="_blank"
          rel="noopener"
          class="mt-6 inline-block font-mono text-[12px] text-oro-oscuro hover:text-tinta"
        >
          ACCIÓ, Generalitat de Catalunya →
        </a>
      </div>
    </div>
  </section>

  <!-- Cuatro líneas -->
  <section class="hairline">
    <div class="wrap py-24 md:py-32">
      <div class="max-w-[62ch]" data-reveal>
        <p class="eyebrow">Qué hacemos</p>
        <h2 class="mt-5 font-display text-[clamp(28px,3.6vw,44px)] font-extralight leading-[1.1] tracking-[-0.03em]">
          Cuatro líneas de trabajo
        </h2>
      </div>
      <ol class="mt-16 grid gap-x-12 gap-y-12 md:grid-cols-2" role="list">
        {
          lineas.map((l, i) => (
            <li data-reveal>
              <span class="font-mono text-[11px] tracking-[0.14em] text-oro-oscuro">{String(i + 1).padStart(2, '0')}</span>
              <p class="mt-4 font-display text-[19px] font-semibold leading-[1.3]">{l.titulo}</p>
              <p class="mt-3 text-[16px] text-pizarra">{l.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <Cta
    titulo="Cuéntanos qué necesita tu ayuntamiento."
    texto="Una conversación para entender tu caso. Sin compromiso."
    boton="Escribirnos"
  />
</Base>
